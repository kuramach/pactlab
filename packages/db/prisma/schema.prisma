model Organization {
  id                     String                 @id @default(uuid(7)) @db.Uuid
  name                   String
  slug                   String                 @unique
  /// External identity-provider organization reference (Auth0 `org_id` claim).
  /// Set exactly when the organization signs in through Auth0 (CHECK in migration).
  auth0OrganizationId    String?                @unique @map("auth0_organization_id")
  /// How members sign in. Tokens from the other method never reach this organization.
  authMethod             OrganizationAuthMethod @default(AUTH0) @map("auth_method")
  /// Only ACTIVE organizations can be entered; sign-ups start PENDING_APPROVAL.
  status                 OrganizationStatus     @default(ACTIVE)
  /// The organization asked for company SSO (Auth0) at sign-up; set up by an operator.
  ssoRequested           Boolean                @default(false) @map("sso_requested")
  createdVia             OrganizationOrigin     @default(OPERATOR) @map("created_via")
  region                 String                 @default("us-east-1")
  /// Buyer persona new pacts default to (T-105): QUALITY_COMPOUNDER | VALUE_INVESTOR | GRAVE_DANCER; null is Value Investor.
  defaultPersona         String?                @map("default_persona")
  /// The longest trusted sign-in members may keep, in hours (T-112): 0 (off), 24, 168 or 720.
  trustedSessionMaxHours Int                    @default(168) @map("trusted_session_max_hours")
  /// The company website, where the brand kit is drafted from (T-123).
  websiteUrl             String?                @map("website_url")
  /// Signing waits for investment committee approval on this organization's pacts (T-118); a pact may override.
  icApprovalRequired     Boolean                @default(false) @map("ic_approval_required")
  /// Conditions an IC sets are cleared by the IC, not only addressed by the deal team.
  icClearsConditions     Boolean                @default(false) @map("ic_clears_conditions")
  /// Which provider new envelopes go out with (T-136): PACTLAB (Pactlab signing) or DOCUSIGN (its own connected DocuSign).
  signingProvider        String                 @default("PACTLAB") @map("signing_provider")
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships              OrganizationMembership[]
  deals                    Deal[]
  dealMemberships          DealMembership[]
  auditEvents              AuditEvent[]
  outboxEvents             OutboxEvent[]
  jobRuns                  JobRun[]
  storedFiles              StoredFile[]
  connections              Connection[]
  syncRuns                 SyncRun[]
  evidenceItems            EvidenceItem[]
  evidenceEdges            EvidenceEdge[]
  syncRunEvidence          SyncRunEvidence[]
  evidenceVoids            EvidenceVoid[]
  importFormats            ImportFormat[]
  citations                Citation[]
  findings                 Finding[]
  findingLinks             FindingEvidenceLink[]
  findingReviews           FindingReview[]
  valuationScenarios       ValuationScenario[]
  valuationAssumptionSets  ValuationAssumptionSet[]
  valuationRuns            ValuationRun[]
  valuationSubmissions     ValuationSubmission[]
  valuationDecisions       ValuationSubmissionDecision[]
  documents                Document[]
  documentSources          DocumentSource[]
  documentRequests         DocumentRequest[]
  agentProposals           AgentProposal[]
  documentPages            DocumentPage[]
  aiRuns                   AiRun[]
  documentFindings         DocumentFinding[]
  documentFindingReviews   DocumentFindingReview[]
  authSessions             AuthSession[]
  dealParties              DealParty[]
  sourceUploads            SourceUpload[]
  askingPrices             AskingPrice[]
  comparables              Comparable[]
  multipleJudgements       MultipleJudgement[]
  negotiationAnchors       NegotiationAnchor[]
  balanceSheetItems        BalanceSheetItem[]
  balanceSheetItemVersions BalanceSheetItemVersion[]
  contributorIdentities    ContributorIdentity[]
  peopleAccess             PeopleAccess[]
  flags                    OrganizationFlags?
  bugReports               BugReport[]

  oauthGrants OAuthGrant[]
  aiModels    OrganizationAiModel[]
  aiRoutes    OrganizationAiRoute[]

  pactQuotes              PactQuote[]
  pricingPromoRedemptions PricingPromoRedemption[]

  @@map("organizations")
}

model User {
  id                      String    @id @default(uuid(7)) @db.Uuid
  /// Verified `sub` claim: Auth0 subject, or `pactlab|<user id>` for email-code sign-in.
  auth0Subject            String    @unique @map("auth0_subject")
  /// Lowercased sign-in address for email-code organizations; never sent to models.
  email                   String?   @unique
  displayName             String    @map("display_name")
  /// Platform operator (the Pactlab team): may use the admin console (T-072). Set with `pnpm ops:operator`.
  platformOperator        Boolean   @default(false) @map("platform_operator")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// "Not now" on the one-time passkey offer after an email sign-in (T-108).
  passkeyOfferDismissedAt DateTime? @map("passkey_offer_dismissed_at") @db.Timestamptz(3)

  organizationMemberships OrganizationMembership[]
  dealMemberships         DealMembership[]
  loginChallenges         LoginChallenge[]
  authSessions            AuthSession[]
  passkeys                UserPasskey[]
  passkeyChallenges       PasskeyChallenge[]
  oauthGrants             OAuthGrant[]

  @@map("users")
}

model OrganizationMembership {
  id                  String           @id @default(uuid(7)) @db.Uuid
  organizationId      String           @map("organization_id") @db.Uuid
  userId              String           @map("user_id") @db.Uuid
  role                OrganizationRole
  status              MembershipStatus @default(ACTIVE)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  /// On the organization's investment committee (T-118): seated on a pact when its IC pack is submitted.
  investmentCommittee Boolean          @default(false) @map("investment_committee")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

model Deal {
  id                   String          @id @default(uuid(7)) @db.Uuid
  organizationId       String          @map("organization_id") @db.Uuid
  name                 String
  targetName           String          @map("target_name")
  transactionType      TransactionType @map("transaction_type")
  stage                String          @default("SCREENING")
  /// Overrides the organization's IC requirement for this pact; null follows it (T-118).
  icApprovalRequired   Boolean?        @map("ic_approval_required")
  /// Signing the definitive terms waits for a countersigned letter of intent (T-119).
  loiRequired          Boolean         @default(false) @map("loi_required")
  status               String          @default("ACTIVE")
  baseCurrency         String          @default("USD") @map("base_currency") @db.Char(3)
  createdBy            String          @map("created_by") @db.Uuid
  /// BUYER: the buyer opened the pact (diligence). SELLER: the seller runs a bid process (T-097, ADR 0015).
  initiatedBy          String          @default("BUYER") @map("initiated_by")
  /// The sale this buyer-led pact came from (another organization's seller-led pact, T-097). Reference only.
  linkedOrganizationId String?         @map("linked_organization_id") @db.Uuid
  linkedDealId         String?         @map("linked_deal_id") @db.Uuid
  /// When the pact's live period ends (12 months; 6 for a sale); read-only after it (T-087).
  liveUntil            DateTime?       @map("live_until") @db.Timestamptz(3)
  /// The two-sided close (T-107): when, and the signatory of each side.
  closedAt             DateTime?       @map("closed_at") @db.Timestamptz(3)
  closedByBuyer        String?         @map("closed_by_buyer") @db.Uuid
  closedBySeller       String?         @map("closed_by_seller") @db.Uuid
  /// The buyer persona this pact prices under (T-105); null follows the organization default. Buyer-confidential.
  persona              String?
  /// The property's address for market rents (T-158) when no listing names one; asked once, audited.
  propertyAddress      String?         @map("property_address")
  /// The year the business started (or the property was built or acquired, or the earliest year the seller can provide); never ask for years before it (T-185). Audited.
  historyStartYear     Int?            @map("history_start_year")
  /// Set when the deal lead deletes the deal (status DELETED); one-way.
  deletedAt            DateTime?       @map("deleted_at") @db.Timestamptz(3)
  deletedBy            String?         @map("deleted_by") @db.Uuid
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization             Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships              DealMembership[]
  jobRuns                  JobRun[]
  storedFiles              StoredFile[]
  auditEvents              AuditEvent[]
  outboxEvents             OutboxEvent[]
  connections              Connection[]
  syncRuns                 SyncRun[]
  evidenceItems            EvidenceItem[]
  evidenceEdges            EvidenceEdge[]
  syncRunEvidence          SyncRunEvidence[]
  evidenceVoids            EvidenceVoid[]
  importFormats            ImportFormat[]
  citations                Citation[]
  findings                 Finding[]
  findingLinks             FindingEvidenceLink[]
  findingReviews           FindingReview[]
  valuationScenarios       ValuationScenario[]
  valuationAssumptionSets  ValuationAssumptionSet[]
  valuationRuns            ValuationRun[]
  valuationSubmissions     ValuationSubmission[]
  valuationDecisions       ValuationSubmissionDecision[]
  documents                Document[]
  documentSources          DocumentSource[]
  rinseSets                RinseSet[]
  documentRequests         DocumentRequest[]
  agentProposals           AgentProposal[]
  documentPages            DocumentPage[]
  aiRuns                   AiRun[]
  documentFindings         DocumentFinding[]
  documentFindingReviews   DocumentFindingReview[]
  parties                  DealParty[]
  sourceUploads            SourceUpload[]
  askingPrices             AskingPrice[]
  ownDealComparables       Comparable[]
  multipleJudgements       MultipleJudgement[]
  negotiationAnchors       NegotiationAnchor[]
  balanceSheetItems        BalanceSheetItem[]
  balanceSheetItemVersions BalanceSheetItemVersion[]
  contributorIdentities    ContributorIdentity[]
  peopleAccess             PeopleAccess[]
  screeningReview          ScreeningReview?
  claims                   DealClaim[]
  postCloseItems           PostCloseItem[]
  foresightTrendSets       ForesightTrendSet[]
  foresightForecasts       ForesightForecast[]
  foresightBaselines       ForesightBaseline[]
  invitations              DealInvitation[]
  foresightQuestions       ForesightQuestion[]
  ventureRaiseSettings     VentureRaiseSettings[]
  ventureOffers            VentureOffer[]

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@map("deals")
}

/// The buying and selling entities of a Pact. One row per role per deal;
/// the deal's transaction type was derived from their ownership at creation.
model DealParty {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  dealId         String           @map("deal_id") @db.Uuid
  role           PartyRole
  name           String
  ownership      CompanyOwnership
  ticker         String?
  exchange       String?
  website        String?
  companyType    CompanyType?     @map("company_type")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, dealId, role])
  @@map("deal_parties")
}

model DealMembership {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  dealId         String           @map("deal_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           DealRole
  /// For a BIDDER: the bid (firm) they act for.
  bidId          String?          @map("bid_id") @db.Uuid
  /// For an INVESTOR: their seat in the vehicle (T-141).
  investorId     String?          @map("investor_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, dealId, userId])
  @@index([userId])
  @@map("deal_memberships")
}

/// Append-only, hash-chained audit trail. UPDATE and DELETE are revoked.
model AuditEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String?  @map("deal_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  targetType     String   @map("target_type")
  targetId       String?  @map("target_id")
  outcome        String
  requestId      String?  @map("request_id")
  ipAddress      String?  @map("ip_address")
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  /// Chain fields are assigned by the audit_events_chain trigger; client values are overwritten.
  chainSeq       BigInt   @default(0) @map("chain_seq")
  prevHash       String?  @map("prev_hash")
  hash           String   @default("")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal?        @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, occurredAt])
  @@index([organizationId, dealId, occurredAt])
  @@map("audit_events")
}

/// Transactional outbox: domain events written in the same transaction as the change.
model OutboxEvent {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  dealId         String?   @map("deal_id") @db.Uuid
  aggregateType  String    @map("aggregate_type")
  aggregateId    String    @map("aggregate_id")
  eventType      String    @map("event_type")
  payload        Json
  idempotencyKey String    @map("idempotency_key")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal?        @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

/// Durable record of async jobs; uniqueness on idempotency key makes replays safe.
model JobRun {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  dealId         String    @map("deal_id") @db.Uuid
  type           String
  schemaVersion  Int       @map("schema_version")
  idempotencyKey String    @map("idempotency_key")
  status         JobStatus @default(QUEUED)
  attempt        Int       @default(0)
  requestedBy    String    @map("requested_by") @db.Uuid
  correlationId  String    @map("correlation_id")
  errorClass     String?   @map("error_class")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, dealId, idempotencyKey])
  @@map("job_runs")
}

/// Metadata for tenant-scoped objects. Bytes live in the object store under
/// `<organization_id>/<deal_id>/...`; a check constraint enforces the prefix.
model StoredFile {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  objectKey      String   @map("object_key")
  fileName       String   @map("file_name")
  contentType    String   @map("content_type")
  sizeBytes      BigInt   @map("size_bytes")
  sha256         String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)

  @@unique([objectKey])
  @@map("stored_files")
}

/// A source connected to a deal. Mode is persisted and every change audited;
/// downstream logic never branches on it. Secrets live in the managed store —
/// only a revocable reference is kept here.
model Connection {
  id                 String             @id @default(uuid(7)) @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  dealId             String             @map("deal_id") @db.Uuid
  provider           String
  displayName        String             @map("display_name")
  mode               ConnectionMode
  credentialRef      String?            @map("credential_ref")
  /// Provider-specific, non-secret settings (e.g. which datasets to read).
  config             Json
  status             ConnectionStatus   @default(ACTIVE)
  /// Default visibility of evidence this connection produces.
  evidenceVisibility EvidenceVisibility @default(BUYER_ONLY) @map("evidence_visibility")
  createdBy          String             @map("created_by") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal          Deal           @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  syncRuns      SyncRun[]
  evidenceItems EvidenceItem[]
  sourceUploads SourceUpload[]

  @@unique([organizationId, dealId, id])
  @@index([organizationId, dealId, createdAt])
  @@map("connections")
}

/// One idempotent pull from a connection. Replaying the same idempotency key
/// returns the existing run; re-pulling unchanged records creates nothing.
model SyncRun {
  id               String        @id @default(uuid(7)) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  dealId           String        @map("deal_id") @db.Uuid
  connectionId     String        @map("connection_id") @db.Uuid
  connectorVersion String        @map("connector_version")
  idempotencyKey   String        @map("idempotency_key")
  status           SyncRunStatus @default(QUEUED)
  cursor           String?
  recordsSeen      Int           @default(0) @map("records_seen")
  recordsCreated   Int           @default(0) @map("records_created")
  recordsUnchanged Int           @default(0) @map("records_unchanged")
  issuesCount      Int           @default(0) @map("issues_count")
  errorClass       String?       @map("error_class")
  requestedBy      String        @map("requested_by") @db.Uuid
  correlationId    String        @map("correlation_id")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt        DateTime?     @map("started_at") @db.Timestamptz(3)
  completedAt      DateTime?     @map("completed_at") @db.Timestamptz(3)

  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal               Deal              @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  connection         Connection        @relation(fields: [organizationId, dealId, connectionId], references: [organizationId, dealId, id], onDelete: Restrict)
  firstEvidenceItems EvidenceItem[]    @relation("FirstSyncRun")
  lastEvidenceItems  EvidenceItem[]    @relation("LastSyncRun")
  evidenceLinks      SyncRunEvidence[]

  @@unique([organizationId, dealId, id])
  @@unique([organizationId, dealId, idempotencyKey])
  @@index([organizationId, dealId, connectionId, createdAt])
  @@map("sync_runs")
}

/// Normalized evidence. Immutable except for last-seen and sharing columns;
/// changed source content creates a new item linked by a SUPERSEDES edge.
model EvidenceItem {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  dealId         String             @map("deal_id") @db.Uuid
  connectionId   String             @map("connection_id") @db.Uuid
  firstSyncRunId String             @map("first_sync_run_id") @db.Uuid
  lastSyncRunId  String             @map("last_sync_run_id") @db.Uuid
  evidenceType   String             @map("evidence_type")
  sourceSystem   String             @map("source_system")
  sourceRecordId String             @map("source_record_id")
  observedAt     DateTime?          @map("observed_at") @db.Timestamptz(3)
  canonical      Json
  /// sha256 of the canonical JSON.
  contentHash    String             @map("content_hash") @db.Char(64)
  sensitivity    String             @default("STANDARD")
  visibility     EvidenceVisibility @default(BUYER_ONLY)
  sharedBy       String?            @map("shared_by") @db.Uuid
  sharedAt       DateTime?          @map("shared_at") @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal                  @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  connection   Connection            @relation(fields: [organizationId, dealId, connectionId], references: [organizationId, dealId, id], onDelete: Restrict)
  firstSyncRun SyncRun               @relation("FirstSyncRun", fields: [organizationId, dealId, firstSyncRunId], references: [organizationId, dealId, id], onDelete: Restrict)
  lastSyncRun  SyncRun               @relation("LastSyncRun", fields: [organizationId, dealId, lastSyncRunId], references: [organizationId, dealId, id], onDelete: Restrict)
  citations    Citation[]
  edgesFrom    EvidenceEdge[]        @relation("EdgeFrom")
  edgesTo      EvidenceEdge[]        @relation("EdgeTo")
  findingLinks FindingEvidenceLink[]
  syncRunLinks SyncRunEvidence[]
  voids        EvidenceVoid[]

  @@unique([organizationId, dealId, id])
  @@unique([organizationId, dealId, connectionId, sourceRecordId, contentHash])
  @@index([organizationId, dealId, evidenceType])
  @@index([organizationId, dealId, connectionId, sourceRecordId])
  @@map("evidence_items")
}

/// Which evidence items a sync run read (T-154): a record seen again by a later
/// run is listed under both. A withdrawn import voids only what no active
/// import still holds. Insert-only.
model SyncRunEvidence {
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  syncRunId      String   @map("sync_run_id") @db.Uuid
  evidenceItemId String   @map("evidence_item_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  syncRun      SyncRun      @relation(fields: [organizationId, dealId, syncRunId], references: [organizationId, dealId, id], onDelete: Restrict)
  evidenceItem EvidenceItem @relation(fields: [organizationId, dealId, evidenceItemId], references: [organizationId, dealId, id], onDelete: Restrict)

  @@id([syncRunId, evidenceItemId])
  @@index([organizationId, dealId, evidenceItemId])
  @@map("sync_run_evidence")
}

/// Evidence voided by a withdrawn import (T-154, ADR 0039): kept in storage,
/// excluded from every read path while `restoredAt` is null. A re-import that
/// reads the same record again restores it, recorded here; the row is never deleted.
model EvidenceVoid {
  id                 String    @id @default(uuid(7)) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  dealId             String    @map("deal_id") @db.Uuid
  evidenceItemId     String    @map("evidence_item_id") @db.Uuid
  sourceUploadId     String    @map("source_upload_id") @db.Uuid
  voidedAt           DateTime  @default(now()) @map("voided_at") @db.Timestamptz(3)
  voidedBy           String    @map("voided_by") @db.Uuid
  restoredAt         DateTime? @map("restored_at") @db.Timestamptz(3)
  restoredByUploadId String?   @map("restored_by_upload_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  evidenceItem EvidenceItem @relation(fields: [organizationId, dealId, evidenceItemId], references: [organizationId, dealId, id], onDelete: Restrict)
  sourceUpload SourceUpload @relation("UploadVoids", fields: [organizationId, dealId, sourceUploadId], references: [organizationId, dealId, id], onDelete: Restrict)

  @@unique([organizationId, dealId, evidenceItemId, sourceUploadId])
  @@index([organizationId, dealId, sourceUploadId])
  @@map("evidence_voids")
}

/// Relational lineage between evidence items; traversed with recursive CTEs.
model EvidenceEdge {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  dealId         String           @map("deal_id") @db.Uuid
  fromEvidenceId String           @map("from_evidence_id") @db.Uuid
  toEvidenceId   String           @map("to_evidence_id") @db.Uuid
  edgeType       EvidenceEdgeType @map("edge_type")
  reason         String
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  from         EvidenceItem @relation("EdgeFrom", fields: [organizationId, dealId, fromEvidenceId], references: [organizationId, dealId, id], onDelete: Restrict)
  to           EvidenceItem @relation("EdgeTo", fields: [organizationId, dealId, toEvidenceId], references: [organizationId, dealId, id], onDelete: Restrict)

  @@unique([organizationId, dealId, fromEvidenceId, toEvidenceId, edgeType])
  @@index([organizationId, dealId, toEvidenceId])
  @@map("evidence_edges")
}

/// Exact pointer into a source (CSV row today; document pages arrive later)
/// plus the hash of the quoted source text, verified at display time.
model Citation {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  evidenceItemId String   @map("evidence_item_id") @db.Uuid
  locator        Json
  quoteHash      String   @map("quote_hash") @db.Char(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  evidenceItem EvidenceItem @relation(fields: [organizationId, dealId, evidenceItemId], references: [organizationId, dealId, id], onDelete: Restrict)

  @@unique([organizationId, dealId, evidenceItemId, quoteHash])
  @@map("citations")
}

/// Buyer-side finding. Status changes only through human reviews; every
/// change bumps `version` (optimistic concurrency). Priced-risk amounts are
/// numeric with explicit currency, all-or-none (CHECK in the migration).
model Finding {
  id                 String            @id @default(uuid(7)) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  dealId             String            @map("deal_id") @db.Uuid
  domain             FindingDomain
  title              String
  description        String
  severity           FindingSeverity
  confidence         FindingConfidence
  status             FindingStatus     @default(DRAFT)
  origin             FindingOrigin
  /// Stable signal identity; replaying a scan yields the same fingerprint.
  fingerprint        String
  pricedRiskType     PricedRiskType?   @map("priced_risk_type")
  pricedRiskCurrency String?           @map("priced_risk_currency") @db.Char(3)
  pricedRiskLow      Decimal?          @map("priced_risk_low") @db.Decimal(19, 4)
  pricedRiskHigh     Decimal?          @map("priced_risk_high") @db.Decimal(19, 4)
  pricedRiskBasis    String?           @map("priced_risk_basis")
  /// Valuation direction: -1 drag, 0 neutral, 1 cushion; null until decided.
  direction          Int?              @db.SmallInt
  /// What a cushion confirms ("value confirmed, not price paid").
  valueDriver        String?           @map("value_driver")
  valueBasis         String?           @map("value_basis")
  valueLow           Decimal?          @map("value_low") @db.Decimal(19, 4)
  valueHigh          Decimal?          @map("value_high") @db.Decimal(19, 4)
  valueCurrency      String?           @map("value_currency") @db.Char(3)
  /// Why a finding is neutral, or why a reviewer changed its proposed direction.
  directionRationale String?           @map("direction_rationale")
  /// The FindingActor that drafted it (HUMAN, AI or SYSTEM).
  createdBy          Json              @map("created_by")
  /// Finding version whose evidence link set is current.
  evidenceVersion    Int               @map("evidence_version")
  version            Int
  createdAt          DateTime          @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @map("updated_at") @db.Timestamptz(3)

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal          Deal                  @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  evidenceLinks FindingEvidenceLink[]
  reviews       FindingReview[]

  @@unique([organizationId, dealId, id])
  @@unique([organizationId, dealId, fingerprint])
  @@index([organizationId, dealId, status, domain])
  @@map("findings")
}

/// Insert-only provenance: evidence item, exact commit and versioned tool.
/// An edit appends a new set stamped with the finding version; earlier sets
/// remain as history.
model FindingEvidenceLink {
  id               String   @id @default(uuid(7)) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  dealId           String   @map("deal_id") @db.Uuid
  findingId        String   @map("finding_id") @db.Uuid
  findingVersion   Int      @map("finding_version")
  ordinal          Int
  /// Null when the link cites a document page instead (`documentCitation`).
  evidenceItemId   String?  @map("evidence_item_id") @db.Uuid
  /// ResolvedCitation of a document page quote: documentId, pageNumber, quote, quoteHash, charStart, charEnd.
  documentCitation Json?    @map("document_citation")
  /// Null when the cited evidence is not code (pack evidence, ADR 0010).
  commitSha        String?  @map("commit_sha")
  toolName         String   @map("tool_name")
  toolVersion      String   @map("tool_version")
  rulesetVersion   String?  @map("ruleset_version")
  /// Repository-relative path; never file contents.
  path             String?
  lineStart        Int?     @map("line_start")
  lineEnd          Int?     @map("line_end")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal          @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  finding      Finding       @relation(fields: [organizationId, dealId, findingId], references: [organizationId, dealId, id], onDelete: Restrict)
  evidenceItem EvidenceItem? @relation(fields: [organizationId, dealId, evidenceItemId], references: [organizationId, dealId, id], onDelete: Restrict)

  @@unique([organizationId, dealId, findingId, findingVersion, ordinal])
  @@index([organizationId, dealId, evidenceItemId])
  @@map("finding_evidence_links")
}

/// Append-only human decision on a finding.
model FindingReview {
  id                 String         @id @default(uuid(7)) @db.Uuid
  organizationId     String         @map("organization_id") @db.Uuid
  dealId             String         @map("deal_id") @db.Uuid
  findingId          String         @map("finding_id") @db.Uuid
  decision           ReviewDecision
  fromStatus         FindingStatus  @map("from_status")
  toStatus           FindingStatus  @map("to_status")
  reviewerUserId     String         @map("reviewer_user_id") @db.Uuid
  reviewerRole       DealRole       @map("reviewer_role")
  rationale          String
  /// Direction decided on acceptance; null for other decisions.
  direction          Int?           @db.SmallInt
  directionRationale String?        @map("direction_rationale")
  decidedAt          DateTime       @map("decided_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  finding      Finding      @relation(fields: [organizationId, dealId, findingId], references: [organizationId, dealId, id], onDelete: Restrict)

  @@index([organizationId, dealId, findingId, decidedAt])
  @@map("finding_reviews")
}

/// Valuation scenario. DRAFT is editable; submission freezes the latest run.
/// Every change bumps `version` (optimistic concurrency).
model ValuationScenario {
  id                String          @id @default(uuid(7)) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  dealId            String          @map("deal_id") @db.Uuid
  name              String
  currency          String          @db.Char(3)
  transactionType   TransactionType @map("transaction_type")
  status            ScenarioStatus  @default(DRAFT)
  assumptionVersion Int             @map("assumption_version")
  /// DOWNSIDE | BASE | UPSIDE: the case a persona weights this scenario as (T-105); null is untagged.
  scenarioCase      String?         @map("scenario_case")
  createdBy         String          @map("created_by") @db.Uuid
  createdAt         DateTime        @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @map("updated_at") @db.Timestamptz(3)
  version           Int

  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal           Deal                     @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  assumptionSets ValuationAssumptionSet[]
  runs           ValuationRun[]
  submissions    ValuationSubmission[]

  @@unique([organizationId, dealId, id])
  @@index([organizationId, dealId, createdAt])
  @@map("valuation_scenarios")
}

/// Insert-only, versioned assumption set. Values are decimal strings in JSON.
model ValuationAssumptionSet {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  scenarioId     String   @map("scenario_id") @db.Uuid
  version        Int
  values         Json
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal              @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  scenario     ValuationScenario @relation(fields: [organizationId, dealId, scenarioId], references: [organizationId, dealId, id], onDelete: Restrict)

  @@unique([organizationId, dealId, scenarioId, version])
  @@map("valuation_assumption_sets")
}

/// Insert-only engine run: the full resolved inputs and the result produced.
model ValuationRun {
  id                String   @id @default(uuid(7)) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  dealId            String   @map("deal_id") @db.Uuid
  scenarioId        String   @map("scenario_id") @db.Uuid
  assumptionVersion Int      @map("assumption_version")
  inputs            Json
  result            Json
  /// Set on persona-priced runs (T-105): the persona, its registry version and how each priced risk was routed.
  persona           String?
  personaVersion    String?  @map("persona_version")
  personaRouting    Json?    @map("persona_routing")
  ranBy             String   @map("ran_by") @db.Uuid
  ranAt             DateTime @map("ran_at") @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal                  @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  scenario     ValuationScenario     @relation(fields: [organizationId, dealId, scenarioId], references: [organizationId, dealId, id], onDelete: Restrict)
  submissions  ValuationSubmission[]

  @@unique([organizationId, dealId, id])
  @@index([organizationId, dealId, scenarioId, ranAt])
  @@map("valuation_runs")
}

/// Frozen submission. `canonical` is stored and served byte-for-byte; a
/// CHECK ties it to its SHA-256 digest.
model ValuationSubmission {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  scenarioId     String   @map("scenario_id") @db.Uuid
  runId          String   @map("run_id") @db.Uuid
  canonical      String
  digest         String   @db.Char(64)
  submittedBy    String   @map("submitted_by") @db.Uuid
  submittedAt    DateTime @map("submitted_at") @db.Timestamptz(3)

  organization Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal                          @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  scenario     ValuationScenario             @relation(fields: [organizationId, dealId, scenarioId], references: [organizationId, dealId, id], onDelete: Restrict)
  run          ValuationRun                  @relation(fields: [organizationId, dealId, runId], references: [organizationId, dealId, id], onDelete: Restrict)
  decisions    ValuationSubmissionDecision[]

  @@unique([organizationId, dealId, id])
  @@index([organizationId, dealId, scenarioId, submittedAt])
  @@map("valuation_submissions")
}

/// Append-only human decision on a submission.
model ValuationSubmissionDecision {
  id             String                 @id @default(uuid(7)) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  dealId         String                 @map("deal_id") @db.Uuid
  submissionId   String                 @map("submission_id") @db.Uuid
  decision       SubmissionDecisionKind
  rationale      String
  decidedBy      String                 @map("decided_by") @db.Uuid
  decidedRole    DealRole               @map("decided_role")
  decidedAt      DateTime               @map("decided_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal                @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  submission   ValuationSubmission @relation(fields: [organizationId, dealId, submissionId], references: [organizationId, dealId, id], onDelete: Restrict)

  @@index([organizationId, dealId, submissionId, decidedAt])
  @@map("valuation_submission_decisions")
}

/// Uploaded document metadata. Bytes live in the object store under the
/// tenant/deal prefix (CHECK in the migration). Target uploads are SHARED.
model Document {
  id                 String             @id @default(uuid(7)) @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  dealId             String             @map("deal_id") @db.Uuid
  fileName           String             @map("file_name")
  contentType        String             @map("content_type")
  sizeBytes          Int                @map("size_bytes")
  sha256             String             @db.Char(64)
  objectKey          String             @map("object_key")
  pageCount          Int                @map("page_count")
  /// T-121: reading pages from their images. NONE, PENDING, READING, DONE, PARTIAL, FAILED or SKIPPED.
  visionStatus       String             @default("NONE") @map("vision_status")
  visionPagesTotal   Int                @default(0) @map("vision_pages_total")
  visionPagesDone    Int                @default(0) @map("vision_pages_done")
  visionStartedAt    DateTime?          @map("vision_started_at") @db.Timestamptz(3)
  /// Pages that could not be read, with why (page numbers and reasons only).
  visionFailures     Json               @default("[]") @map("vision_failures")
  dataClass          DataClassification @map("data_class")
  /// Per-document AI exclusion; always true for prohibited data classes.
  aiExcluded         Boolean            @map("ai_excluded")
  retentionClass     RetentionClass     @map("retention_class")
  retainUntil        DateTime?          @map("retain_until") @db.Timestamptz(3)
  visibility         EvidenceVisibility
  malwareScanner     String             @map("malware_scanner")
  status             DocumentStatus     @default(AVAILABLE)
  uploadedBy         String             @map("uploaded_by") @db.Uuid
  createdAt          DateTime           @map("created_at") @db.Timestamptz(3)
  purgedAt           DateTime?          @map("purged_at") @db.Timestamptz(3)
  /// Intake (T-098, ADR 0016): the file's category — a document category or an import target.
  category           String?
  /// AI (clear enough to file alone) or PERSON (answered or corrected).
  categorySource     String?            @map("category_source")
  categoryConfidence Decimal?           @map("category_confidence") @db.Decimal(4, 3)
  categoryReason     String?            @map("category_reason")
  /// UNCLASSIFIED | FILED | NEEDS_YOU | NOT_READ
  intakeState        String             @default("UNCLASSIFIED") @map("intake_state")
  intakeQuestion     String?            @map("intake_question")
  entityName         String?            @map("entity_name")
  /// For contracts: the other party, only when named in the file.
  counterpartyName   String?            @map("counterparty_name")
  /// Folder inside the zip or data room the file came from.
  sourcePath         String?            @map("source_path")
  classifiedRunId    String?            @map("classified_run_id") @db.Uuid
  categorizedBy      String?            @map("categorized_by") @db.Uuid
  categorizedAt      DateTime?          @map("categorized_at") @db.Timestamptz(3)
  /// The connected data room or drive it was read from (T-098), if any.
  sourceId           String?            @map("source_id") @db.Uuid
  sourceExternalId   String?            @map("source_external_id")
  sourceVersion      String?            @map("source_version")
  /// CURRENT | REPLACED (a newer version was read) | REMOVED (gone at the source)
  sourceState        String?            @map("source_state")
  /// The category before a person re-filed it; results built under it are listed to recheck.
  recategorizedFrom  String?            @map("recategorized_from")
  recategorizedAt    DateTime?          @map("recategorized_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal              @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  source       DocumentSource?   @relation(fields: [organizationId, dealId, sourceId], references: [organizationId, dealId, id], onDelete: Restrict, map: "documents_source_fkey")
  pages        DocumentPage[]
  findings     DocumentFinding[]
  provenance   DocumentProvenance[]

  @@unique([organizationId, dealId, id])
  @@unique([objectKey])
  @@index([organizationId, dealId, sha256])
  @@index([organizationId, dealId, intakeState], map: "documents_intake_state_idx")
  @@index([organizationId, dealId, sourceId, sourceExternalId], map: "documents_source_idx")
  @@map("documents")
}

/// A data room or drive folder documents are read from (T-098, ADR 0016). Read-only. Buyer side.
model DocumentSource {
  id                       String             @id @db.Uuid
  organizationId           String             @map("organization_id") @db.Uuid
  dealId                   String             @map("deal_id") @db.Uuid
  /// google-drive | onedrive | vdr
  provider                 String
  /// FIXTURE | LIVE
  mode                     String
  displayName              String             @map("display_name")
  config                   Json
  credentialRef            String?            @map("credential_ref")
  /// The organization's Google Drive or OneDrive OAuth connection this source reads with.
  organizationConnectionId String?            @map("organization_connection_id") @db.Uuid
  /// TOKEN (a pasted access token) | OAUTH (the person's own sign-in, refresh tokens under credential_ref).
  credentialKind           String?            @map("credential_kind")
  /// Who the source is signed in as (an email or sign-in name); never a token.
  accountName              String?            @map("account_name")
  /// SHARED for a seller's folder; BUYER_ONLY for the deal team's.
  visibility               EvidenceVisibility @default(BUYER_ONLY)
  /// ACTIVE | DISABLED
  status                   String             @default("ACTIVE")
  lastSyncedAt             DateTime?          @map("last_synced_at") @db.Timestamptz(3)
  lastSyncSummary          Json?              @map("last_sync_summary")
  createdBy                String             @map("created_by") @db.Uuid
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict, map: "document_sources_deal_fkey")
  documents    Document[]
  rinseSets    RinseSet[]

  @@unique([organizationId, dealId, id], map: "document_sources_org_deal_id_key")
  @@index([organizationId, dealId, createdAt], map: "document_sources_org_deal_created_idx")
  @@map("document_sources")
}

/// A set finished in Pactlab Rinse as it reached the pact (T-178d): preparer, gap notes, source discrepancies. Append-only.
model RinseSet {
  id                  String             @id @db.Uuid
  organizationId      String             @map("organization_id") @db.Uuid
  dealId              String             @map("deal_id") @db.Uuid
  manifestSetId       String             @map("manifest_set_id") @db.Uuid
  manifestSha256      String             @map("manifest_sha256") @db.Char(64)
  name                String
  pack                String
  /// The preparer's verified identity: { userId, name, organization }.
  preparedBy          Json               @map("prepared_by")
  readyAt             DateTime           @map("ready_at") @db.Timestamptz(3)
  generatorVersion    String             @map("generator_version")
  /// SYNC (a connected folder) | ARCHIVE (a one-time zip import)
  origin              String
  documentSourceId    String?            @map("document_source_id") @db.Uuid
  visibility          EvidenceVisibility
  documents           Int
  /// The manifest's gaps: input, label, need, state and the seller's note.
  gaps                Json
  /// Originals that do not foot: { manifestDocumentId, documentId, title, label, page, stated, computed }.
  sourceDiscrepancies Json               @map("source_discrepancies")
  createdBy           String             @map("created_by") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  deal       Deal                 @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict, map: "rinse_sets_deal_fkey")
  source     DocumentSource?      @relation(fields: [organizationId, dealId, documentSourceId], references: [organizationId, dealId, id], onDelete: Restrict, map: "rinse_sets_source_fkey")
  provenance DocumentProvenance[]

  @@unique([organizationId, dealId, id], map: "rinse_sets_org_deal_id_key")
  @@unique([organizationId, dealId, manifestSha256, visibility], map: "rinse_sets_manifest_key")
  @@map("rinse_sets")
}

/// Where a document read from a rinsed set came from (T-178d): its canonical copy, the seller's original and the manifest entry. Append-only.
model DocumentProvenance {
  id                 String   @id @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  dealId             String   @map("deal_id") @db.Uuid
  documentId         String   @map("document_id") @db.Uuid
  rinseSetId         String   @map("rinse_set_id") @db.Uuid
  manifestDocumentId String   @map("manifest_document_id") @db.Uuid
  /// CONVERTED (a canonical copy of an original) | AS_IS (a spreadsheet carried as it is)
  role               String
  canonicalPath      String   @map("canonical_path")
  canonicalSha256    String   @map("canonical_sha256") @db.Char(64)
  originalPath       String?  @map("original_path")
  originalSha256     String?  @map("original_sha256") @db.Char(64)
  originalSizeBytes  BigInt?  @map("original_size_bytes")
  originalMediaType  String?  @map("original_media_type")
  /// The manifest entry: route, classification, checks, conversion log and audit.
  entry              Json
  createdBy          String   @map("created_by") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  document Document @relation(fields: [organizationId, dealId, documentId], references: [organizationId, dealId, id], onDelete: Restrict, map: "document_provenance_document_fkey")
  set      RinseSet @relation(fields: [organizationId, dealId, rinseSetId], references: [organizationId, dealId, id], onDelete: Restrict, map: "document_provenance_set_fkey")

  @@unique([organizationId, dealId, documentId, rinseSetId], map: "document_provenance_document_set_key")
  @@map("document_provenance")
}

/// A suggestion from a connected AI app (T-084b): pending until a person approves or rejects it in the app.
model AgentProposal {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  dealId         String    @map("deal_id") @db.Uuid
  /// TERM | DOCUMENT_REQUEST | EVIDENCE
  kind           String
  payload        Json
  rationale      String    @default("")
  clientId       String    @map("client_id")
  clientName     String    @default("") @map("client_name")
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// PENDING | APPROVED | REJECTED | FAILED | WITHDRAWN
  status         String    @default("PENDING")
  decidedBy      String?   @map("decided_by") @db.Uuid
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz(3)
  decisionNote   String?   @map("decision_note")
  problem        String?
  resultRef      String?   @map("result_ref")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict, map: "agent_proposals_deal_fkey")

  @@index([organizationId, dealId, createdAt], map: "agent_proposals_org_deal_created_idx")
  @@map("agent_proposals")
}

/// A request to the seller for missing inputs (T-098). Both sides read it; the buyer side writes it.
model DocumentRequest {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  dealId         String    @map("deal_id") @db.Uuid
  items          String[]
  note           String?
  /// OPEN | CLOSED
  status         String    @default("OPEN")
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict, map: "document_requests_deal_fkey")

  @@index([organizationId, dealId, createdAt], map: "document_requests_org_deal_created_idx")
  @@map("document_requests")
}

/// Extracted page. The page id is the citation source id; purge nulls the
/// text but keeps number and checksum for provenance.
model DocumentPage {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  dealId         String  @map("deal_id") @db.Uuid
  documentId     String  @map("document_id") @db.Uuid
  pageNumber     Int     @map("page_number")
  text           String?
  checksum       String  @db.Char(64)
  /// T-121: TEXT (the file's own text), VISION (read by AI from the page image), TEXT_AND_VISION.
  textSource     String  @default("TEXT") @map("text_source")
  /// T-121: REPLACE or APPEND while the page waits to be read from its image; null otherwise.
  visionMode     String? @map("vision_mode")
  /// T-139: full-text index of the page (english), kept by a trigger; null for AI-excluded and purged pages.
  searchVector   Unsupported("tsvector")? @map("search_vector")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  document     Document     @relation(fields: [organizationId, dealId, documentId], references: [organizationId, dealId, id], onDelete: Restrict)

  @@unique([organizationId, dealId, documentId, pageNumber])
  @@index([searchVector], map: "document_pages_search_idx", type: Gin)
  @@map("document_pages")
}

/// Insert-only record of one model invocation: hashes and counts only, never
/// prompt or document content.
model AiRun {
  id               String      @id @default(uuid(7)) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  dealId           String      @map("deal_id") @db.Uuid
  taskType         String      @map("task_type")
  promptId         String      @map("prompt_id")
  promptVersion    String      @map("prompt_version")
  promptHash       String      @map("prompt_hash")
  modelAlias       String      @map("model_alias")
  resolvedModelId  String      @map("resolved_model_id")
  /// Which provider answered (T-131): bedrock, openai, google or fixture.
  resolvedProvider String      @default("bedrock") @map("resolved_provider")
  /// The job this run was (T-132): what its cost and lane are reported under.
  jobType          String?     @map("job_type")
  /// When a later lane answered: the model that was meant to, and why it was passed over (T-132).
  fallbackFrom     String?     @map("fallback_from")
  fallbackReason   String?     @map("fallback_reason")
  inputHashes      String[]    @map("input_hashes")
  outputHash       String?     @map("output_hash")
  status           AiRunStatus
  repairAttempted  Boolean     @map("repair_attempted")
  injectionSignals Int         @map("injection_signals")
  inputTokens      Int         @map("input_tokens")
  outputTokens     Int         @map("output_tokens")
  latencyMs        Int         @map("latency_ms")
  createdAt        DateTime    @map("created_at") @db.Timestamptz(3)
  /// The person whose request made the run (hosting cost by person); from the tenant context. Null for older runs.
  requestedBy      String?     @default(dbgenerated("app_current_user_id()")) @map("requested_by") @db.Uuid
  /// T-139: how a pact-wide run's pages were chosen (FULL or KEYWORD, page ids and checksums; never content).
  retrieval        Json?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal              @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  findings     DocumentFinding[]

  @@unique([organizationId, dealId, id])
  @@index([organizationId, dealId, createdAt])
  @@map("ai_runs")
}

/// AI-drafted document finding. Exact citations are stored with it; only a
/// named human moves it out of DRAFT.
model DocumentFinding {
  id                  String                @id @default(uuid(7)) @db.Uuid
  organizationId      String                @map("organization_id") @db.Uuid
  dealId              String                @map("deal_id") @db.Uuid
  documentId          String                @map("document_id") @db.Uuid
  aiRunId             String                @map("ai_run_id") @db.Uuid
  origin              String
  kind                DocumentFindingKind
  subtype             String
  domain              String
  title               String
  summary             String
  severity            FindingSeverity
  status              DocumentFindingStatus @default(DRAFT)
  fingerprint         String
  /// ResolvedCitation[]: page, offsets, quote and quote hash.
  citations           Json
  promptId            String                @map("prompt_id")
  promptVersion       String                @map("prompt_version")
  promptHash          String                @map("prompt_hash")
  resolvedModelId     String                @map("resolved_model_id")
  createdBy           String                @map("created_by") @db.Uuid
  reviewerUserId      String?               @map("reviewer_user_id") @db.Uuid
  reviewerDisplayName String?               @map("reviewer_display_name")
  decidedAt           DateTime?             @map("decided_at") @db.Timestamptz(3)
  version             Int
  createdAt           DateTime              @map("created_at") @db.Timestamptz(3)

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal                    @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  document     Document                @relation(fields: [organizationId, dealId, documentId], references: [organizationId, dealId, id], onDelete: Restrict)
  aiRun        AiRun                   @relation(fields: [organizationId, dealId, aiRunId], references: [organizationId, dealId, id], onDelete: Restrict)
  reviews      DocumentFindingReview[]

  @@unique([organizationId, dealId, id])
  @@unique([organizationId, dealId, documentId, fingerprint])
  @@index([organizationId, dealId, status])
  @@map("document_findings")
}

/// Append-only named human decision on a document finding.
model DocumentFindingReview {
  id                  String                 @id @default(uuid(7)) @db.Uuid
  organizationId      String                 @map("organization_id") @db.Uuid
  dealId              String                 @map("deal_id") @db.Uuid
  findingId           String                 @map("finding_id") @db.Uuid
  decision            DocumentReviewDecision
  reviewerUserId      String                 @map("reviewer_user_id") @db.Uuid
  reviewerDisplayName String                 @map("reviewer_display_name")
  rationale           String
  decidedAt           DateTime               @map("decided_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal            @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  finding      DocumentFinding @relation(fields: [organizationId, dealId, findingId], references: [organizationId, dealId, id], onDelete: Restrict)

  @@index([organizationId, dealId, findingId, decidedAt])
  @@map("document_finding_reviews")
}

/// Pre-authentication state for email-code sign-in. Reached only through
/// SECURITY DEFINER functions; the runtime role has no table privileges.
/// Holds an HMAC of the code, never the code.
model LoginChallenge {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  codeHash   String    @map("code_hash") @db.Char(64)
  ipHash     String    @map("ip_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([ipHash, createdAt])
  @@map("login_challenges")
}

/// A passkey (WebAuthn credential) for email-code sign-in (T-108). Reached only through
/// pactlab_auth SECURITY DEFINER functions; only the public key is stored.
model UserPasskey {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// base64url credential id, as the browser reports it.
  credentialId String    @unique @map("credential_id")
  publicKey    Bytes     @map("public_key")
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  name         String
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("user_passkeys")
}

/// A single-use WebAuthn challenge, valid for 5 minutes (T-108).
model PasskeyChallenge {
  id         String    @id @default(uuid(7)) @db.Uuid
  /// SIGN_IN (no user yet) or REGISTER (the signed-in user).
  purpose    String
  userId     String?   @map("user_id") @db.Uuid
  challenge  String
  ipHash     String?   @map("ip_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([ipHash, createdAt])
  @@map("passkey_challenges")
}

/// Server-side record of an email-code session. Every Pactlab-issued token
/// names its session, so revocation takes effect on the next request.
model AuthSession {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// Null until the user picks one of several email-code organizations.
  organizationId String?   @map("organization_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// When the person signed in; kept when the session moves between organizations (T-112).
  signedInAt     DateTime  @default(now()) @map("signed_in_at") @db.Timestamptz(3)
  /// The person trusted this device for a longer sign-in (1 day, 1 week or 30 days, within the organization's cap).
  trusted        Boolean   @default(false)
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// A readable name such as "Chrome on macOS"; never the raw user agent or an address.
  deviceLabel    String?   @map("device_label")
  /// Set when a shared-demo link opened the session (T-113); it ends with the share.
  demoShareId    String?   @map("demo_share_id") @db.Uuid

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

/// Pending self-serve sign-up: details plus an HMAC of the emailed code.
/// Reached only through SECURITY DEFINER functions; the runtime role has no
/// table privileges. The organization is created only when the code verifies.
model SignupChallenge {
  id               String    @id @default(uuid(7)) @db.Uuid
  email            String
  displayName      String    @map("display_name")
  organizationName String    @map("organization_name")
  ssoRequested     Boolean   @map("sso_requested")
  codeHash         String    @map("code_hash") @db.Char(64)
  ipHash           String    @map("ip_hash") @db.Char(64)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts         Int       @default(0)
  consumedAt       DateTime? @map("consumed_at") @db.Timestamptz(3)
  /// Set when the code verified and the organization was created.
  organizationId   String?   @map("organization_id") @db.Uuid

  @@index([email, createdAt])
  @@index([ipHash, createdAt])
  @@map("signup_challenges")
}

/// An uploaded billing export and how its columns map to the Pactlab
/// standard invoice line. Imports run through the idempotent sync engine on
/// a `billing_upload` connection; the mapping is kept for lineage.
model SourceUpload {
  id                 String             @id @default(uuid(7)) @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  dealId             String             @map("deal_id") @db.Uuid
  connectionId       String?            @map("connection_id") @db.Uuid
  target             ImportTarget
  system             String
  fileName           String             @map("file_name")
  sha256             String             @db.Char(64)
  sizeBytes          Int                @map("size_bytes")
  rowCount           Int                @map("row_count")
  header             Json
  /// CSV | TSV | XLSX: how the stored original is read (T-075).
  format             String             @default("CSV")
  /// Workbook sheet read, for XLSX uploads.
  sheet              String?
  /// The header's row among the sheet's non-empty rows; null: the first row (the standard template).
  headerRow          Int?               @map("header_row")
  /// The mapping assistant's checked proposal (picks, reasons, questions); never a value from the file.
  assist         Json?
  /// What the person told the mapping assistant about the file (T-152): free text and row notes; steers mapping only.
  guidance       Json?
  mapping        Json?
  mappingVersion String?            @map("mapping_version")
  objectKey      String?            @map("object_key")
  status         SourceUploadStatus @default(UPLOADED)
  syncRunId      String?            @map("sync_run_id") @db.Uuid
  visibility     EvidenceVisibility
  uploadedBy     String             @map("uploaded_by") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  importedAt     DateTime?          @map("imported_at") @db.Timestamptz(3)
  purgedAt       DateTime?          @map("purged_at") @db.Timestamptz(3)
  /// Withdrawal (T-154): who, when and why; all three or none.
  withdrawnAt        DateTime?          @map("withdrawn_at") @db.Timestamptz(3)
  withdrawnBy        String?            @map("withdrawn_by") @db.Uuid
  withdrawalReason   String?            @map("withdrawal_reason")
  /// The withdrawn import this one re-imports; at most one successor each.
  supersedesUploadId String?            @map("supersedes_upload_id") @db.Uuid

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal           @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  connection   Connection?    @relation(fields: [organizationId, dealId, connectionId], references: [organizationId, dealId, id], onDelete: Restrict)
  supersedes   SourceUpload?  @relation("UploadLineage", fields: [organizationId, dealId, supersedesUploadId], references: [organizationId, dealId, id], onDelete: Restrict)
  supersededBy SourceUpload?  @relation("UploadLineage")
  voids        EvidenceVoid[] @relation("UploadVoids")

  @@unique([organizationId, dealId, id])
  @@unique([organizationId, dealId, supersedesUploadId])
  @@index([organizationId, dealId, createdAt])
  @@map("source_uploads")
}

/// A confirmed import format (ADR 0042): how a file of this layout is read, reused on the next file with the same
/// layout signature without the assistant. One per pact, import target, signature and visibility (which follows the upload).
model ImportFormat {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  dealId         String             @map("deal_id") @db.Uuid
  target         ImportTarget
  /// sha256 of the target, layout kind, period granularity and the non-period header cells.
  signature      String             @db.Char(64)
  headerRow      Int?               @map("header_row")
  /// The confirmed mapping (fields, units, date format, line kinds), as stored on the upload it was confirmed on.
  mapping        Json
  sourceUploadId String             @map("source_upload_id") @db.Uuid
  sourceFileName String             @map("source_file_name")
  visibility     EvidenceVisibility
  confirmedBy    String             @map("confirmed_by") @db.Uuid
  confirmedAt    DateTime           @default(now()) @map("confirmed_at") @db.Timestamptz(3)
  uses           Int                @default(0)
  lastUsedAt     DateTime?          @map("last_used_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)

  /// One per visibility: a seller's shared format and the buyer's own never overwrite each other.
  @@unique([organizationId, dealId, target, signature, visibility])
  @@index([organizationId, dealId, target])
  @@map("import_formats")
}

/// The seller's asking price for a deal. Append-only: a revision is a new
/// version and the highest version is current. Buyer-side only.
model AskingPrice {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  dealId         String       @map("deal_id") @db.Uuid
  version        Int
  amount         Decimal      @db.Decimal(24, 4)
  currency       String       @db.Char(3)
  basis          AskingBasis
  source         AskingSource
  quotedOn       DateTime?    @map("quoted_on") @db.Date
  earnOutAmount  Decimal?     @map("earn_out_amount") @db.Decimal(24, 4)
  note           String?
  recordedBy     String       @map("recorded_by") @db.Uuid
  recordedAt     DateTime     @default(now()) @map("recorded_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, dealId, version])
  @@map("asking_prices")
}

/// A comparable transaction or public peer: an EV ÷ ARR data point used to
/// give a valuation multiple context. Organization-wide and reusable across
/// deals. Every row says where it came from; entered rows cite a source.
/// Rows are never deleted or edited — they are retired.
model Comparable {
  id              String           @id @default(uuid(7)) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  kind            ComparableKind
  origin          ComparableOrigin
  name            String
  targetName      String           @map("target_name")
  acquirerName    String?          @map("acquirer_name")
  announcedOn     DateTime?        @map("announced_on") @db.Date
  companyType     CompanyType      @map("company_type")
  region          String?
  enterpriseValue Decimal          @map("enterprise_value") @db.Decimal(24, 4)
  arr             Decimal          @db.Decimal(24, 4)
  /// Whether `arr` is annual recurring revenue or (as many announcements disclose) total revenue.
  arrBasis        ArrBasis         @default(ARR) @map("arr_basis")
  currency        String           @db.Char(3)
  arrGrowth       Decimal?         @map("arr_growth") @db.Decimal(9, 4)
  nrr             Decimal?         @db.Decimal(9, 4)
  grr             Decimal?         @db.Decimal(9, 4)
  sourceCitation  String?          @map("source_citation")
  sourceUrl       String?          @map("source_url")
  provider        String?
  providerVersion String?          @map("provider_version")
  sourceDealId    String?          @map("source_deal_id") @db.Uuid
  status          ComparableStatus @default(ACTIVE)
  recordedBy      String           @map("recorded_by") @db.Uuid
  recordedAt      DateTime         @default(now()) @map("recorded_at") @db.Timestamptz(3)
  retiredBy       String?          @map("retired_by") @db.Uuid
  retiredAt       DateTime?        @map("retired_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sourceDeal   Deal?               @relation(fields: [organizationId, sourceDealId], references: [organizationId, id], onDelete: Restrict)
  anchors      NegotiationAnchor[]

  @@unique([organizationId, id])
  @@unique([organizationId, sourceDealId])
  @@index([organizationId, status, companyType])
  @@map("comparables")
}

/// The buy-side deal lead's judgement of the asking price against the
/// comparables: in range, high or low, with a rationale. Append-only; the
/// newest is current. Records the ask and comparable set it was made against.
model MultipleJudgement {
  id                String          @id @default(uuid(7)) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  dealId            String          @map("deal_id") @db.Uuid
  verdict           MultipleVerdict
  rationale         String
  askingVersion     Int?            @map("asking_version")
  askingMultiple    Decimal?        @map("asking_multiple") @db.Decimal(12, 2)
  benchmarkVersion  String          @map("benchmark_version")
  comparableSetHash String          @map("comparable_set_hash")
  comparableCount   Int             @map("comparable_count")
  decidedBy         String          @map("decided_by") @db.Uuid
  decidedAt         DateTime        @default(now()) @map("decided_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, dealId, decidedAt])
  @@map("multiple_judgements")
}

/// A comparable the deal lead chose to cite against the seller's ask: the
/// target priced at that deal's multiple. Buyer side only; removed, never
/// deleted. The firm's own deals are confidential and never anchors.
model NegotiationAnchor {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  dealId         String       @map("deal_id") @db.Uuid
  comparableId   String       @map("comparable_id") @db.Uuid
  note           String?
  status         AnchorStatus @default(ACTIVE)
  addedBy        String       @map("added_by") @db.Uuid
  addedAt        DateTime     @default(now()) @map("added_at") @db.Timestamptz(3)
  removedBy      String?      @map("removed_by") @db.Uuid
  removedAt      DateTime?    @map("removed_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  comparable   Comparable   @relation(fields: [organizationId, comparableId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, dealId, status])
  @@map("negotiation_anchors")
}

/// A cash, debt or debt-like item for a deal, backed by an exact citation to
/// a document page. Scenarios link items; a revision bumps `version` (with a
/// row in the history) and makes linked results stale. Buyer side only.
model BalanceSheetItem {
  id             String                 @id @default(uuid(7)) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  dealId         String                 @map("deal_id") @db.Uuid
  kind           BalanceSheetKind
  category       String
  label          String
  amount         Decimal                @db.Decimal(24, 4)
  currency       String                 @db.Char(3)
  asOf           DateTime               @map("as_of") @db.Date
  /// ResolvedCitation: documentId, pageNumber, quote, quoteHash, charStart, charEnd.
  citation       Json
  note           String?
  /// Loan terms (DEBT items only; T-078). Rates are fractions: 0.075 = 7.5 %.
  interestRate   Decimal?               @map("interest_rate") @db.Decimal(9, 6)
  /// FIXED | FLOATING
  rateType       String?                @map("rate_type")
  rateReference  String?                @map("rate_reference")
  maturityDate   DateTime?              @map("maturity_date") @db.Date
  lender         String?
  /// AMORTIZING | BULLET | REVOLVING
  repayment      String?
  covenantNote   String?                @map("covenant_note")
  version        Int                    @default(1)
  status         BalanceSheetItemStatus @default(ACTIVE)
  createdBy      String                 @map("created_by") @db.Uuid
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedBy      String                 @map("updated_by") @db.Uuid
  updatedAt      DateTime               @default(now()) @map("updated_at") @db.Timestamptz(3)

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal                      @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  versions     BalanceSheetItemVersion[]

  @@unique([organizationId, dealId, id])
  @@index([organizationId, dealId, status])
  @@map("balance_sheet_items")
}

/// Every version of a balance-sheet item, with who changed it and why. Append-only.
model BalanceSheetItemVersion {
  id             String                 @id @default(uuid(7)) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  dealId         String                 @map("deal_id") @db.Uuid
  itemId         String                 @map("item_id") @db.Uuid
  version        Int
  kind           BalanceSheetKind
  category       String
  label          String
  amount         Decimal                @db.Decimal(24, 4)
  currency       String                 @db.Char(3)
  asOf           DateTime               @map("as_of") @db.Date
  citation       Json
  note           String?
  /// Loan terms (DEBT items only; T-078). Rates are fractions: 0.075 = 7.5 %.
  interestRate   Decimal?               @map("interest_rate") @db.Decimal(9, 6)
  /// FIXED | FLOATING
  rateType       String?                @map("rate_type")
  rateReference  String?                @map("rate_reference")
  maturityDate   DateTime?              @map("maturity_date") @db.Date
  lender         String?
  /// AMORTIZING | BULLET | REVOLVING
  repayment      String?
  covenantNote   String?                @map("covenant_note")
  status         BalanceSheetItemStatus
  reason         String
  changedBy      String                 @map("changed_by") @db.Uuid
  changedAt      DateTime               @default(now()) @map("changed_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal             @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  item         BalanceSheetItem @relation(fields: [organizationId, dealId, itemId], references: [organizationId, dealId, id], onDelete: Restrict)

  @@unique([organizationId, dealId, itemId, version])
  @@map("balance_sheet_item_versions")
}

/// The gated contributor directory: raw identities and names behind the
/// pseudonymous keys used in evidence. Written by the sync engine; read only
/// through the names gate (people_access), every read audited. Buyer side.
model ContributorIdentity {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  dealId         String            @map("deal_id") @db.Uuid
  contributorKey String            @map("contributor_key")
  system         String
  identity       String
  displayName    String?           @map("display_name")
  status         ContributorStatus @default(UNKNOWN)
  firstSeenAt    DateTime          @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt     DateTime          @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, dealId, system, identity])
  @@index([organizationId, dealId, contributorKey])
  @@map("contributor_identities")
}

/// Whether contributor names are shown on a deal, and why. Append-only; the
/// newest row decides. Only a deal lead records it.
model PeopleAccess {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  enabled        Boolean
  basis          String
  decidedBy      String   @map("decided_by") @db.Uuid
  decidedAt      DateTime @default(now()) @map("decided_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, dealId, decidedAt])
  @@map("people_access")
}

/// Pre-Diligence screening (T-071): one per deal, directional only — never
/// creates findings or touches valuation. Buyer side (RLS).
model ScreeningReview {
  id               String    @id @default(uuid(7)) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  dealId           String    @map("deal_id") @db.Uuid
  intakeNotes      String?   @map("intake_notes")
  headlineRevenue  Decimal?  @map("headline_revenue") @db.Decimal(24, 4)
  headlineCurrency String?   @map("headline_currency") @db.Char(3)
  valueLow         Decimal?  @map("value_low") @db.Decimal(24, 4)
  valueHigh        Decimal?  @map("value_high") @db.Decimal(24, 4)
  /// [{ id, text }]: red flags; GO turns each into a claim to verify.
  redFlags         Json      @default("[]") @map("red_flags")
  /// GO | NO_GO | NEEDS_MORE, once decided.
  verdict          String?
  rationale        String?
  gaps             String?
  decidedBy        String?   @map("decided_by") @db.Uuid
  decidedAt        DateTime? @map("decided_at") @db.Timestamptz(3)
  version          Int       @default(1)
  updatedBy        String    @map("updated_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  deal Deal @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict, map: "screening_reviews_deal_fkey")

  @@unique([organizationId, dealId])
  @@map("screening_reviews")
}

/// Said vs observed (T-071): a seller assertion and how evidence bears on it.
/// Links are ids of evidence items and findings — references, never copies.
model DealClaim {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  dealId          String   @map("deal_id") @db.Uuid
  statement       String
  source          String?
  /// SCREENING_RED_FLAG | MANUAL | PACK_RULE | HAND_SOURCED (entered by hand in Pactlab Rinse; never documentary evidence)
  origin          String
  /// UNVERIFIED | VERIFIED | CONTRADICTED
  status          String   @default("UNVERIFIED")
  rationale       String?
  evidenceItemIds String[] @default([]) @map("evidence_item_ids") @db.Uuid
  findingIds      String[] @default([]) @map("finding_ids") @db.Uuid
  version         Int      @default(1)
  createdBy       String   @map("created_by") @db.Uuid
  updatedBy       String   @map("updated_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  deal Deal @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict, map: "deal_claims_deal_fkey")

  @@unique([organizationId, dealId, id])
  @@index([organizationId, dealId, createdAt])
  @@map("deal_claims")
}

/// Post-Close registers (T-071): assets to preserve, actions and watch items,
/// generated from diligence output when the deal closes. Idempotent by source.
model PostCloseItem {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  dealId         String    @map("deal_id") @db.Uuid
  /// ASSET | ACTION | WATCH
  kind           String
  /// FINDING
  sourceType     String    @map("source_type")
  sourceId       String    @map("source_id") @db.Uuid
  title          String
  action         String
  ownerUserId    String?   @map("owner_user_id") @db.Uuid
  dueDate        DateTime? @map("due_date") @db.Date
  /// MONTHLY | QUARTERLY | ANNUAL
  cadence        String?
  /// OPEN | DONE | LAPSED
  status         String    @default("OPEN")
  note           String?
  version        Int       @default(1)
  updatedBy      String    @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  deal Deal @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict, map: "post_close_items_deal_fkey")

  @@unique([organizationId, dealId, kind, sourceType, sourceId], map: "post_close_items_source_key")
  @@index([organizationId, dealId])
  @@map("post_close_items")
}

/// Per-organization feature flags (T-072), changed by operators without a
/// deploy. Written only through `app_ops_set_flags`.
model OrganizationFlags {
  organizationId String   @id @map("organization_id") @db.Uuid
  pilotMode      Boolean  @default(false) @map("pilot_mode")
  liveConnectors Boolean  @default(true) @map("live_connectors")
  /// The MCP server for this organization (T-084), off until an operator turns it on.
  mcpEnabled     Boolean  @default(false) @map("mcp_enabled")
  /// API access for members (T-128), on unless an organization admin turns it off.
  apiEnabled     Boolean  @default(true) @map("api_enabled")
  updatedBy      String?  @map("updated_by") @db.Uuid
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "organization_flags_organization_fkey")

  @@map("organization_flags")
}

/// Bug reports (T-072): user-filed or automatic, deduplicated by fingerprint,
/// context scrubbed before writing. Reached only through `app_bug_*` functions.
model BugReport {
  id             String   @id @default(uuid(7)) @db.Uuid
  number         Int      @unique(map: "bug_reports_number_key")
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String?  @map("deal_id") @db.Uuid
  reporterUserId String?  @map("reporter_user_id") @db.Uuid
  /// USER_REPORT | FRONTEND_EXCEPTION | BACKEND_EXCEPTION | JOB_EXHAUSTED
  trigger        String
  fingerprint    String
  title          String
  whatHappened   String?  @map("what_happened")
  expected       String?
  /// LOW | MEDIUM | HIGH | BLOCKER
  severity       String
  /// NEW | TRIAGED | IN_PROGRESS | RESOLVED | WONT_FIX
  status         String   @default("NEW")
  context        Json     @default("{}")
  screenshot     Bytes?
  screenshotType String?  @map("screenshot_type")
  internalNotes  String?  @map("internal_notes")
  /// Pactlab's reply, shown to the reporter (internal_notes never is).
  reporterNote   String?  @map("reporter_note")
  occurrences    Int      @default(1)
  firstSeenAt    DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt     DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "bug_reports_organization_fkey")

  @@index([fingerprint, status], map: "bug_reports_fingerprint_idx")
  @@index([reporterUserId, lastSeenAt], map: "bug_reports_reporter_idx")
  @@map("bug_reports")
}

/// Foresight (T-073): an AI baseline of five-year trend lines for a deal —
/// dated, with the model and prompt version that produced it.
model ForesightTrendSet {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  asOf           DateTime @map("as_of") @db.Date
  provenance     String   @default("AI")
  modelId        String   @map("model_id")
  promptId       String   @map("prompt_id")
  promptVersion  String   @map("prompt_version")
  aiRunId        String?  @map("ai_run_id") @db.Uuid
  baseGrowth     Decimal  @default(0.10) @map("base_growth") @db.Decimal(9, 6)
  baseMargin     Decimal  @default(0.20) @map("base_margin") @db.Decimal(9, 6)
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  deal      Deal                @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict, map: "foresight_trend_sets_deal_fkey")
  trends    ForesightTrend[]
  scenarios ForesightScenario[]

  @@unique([organizationId, dealId, id])
  @@index([organizationId, dealId, createdAt])
  @@map("foresight_trend_sets")
}

model ForesightTrend {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  dealId         String @map("deal_id") @db.Uuid
  trendSetId     String @map("trend_set_id") @db.Uuid
  ordinal        Int
  key            String
  label          String
  /// MACRO | SECTOR
  category       String
  /// UP | FLAT | DOWN
  direction      String
  /// LOW | MEDIUM | HIGH
  magnitude      String
  confidence     String
  narrative      String
  effects        Json

  trendSet ForesightTrendSet @relation(fields: [organizationId, dealId, trendSetId], references: [organizationId, dealId, id], onDelete: Restrict, map: "foresight_trends_set_fkey")

  @@unique([organizationId, dealId, trendSetId, key], map: "foresight_trends_set_key")
  @@map("foresight_trends")
}

/// A user's own view (T-073): overrides and custom trends layered on a
/// baseline, which is never edited.
model ForesightScenario {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  trendSetId     String   @map("trend_set_id") @db.Uuid
  name           String
  baseGrowth     Decimal  @map("base_growth") @db.Decimal(9, 6)
  baseMargin     Decimal  @map("base_margin") @db.Decimal(9, 6)
  /// { [trendKey]: { direction?, magnitude?, weight? } }
  overrides      Json     @default("{}")
  /// User trend lines: { key, label, direction, magnitude, confidence, narrative, effects }[]
  customTrends   Json     @default("[]") @map("custom_trends")
  version        Int      @default(1)
  createdBy      String   @map("created_by") @db.Uuid
  updatedBy      String   @map("updated_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  trendSet ForesightTrendSet @relation(fields: [organizationId, dealId, trendSetId], references: [organizationId, dealId, id], onDelete: Restrict, map: "foresight_scenarios_set_fkey")

  @@unique([organizationId, dealId, id])
  @@map("foresight_scenarios")
}

/// A question about the trends and projection, typed or spoken, with the
/// grounded answer and the trends it relied on. Transcripts only; no audio.
model ForesightQuestion {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  scenarioId     String?  @map("scenario_id") @db.Uuid
  /// TEXT | VOICE
  via            String
  question       String
  answer         String
  reliesOn       String[] @default([]) @map("relies_on")
  aiRunId        String?  @map("ai_run_id") @db.Uuid
  askedBy        String   @map("asked_by") @db.Uuid
  askedAt        DateTime @default(now()) @map("asked_at") @db.Timestamptz(3)

  deal Deal @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict, map: "foresight_questions_deal_fkey")

  @@index([organizationId, dealId, askedAt])
  @@map("foresight_questions")
}

/// Venture Raise (T-083): the round a founder is raising, one row per deal.
/// Investors' bids are `VentureOffer` rows on the same deal.
model VentureRaiseSettings {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  dealId         String       @map("deal_id") @db.Uuid
  /// PRE_SEED | SEED_SAFE | SEED_NOTE | SEED_PRICED | SERIES_A
  roundType      String       @map("round_type")
  currency       String       @db.Char(3)
  /// The founder's ask.
  targetPreMoney Decimal      @map("target_pre_money") @db.Decimal(24, 4)
  raiseAmount    Decimal      @map("raise_amount") @db.Decimal(24, 4)
  /// Post-money option pool target, as a fraction (0.10 = 10%).
  poolTargetPct  Decimal      @map("pool_target_pct") @db.Decimal(9, 6)
  sector         CompanyType?
  version        Int          @default(1)
  updatedBy      String       @map("updated_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @default(now()) @map("updated_at") @db.Timestamptz(3)

  deal Deal @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict, map: "venture_raise_settings_deal_fkey")

  @@unique([organizationId, dealId])
  @@map("venture_raise_settings")
}

/// Venture Raise (T-083): one investor's bid on the round. Several may compete.
model VentureOffer {
  id                  String    @id @default(uuid(7)) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  dealId              String    @map("deal_id") @db.Uuid
  /// The investing organization (a firm or fund), not a person.
  investorName        String    @map("investor_name")
  /// ANGEL | INCUBATOR | VC
  counterpartyType    String    @map("counterparty_type")
  /// PROSPECT | TERM_SHEET | DECLINED | SIGNED
  status              String    @default("PROSPECT")
  preMoney            Decimal?  @map("pre_money") @db.Decimal(24, 4)
  amount              Decimal?  @db.Decimal(24, 4)
  poolTargetPct       Decimal?  @map("pool_target_pct") @db.Decimal(9, 6)
  liquidationMultiple Decimal   @default(1) @map("liquidation_multiple") @db.Decimal(6, 2)
  participating       Boolean   @default(false)
  investorBoardSeats  Int?      @map("investor_board_seats")
  proRata             Boolean   @default(false) @map("pro_rata")
  mfn                 Boolean   @default(false)
  receivedOn          DateTime? @map("received_on") @db.Date
  version             Int       @default(1)
  createdBy           String    @map("created_by") @db.Uuid
  updatedBy           String    @map("updated_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  deal Deal @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict, map: "venture_offers_deal_fkey")

  @@unique([organizationId, dealId, id])
  @@index([organizationId, dealId, createdAt])
  @@map("venture_offers")
}

/// A five-year numeric forecast for one Foresight key metric (T-094 B10):
/// published (EXTERNAL, e.g. IMF WEO), AI, or the user's own. Append-only
/// per (metric, source): a new version supersedes the last. Values are
/// percent a year for `first_year` .. `first_year + 4`.
model ForesightForecast {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  dealId         String    @map("deal_id") @db.Uuid
  metricKey      String    @map("metric_key")
  /// EXTERNAL | AI | USER
  source         String
  version        Int       @default(1)
  firstYear      Int       @map("first_year")
  values         Decimal[] @db.Decimal(9, 4)
  sourceName     String?   @map("source_name")
  sourceUrl      String?   @map("source_url")
  sourceAsOf     DateTime? @map("source_as_of") @db.Date
  rationale      String?
  modelId        String?   @map("model_id")
  promptId       String?   @map("prompt_id")
  promptVersion  String?   @map("prompt_version")
  aiRunId        String?   @map("ai_run_id") @db.Uuid
  /// Null when drafted by the system (published or AI refresh).
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  deal Deal @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict, map: "foresight_forecasts_deal_fkey")

  @@unique([organizationId, dealId, metricKey, source, version], map: "foresight_forecasts_metric_version_key")
  @@index([organizationId, dealId, createdAt])
  @@map("foresight_forecasts")
}

/// The state of a pact's Foresight baseline refresh (published + AI forecasts), so the tab never waits on a live call.
model ForesightBaseline {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  dealId         String    @map("deal_id") @db.Uuid
  /// RUNNING | READY | PARTIAL | FAILED
  status         String
  /// Plain-language notes on what could not be fetched (never provider text).
  notes          String[]  @default([])
  startedAt      DateTime  @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(3)

  deal Deal @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict, map: "foresight_baselines_deal_fkey")

  @@unique([organizationId, dealId])
  @@map("foresight_baselines")
}

/// An invitation to one pact (T-094 B12, ADR 0014): one email, one side and
/// role. The token is stored only as its hash. Accepting makes the invitee a
/// guest on the pact (a deal membership), never a member of this organization.
model DealInvitation {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  dealId         String    @map("deal_id") @db.Uuid
  email          String
  /// BUYER | SELLER | ADVISOR
  side           String
  role           DealRole
  bidId          String?   @map("bid_id") @db.Uuid
  /// For an INVESTOR invitation: the seat it is for (T-141).
  investorId     String?   @map("investor_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  /// PENDING | ACCEPTED | REVOKED (expiry is read from expires_at)
  status         String    @default("PENDING")
  invitedBy      String    @map("invited_by") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedBy     String?   @map("accepted_by") @db.Uuid
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// SENT | FAILED (T-125): whether the invitation email went out; null before the send finished
  emailStatus    String?   @map("email_status")
  /// SUPPRESSED (the address bounced or complained before) | UNAVAILABLE (email could not be sent)
  emailProblem   String?   @map("email_problem")

  deal Deal @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict, map: "deal_invitations_deal_fkey")

  @@index([organizationId, dealId, createdAt])
  @@map("deal_invitations")
}

/// A seller-led pact's bid process (T-097, ADR 0015). The seller's side runs it; bidders read it.
model SaleProcess {
  dealId         String    @map("deal_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  /// OPEN | AWARDED | CLOSED
  status         String    @default("OPEN")
  round          Int       @default(1)
  offerDeadline  DateTime? @map("offer_deadline") @db.Timestamptz(3)
  sharedSummary  String?   @map("shared_summary")
  dataRoomUrl    String?   @map("data_room_url")
  ndaText        String?   @map("nda_text")
  awardedBidId   String?   @map("awarded_bid_id") @db.Uuid
  updatedBy      String    @map("updated_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@id([organizationId, dealId])
  @@map("sale_processes")
}

/// One bidding firm in a seller-led pact. A bidder sees only their own (RLS).
model Bid {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  dealId         String    @map("deal_id") @db.Uuid
  firmName       String    @map("firm_name")
  /// INVITED | ACTIVE | OFFERED | PASSED | SHORTLISTED | DECLINED | WON
  status         String    @default("INVITED")
  round          Int       @default(1)
  ndaAcceptedAt  DateTime? @map("nda_accepted_at") @db.Timestamptz(3)
  ndaAcceptedBy  String?   @map("nda_accepted_by") @db.Uuid
  passReason     String?   @map("pass_reason")
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz(3)
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  offers    BidOffer[]
  questions BidQuestion[]

  @@unique([organizationId, dealId, id], map: "bids_org_deal_id_key")
  @@index([organizationId, dealId, createdAt], map: "bids_org_deal_created_idx")
  @@map("bids")
}

/// A bidder's offer. Every version is kept; money is decimal with its currency.
model BidOffer {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  dealId         String    @map("deal_id") @db.Uuid
  bidId          String    @map("bid_id") @db.Uuid
  version        Int
  round          Int
  price          Decimal   @db.Decimal(24, 4)
  currency       String    @db.Char(3)
  preMoney       Decimal?  @map("pre_money") @db.Decimal(24, 4)
  structure      String
  conditions     String?
  validUntil     DateTime? @map("valid_until") @db.Date
  submittedBy    String    @map("submitted_by") @db.Uuid
  submittedAt    DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(3)

  bid Bid @relation(fields: [organizationId, dealId, bidId], references: [organizationId, dealId, id], onDelete: Restrict, map: "bid_offers_bid_fkey")

  @@unique([organizationId, dealId, bidId, version], map: "bid_offers_bid_version_key")
  @@map("bid_offers")
}

/// A bidder's question; private to that bidder unless an answer is published to all.
model BidQuestion {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  dealId         String    @map("deal_id") @db.Uuid
  bidId          String    @map("bid_id") @db.Uuid
  question       String
  askedBy        String    @map("asked_by") @db.Uuid
  askedAt        DateTime  @default(now()) @map("asked_at") @db.Timestamptz(3)
  answer         String?
  /// PRIVATE | ALL
  answerScope    String?   @map("answer_scope")
  answeredBy     String?   @map("answered_by") @db.Uuid
  answeredAt     DateTime? @map("answered_at") @db.Timestamptz(3)

  bid Bid @relation(fields: [organizationId, dealId, bidId], references: [organizationId, dealId, id], onDelete: Restrict, map: "bid_questions_bid_fkey")

  @@index([organizationId, dealId, askedAt], map: "bid_questions_org_deal_asked_idx")
  @@map("bid_questions")
}

/// An answer published to every bidder, with no link to who asked.
model BidAnswerPublished {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  question       String
  answer         String
  publishedBy    String   @map("published_by") @db.Uuid
  publishedAt    DateTime @default(now()) @map("published_at") @db.Timestamptz(3)

  @@index([organizationId, dealId, publishedAt], map: "bid_answers_published_org_deal_idx")
  @@map("bid_answers_published")
}

/// A bidder's comment on a document the seller shared, or a reply in that thread (T-097). Bid-scoped (RLS).
model BidComment {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  bidId          String   @map("bid_id") @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  pageNumber     Int?     @map("page_number")
  quote          String?
  body           String
  parentId       String?  @map("parent_id") @db.Uuid
  /// BIDDER | SELLER
  authorSide     String   @map("author_side")
  authorId       String   @map("author_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([organizationId, dealId, id], map: "bid_comments_org_deal_id_key")
  @@index([organizationId, dealId, bidId, createdAt], map: "bid_comments_bid_idx")
  @@map("bid_comments")
}

/// A file a bidder attaches to their bid (a marked-up agreement, a letter of intent). Bid-scoped (RLS); never in the shared library.
model BidFile {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  bidId          String   @map("bid_id") @db.Uuid
  fileName       String   @map("file_name")
  contentType    String   @map("content_type")
  sizeBytes      Int      @map("size_bytes")
  sha256         String   @db.Char(64)
  objectKey      String   @unique(map: "bid_files_object_key_key") @map("object_key")
  malwareScanner String   @map("malware_scanner")
  uploadedBy     String   @map("uploaded_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, dealId, bidId, createdAt], map: "bid_files_bid_idx")
  @@map("bid_files")
}

/// Regulatory & deal-certainty inputs that are not imports (T-091): terms, remedy buyer, feedback, revisions, pledges. Each cites a document page. Append-only; buyer side.
model RegulatoryEntry {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  /// TERMS | BUYER | FEEDBACK | REVISION | COMMITMENT | POSTURE
  kind           String
  payload        Json
  /// { documentId, pageNumber, quote }
  citation       Json
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, dealId, kind, createdAt], map: "regulatory_entries_org_deal_idx")
  @@map("regulatory_entries")
}

/// T-135: one cited input of the quality-of-earnings work product — reported EBITDA, a
/// normalization adjustment, a seller-claimed add-back, or a working-capital line. Append-only:
/// a change is the next `version` of the same `entry_key`; the latest counts. Buyer-side.
model QoeEntry {
  id                   String    @id @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  dealId               String    @map("deal_id") @db.Uuid
  entryKey             String    @map("entry_key") @db.Uuid
  version              Int
  /// REPORTED_EBITDA | ADJUSTMENT | ADD_BACK | WORKING_CAPITAL
  kind                 String
  /// The earnings period (e.g. "FY2025"); null for working-capital lines.
  period               String?
  /// The balance-sheet date of a working-capital line.
  periodEnd            DateTime? @map("period_end") @db.Date
  /// Adjustment category (QOE_ADJUSTMENT_CATEGORIES) or working-capital component.
  category             String?
  label                String
  /// Reported EBITDA, the adjustment (signed: + raises EBITDA), the seller's claimed add-back, or the line's balance.
  amount               Decimal   @db.Decimal(24, 4)
  currency             String    @db.Char(3)
  /// { documentId, pageNumber, quote, quoteHash, charStart, charEnd }: where the figure is stated.
  citation             Json
  /// Why the adjustment is made; for an add-back, the seller's stated rationale.
  rationale            String?
  /// ADD_BACK only: VERIFIED | PARTIALLY_VERIFIED | UNVERIFIED.
  verificationStatus   String?   @map("verification_status")
  verifiedAmount       Decimal?  @map("verified_amount") @db.Decimal(24, 4)
  /// The evidence a verification rests on (required unless UNVERIFIED).
  verificationCitation Json?     @map("verification_citation")
  /// ADD_BACK only: RECURRING | ONE_OFF.
  recurrence           String?
  /// ADD_BACK only: a reviewer's explicit INCLUDE or EXCLUDE, with its reason.
  inclusion            String?
  decisionReason       String?   @map("decision_reason")
  withdrawn            Boolean   @default(false)
  /// Why this version exists ("Recorded", a correction, a decision).
  reason               String
  /// The draft finding this entry became (its route to valuation).
  findingId            String?   @map("finding_id") @db.Uuid
  createdBy            String    @map("created_by") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([organizationId, dealId, entryKey, version], map: "qoe_entries_entry_version_key")
  @@index([organizationId, dealId, kind, createdAt], map: "qoe_entries_org_deal_idx")
  @@map("qoe_entries")
}

/// T-091 Part 2: an analyst-built candidate remedy package (explicit site list), append-only, buyer-side.
model RegulatoryScenario {
  id                  String   @id @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  dealId              String   @map("deal_id") @db.Uuid
  name                String
  baseRevision        Int?     @map("base_revision")
  remedyBuyer         String   @map("remedy_buyer")
  siteIds             Json     @map("site_ids")
  distributionCenters Json     @map("distribution_centers")
  systemsTransferred  Json     @map("systems_transferred")
  /// How it was built: { addMarkets, divestingParty, addSites, removeSites, transferOperations }
  recipe              Json
  createdBy           String   @map("created_by") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, dealId, createdAt], map: "regulatory_scenarios_org_deal_idx")
  @@map("regulatory_scenarios")
}

/// A pact's public page: a seller-written teaser at an unguessable link (never evidence).
model DealListing {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  dealId          String    @map("deal_id") @db.Uuid
  slug            String    @unique(map: "deal_listings_slug_key")
  /// DRAFT | PUBLISHED | CLOSED
  status          String    @default("DRAFT")
  /// ANONYMOUS | NAMED
  visibility      String    @default("ANONYMOUS")
  codename        String
  publicName      String?   @map("public_name")
  headline        String
  sector          String?
  region          String?
  sizeBand        String?   @map("size_band")
  askingLow       Decimal?  @map("asking_low") @db.Decimal(20, 2)
  askingHigh      Decimal?  @map("asking_high") @db.Decimal(20, 2)
  askingCurrency  String?   @map("asking_currency") @db.Char(3)
  summary         String    @default("")
  highlights      String[]  @default([])
  /// The property's address; shown publicly only on a NAMED teaser (batch 2).
  propertyAddress String?   @map("property_address")
  /// Facts the seller approved from a property-data lookup: [{key, label, value, source, retrievedAt}].
  propertyFacts   Json      @default("[]") @map("property_facts")
  indexable       Boolean   @default(false)
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(3)
  createdBy       String    @map("created_by") @db.Uuid
  updatedBy       String    @map("updated_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@unique([organizationId, dealId], map: "deal_listings_org_deal_key")
  @@unique([organizationId, dealId, id], map: "deal_listings_org_deal_id_key")
  @@map("deal_listings")
}

/// A request for access left on a public page. Only the seller's side sees it (RLS).
model ListingInterest {
  id               String    @id @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  dealId           String    @map("deal_id") @db.Uuid
  listingId        String    @map("listing_id") @db.Uuid
  name             String
  firm             String
  email            String
  /// STRATEGIC | FINANCIAL | INDIVIDUAL | ADVISER
  intent           String
  message          String?
  /// PENDING_EMAIL | NEW | APPROVED | DECLINED
  status           String    @default("PENDING_EMAIL")
  tokenHash        String?   @unique(map: "listing_interests_token_key") @map("token_hash")
  ipHash           String    @map("ip_hash")
  emailConfirmedAt DateTime? @map("email_confirmed_at") @db.Timestamptz(3)
  decidedAt        DateTime? @map("decided_at") @db.Timestamptz(3)
  decidedBy        String?   @map("decided_by") @db.Uuid
  decisionNote     String?   @map("decision_note")
  bidId            String?   @map("bid_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([listingId, createdAt], map: "listing_interests_listing_idx")
  @@index([ipHash, createdAt], map: "listing_interests_ip_idx")
  @@index([organizationId, dealId, status, createdAt], map: "listing_interests_org_deal_idx")
  @@map("listing_interests")
}

/// A picture or video link on a public deal page. Images are in the object store; videos are a provider and id.
model ListingMedia {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  listingId      String   @map("listing_id") @db.Uuid
  /// IMAGE | VIDEO
  kind           String
  position       Int
  caption        String?
  objectKey      String?  @map("object_key")
  contentType    String?  @map("content_type")
  sha256         String?
  byteSize       Int?     @map("byte_size")
  /// YOUTUBE | VIMEO
  videoProvider  String?  @map("video_provider")
  videoId        String?  @map("video_id")
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([listingId, position], map: "listing_media_listing_idx")
  @@map("listing_media")
}

/// A pact priced under one buyer persona (T-105, ADR 0021): the persona-priced
/// runs of its tagged scenarios, the weighted price and the term mix. Insert-only;
/// switching persona makes a new evaluation. Buyer-confidential.
model PricingEvaluation {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  persona        String
  personaVersion String   @map("persona_version")
  runIds         String[] @map("run_ids") @db.Uuid
  /// Each run's scenario and case: [{runId, scenarioId, case, equityPurchasePrice}].
  cases          Json
  currency       String   @db.Char(3)
  weightedPrice  Decimal  @map("weighted_price") @db.Decimal(20, 2)
  termMix        Json     @map("term_mix")
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([organizationId, dealId, id], map: "pricing_evaluations_org_deal_id_key")
  @@index([organizationId, dealId, createdAt], map: "pricing_evaluations_org_deal_idx")
  @@map("pricing_evaluations")
}

/// Append-only: the latest adoption is the pact's active pricing.
model PricingAdoption {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  evaluationId   String   @map("evaluation_id") @db.Uuid
  adoptedBy      String   @map("adopted_by") @db.Uuid
  adoptedAt      DateTime @default(now()) @map("adopted_at") @db.Timestamptz(3)

  @@index([organizationId, dealId, adoptedAt], map: "pricing_adoptions_org_deal_idx")
  @@map("pricing_adoptions")
}

/// A versioned set of deal terms drafted from an evaluation. Proposing it to the
/// seller is one-way (`proposed_at` is set once). Seller-readable once proposed,
/// so it carries no persona: the persona stamp is its evaluation's, buyer-only.
model TermProposalBatch {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  dealId          String    @map("deal_id") @db.Uuid
  /// The buyer evaluation a buyer version was priced from; null for a seller's version (T-107).
  evaluationId    String?   @map("evaluation_id") @db.Uuid
  version         Int
  currency        String    @db.Char(3)
  /// BUYER | SELLER: who drafted and proposed this version; the other side answers it (T-107).
  initiatedBySide String    @default("BUYER") @map("initiated_by_side")
  createdBy       String    @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  proposedAt      DateTime? @map("proposed_at") @db.Timestamptz(3)
  proposedBy      String?   @map("proposed_by") @db.Uuid
  /// Set once, when the other side has accepted every term of this proposed version.
  agreedAt        DateTime? @map("agreed_at") @db.Timestamptz(3)
  /// A signatory turned an agreed version down before signing; a new version follows (T-107).
  declinedAt      DateTime? @map("declined_at") @db.Timestamptz(3)
  declinedBy      String?   @map("declined_by") @db.Uuid

  terms     TermProposal[]
  responses TermResponse[]
  signoffs  TermSignoff[]
  envelopes SignatureEnvelope[]

  @@unique([organizationId, dealId, id], map: "term_proposal_batches_org_deal_id_key")
  @@unique([organizationId, dealId, version], map: "term_proposal_batches_version_key")
  @@map("term_proposal_batches")
}

/// One term in a batch. `seller_note` is the buyer's wording for the seller and
/// the only free text the seller sees; `finding_id` is buyer-only.
model TermProposal {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  dealId         String    @map("deal_id") @db.Uuid
  batchId        String    @map("batch_id") @db.Uuid
  ordinal        Int
  /// PURCHASE_PRICE | PRICE_REDUCTION | REMEDIATION_COST | ESCROW | INDEMNITY | RETENTION | EARNOUT | SELLER_FINANCING | FINANCING_CONTINGENCY | WORKING_CAPITAL_PEG
  lever          String
  amount         Decimal   @db.Decimal(20, 2)
  currency       String    @db.Char(3)
  findingId      String?   @map("finding_id") @db.Uuid
  sellerNote     String    @default("") @map("seller_note")
  /// FINANCING_CONTINGENCY only (T-117): the date the financing must be in place by.
  dueOn          DateTime? @map("due_on") @db.Date

  batch TermProposalBatch @relation(fields: [organizationId, dealId, batchId], references: [organizationId, dealId, id], onDelete: Cascade, map: "term_proposals_batch_fkey")

  @@unique([batchId, ordinal], map: "term_proposals_batch_ordinal_key")
  @@map("term_proposals")
}

/// The AI negotiation brief for an evaluation (T-105): a buyer-only draft whose
/// tone follows the persona; every section cites accepted findings. Insert-only.
model NegotiationBrief {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  evaluationId   String   @map("evaluation_id") @db.Uuid
  persona        String
  personaVersion String   @map("persona_version")
  /// [{heading, body, citedFindingIds}]
  sections       Json
  promptId       String   @map("prompt_id")
  promptVersion  String   @map("prompt_version")
  modelId        String   @map("model_id")
  aiRunId        String?  @map("ai_run_id") @db.Uuid
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, dealId, evaluationId, createdAt], map: "negotiation_briefs_org_deal_idx")
  @@map("negotiation_briefs")
}

/// The seller's answer to one proposed term (batch 1 after T-105): ACCEPT, REJECT or
/// COUNTER with an amount. Append-only; the newest response per term counts.
model TermResponse {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  batchId        String   @map("batch_id") @db.Uuid
  ordinal        Int
  /// ACCEPT | REJECT | COUNTER
  decision       String
  counterAmount  Decimal? @map("counter_amount") @db.Decimal(20, 2)
  note           String   @default("")
  respondedBy    String   @map("responded_by") @db.Uuid
  respondedAt    DateTime @default(now()) @map("responded_at") @db.Timestamptz(3)

  batch TermProposalBatch @relation(fields: [organizationId, dealId, batchId], references: [organizationId, dealId, id], onDelete: Restrict, map: "term_responses_batch_fkey")

  @@index([batchId, ordinal, respondedAt], map: "term_responses_batch_idx")
  @@map("term_responses")
}

/// A Foresight metric the deal team defined themselves; its forecasts live in
/// foresight_forecasts under `metric_key`. Buyer-side.
model ForesightCustomMetric {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  dealId         String    @map("deal_id") @db.Uuid
  metricKey      String    @map("metric_key")
  label          String
  definition     String
  neutral        Decimal   @db.Decimal(9, 4)
  /// GROWTH | RISK | TRACK
  effect         String
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)

  @@unique([organizationId, dealId, metricKey], map: "foresight_custom_metrics_key_key")
  @@map("foresight_custom_metrics")
}

/// Who signs for each side of a pact (T-107). Append-only; the latest per side counts.
model PactSignatory {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  /// BUYER | SELLER
  side           String
  userId         String   @map("user_id") @db.Uuid
  namedBy        String   @map("named_by") @db.Uuid
  namedAt        DateTime @default(now()) @map("named_at") @db.Timestamptz(3)

  @@index([organizationId, dealId, side, namedAt], map: "pact_signatories_deal_idx")
  @@map("pact_signatories")
}

/// A side's sign-off on an agreed version (T-107): in the app, or by e-signature. Insert-only.
model TermSignoff {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  batchId        String   @map("batch_id") @db.Uuid
  side           String
  userId         String   @map("user_id") @db.Uuid
  /// IN_APP | ESIGN
  method         String
  envelopeId     String?  @map("envelope_id") @db.Uuid
  signedAt       DateTime @default(now()) @map("signed_at") @db.Timestamptz(3)

  batch TermProposalBatch @relation(fields: [organizationId, dealId, batchId], references: [organizationId, dealId, id], onDelete: Restrict, map: "term_signoffs_batch_fkey")

  @@unique([batchId, side], map: "term_signoffs_batch_side_key")
  @@map("term_signoffs")
}

/// The closing checklist (T-107). FUNDS items: the buyer records the payment, the seller confirms it.
model ClosingItem {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  dealId          String    @map("deal_id") @db.Uuid
  /// CONDITION | FUNDS
  kind            String    @default("CONDITION")
  title           String
  /// BUYER | SELLER: who ticks it (funds: the seller, who receives them)
  ownerSide       String    @map("owner_side")
  amount          Decimal?  @db.Decimal(20, 2)
  currency        String?   @db.Char(3)
  paidAt          DateTime? @map("paid_at") @db.Timestamptz(3)
  paidBy          String?   @map("paid_by") @db.Uuid
  paidOn          DateTime? @map("paid_on") @db.Date
  paidReference   String?   @map("paid_reference")
  proofDocumentId String?   @map("proof_document_id") @db.Uuid
  disputedAt      DateTime? @map("disputed_at") @db.Timestamptz(3)
  disputeNote     String?   @map("dispute_note")
  doneAt          DateTime? @map("done_at") @db.Timestamptz(3)
  doneBy          String?   @map("done_by") @db.Uuid
  createdBy       String    @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, dealId, createdAt], map: "closing_items_deal_idx")
  @@map("closing_items")
}

/// An e-signature envelope for an agreed version (T-107); its outcome arrives by webhook.
model SignatureEnvelope {
  id                  String    @id @default(uuid(7)) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  dealId              String    @map("deal_id") @db.Uuid
  batchId             String    @map("batch_id") @db.Uuid
  /// FIXTURE | DOCUSIGN | BOLDSIGN: the provider it was sent with, which it finishes on.
  provider            String
  providerEnvelopeId  String    @map("provider_envelope_id")
  /// SENT | DELIVERED | COMPLETED | DECLINED | EXPIRED | VOIDED
  status              String    @default("SENT")
  termSheetSha256     String    @map("term_sheet_sha256") @db.Char(64)
  agreementDocumentId String?   @map("agreement_document_id") @db.Uuid
  buyerSignatory      String    @map("buyer_signatory") @db.Uuid
  sellerSignatory     String    @map("seller_signatory") @db.Uuid
  sentBy              String    @map("sent_by") @db.Uuid
  sentAt              DateTime  @default(now()) @map("sent_at") @db.Timestamptz(3)
  completedAt         DateTime? @map("completed_at") @db.Timestamptz(3)
  /// Set when the envelope carries a letter of intent rather than the terms (T-119).
  loiId               String?   @map("loi_id") @db.Uuid
  /// The provider's reason for a decline, expiry or void, where it gives one (T-136).
  statusReason        String?   @map("status_reason")
  statusChangedAt     DateTime? @map("status_changed_at") @db.Timestamptz(3)
  /// When the polling fallback last asked the provider.
  checkedAt           DateTime? @map("checked_at") @db.Timestamptz(3)

  batch     TermProposalBatch      @relation(fields: [organizationId, dealId, batchId], references: [organizationId, dealId, id], onDelete: Restrict, map: "signature_envelopes_batch_fkey")
  events    SigningEnvelopeEvent[]
  artifacts SigningArtifact[]

  @@unique([provider, providerEnvelopeId], map: "signature_envelopes_provider_key")
  @@index([batchId, sentAt], map: "signature_envelopes_batch_idx")
  @@map("signature_envelopes")
}

/// An envelope's timeline (T-136): one row per provider observation; the webhook deduplication key.
model SigningEnvelopeEvent {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  dealId          String   @map("deal_id") @db.Uuid
  envelopeId      String   @map("envelope_id") @db.Uuid
  /// SENT | DELIVERED | COMPLETED | DECLINED | EXPIRED | VOIDED
  status          String
  reason          String?
  /// APP | WEBHOOK | POLL
  source          String
  providerEventId String   @map("provider_event_id")
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  envelope SignatureEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Restrict, map: "signing_envelope_events_envelope_fkey")

  @@unique([envelopeId, providerEventId], map: "signing_envelope_events_dedup_key")
  @@map("signing_envelope_events")
}

/// A completed envelope's signed PDF or certificate of completion, stored byte-for-byte (T-136).
model SigningArtifact {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  envelopeId     String   @map("envelope_id") @db.Uuid
  /// SIGNED_DOCUMENT | CERTIFICATE
  kind           String
  objectKey      String   @map("object_key")
  sha256         String   @db.Char(64)
  sizeBytes      Int      @map("size_bytes")
  storedAt       DateTime @default(now()) @map("stored_at") @db.Timestamptz(3)

  envelope SignatureEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Restrict, map: "signing_artifacts_envelope_fkey")

  @@unique([envelopeId, kind], map: "signing_artifacts_kind_key")
  @@map("signing_artifacts")
}

/// An organization's own provider account (T-107: DocuSign). The token lives in the secret store.
model OrganizationConnection {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  provider       String
  credentialRef  String    @map("credential_ref")
  accountId      String    @map("account_id")
  accountName    String    @map("account_name")
  baseUri        String    @map("base_uri")
  connectedBy    String    @map("connected_by") @db.Uuid
  connectedAt    DateTime  @default(now()) @map("connected_at") @db.Timestamptz(3)
  disconnectedAt DateTime? @map("disconnected_at") @db.Timestamptz(3)

  @@map("organization_connections")
}

/// An MCP client registered by Dynamic Client Registration (T-084, RFC 7591). Clients that use
/// Client ID Metadata Documents are never stored. Reached only through pactlab_auth functions.
model OAuthClient {
  clientId     String   @id @map("client_id")
  clientName   String   @map("client_name")
  redirectUris String[] @map("redirect_uris")
  ipHash       String   @map("ip_hash") @db.Char(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ipHash, createdAt])
  @@map("oauth_clients")
}

/// What a person allowed an MCP client to do in one organization (T-084).
model OAuthGrant {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  clientId       String    @map("client_id")
  clientName     String    @map("client_name")
  scopes         String[]
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)

  user          User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  codes         OAuthCode[]
  refreshTokens OAuthRefreshToken[]
  deviceCodes   OAuthDeviceCode[]

  @@index([userId])
  @@map("oauth_grants")
}

/// Device authorization (RFC 8628, T-128): a script's pending sign-in, approved by the person
/// in the app. Ten minutes; the device code is stored only as a hash.
model OAuthDeviceCode {
  id             String    @id @default(uuid(7)) @db.Uuid
  deviceCodeHash String    @unique(map: "oauth_device_codes_hash_key") @map("device_code_hash") @db.Char(64)
  userCode       String    @map("user_code")
  clientId       String    @map("client_id")
  clientName     String    @map("client_name")
  scopes         String[]
  resource       String
  status         String    @default("PENDING")
  grantId        String?   @map("grant_id") @db.Uuid
  ipHash         String    @map("ip_hash") @db.Char(64)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  lastPolledAt   DateTime? @map("last_polled_at") @db.Timestamptz(3)

  grant OAuthGrant? @relation(fields: [grantId], references: [id], onDelete: Restrict)

  @@index([userCode], map: "oauth_device_codes_user_code_idx")
  @@index([ipHash, createdAt], map: "oauth_device_codes_ip_idx")
  @@map("oauth_device_codes")
}

/// A single-use, 60-second authorization code, stored hashed (T-084).
model OAuthCode {
  id            String    @id @default(uuid(7)) @db.Uuid
  grantId       String    @map("grant_id") @db.Uuid
  codeHash      String    @unique @map("code_hash") @db.Char(64)
  codeChallenge String    @map("code_challenge")
  redirectUri   String    @map("redirect_uri")
  resource      String
  scopes        String[]
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(3)

  grant OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Restrict)

  @@map("oauth_codes")
}

/// A rotating 30-day refresh token, stored hashed (T-084). Reuse revokes the grant.
model OAuthRefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  grantId   String    @map("grant_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  scopes    String[]
  resource  String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)

  grant OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Restrict)

  @@map("oauth_refresh_tokens")
}

/// The price book (T-087, ADR 0025): data, not code. Reached only through pactlab_billing functions.
model BillingPlan {
  key           String   @id
  kind          String
  interval      String?
  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @db.Char(3)
  pactsIncluded Int?     @map("pacts_included")
  overageAmount Decimal? @map("overage_amount") @db.Decimal(12, 2)
  grants        String
  selfServe     Boolean  @map("self_serve")
  stripePriceId String?  @map("stripe_price_id")
  display       Json
  active        Boolean  @default(true)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("billing_plans")
}

/// An organization's mirror of its Stripe customer and subscription (T-087).
model BillingAccount {
  organizationId   String    @id @map("organization_id") @db.Uuid
  stripeCustomerId String?   @unique(map: "billing_accounts_customer_key") @map("stripe_customer_id")
  planKey          String?   @map("plan_key")
  subscriptionId   String?   @unique(map: "billing_accounts_subscription_key") @map("subscription_id")
  status           String    @default("NONE")
  periodStart      DateTime? @map("period_start") @db.Timestamptz(3)
  periodEnd        DateTime? @map("period_end") @db.Timestamptz(3)
  pactsUsed        Int       @default(0) @map("pacts_used")
  pendingPromoId   String?   @map("pending_promo_id") @db.Uuid
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("billing_accounts")
}

/// A pact credit: bought, comped or from a promo code; optionally only for some packs (T-087).
model PactCredit {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  kind           String
  source         String
  stripeEventId  String?   @unique(map: "pact_credits_stripe_event_key") @map("stripe_event_id")
  promoId        String?   @map("promo_id") @db.Uuid
  compedBy       String?   @map("comped_by") @db.Uuid
  packs          String[]  @default([])
  grantedAt      DateTime  @default(now()) @map("granted_at") @db.Timestamptz(3)
  consumedDealId String?   @map("consumed_deal_id") @db.Uuid
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(3)

  @@map("pact_credits")
}

/// Stripe events handled, once each (T-087).
model StripeEvent {
  eventId    String   @id @map("event_id")
  type       String
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@map("stripe_events")
}

/// An admin-made promo code: a discount or free pacts (T-087).
model PromoCode {
  id                    String    @id @default(uuid(7)) @db.Uuid
  code                  String    @unique(map: "promo_codes_code_key")
  description           String
  kind                  String
  percentOff            Decimal?  @map("percent_off") @db.Decimal(5, 2)
  amountOff             Decimal?  @map("amount_off") @db.Decimal(12, 2)
  currency              String?   @db.Char(3)
  duration              String?
  durationMonths        Int?      @map("duration_months")
  planKeys              String[]  @default([]) @map("plan_keys")
  freePacts             Int?      @map("free_pacts")
  packs                 String[]  @default([])
  validFrom             DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validUntil            DateTime? @map("valid_until") @db.Timestamptz(3)
  maxRedemptions        Int?      @map("max_redemptions")
  skipsApproval         Boolean   @default(true) @map("skips_approval")
  active                Boolean   @default(true)
  stripePromotionCodeId String?   @map("stripe_promotion_code_id")
  createdBy             String    @map("created_by") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("promo_codes")
}

model PromoRedemption {
  id             String   @id @default(uuid(7)) @db.Uuid
  promoId        String   @map("promo_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  redeemedAt     DateTime @default(now()) @map("redeemed_at") @db.Timestamptz(3)

  @@unique([promoId, organizationId], map: "promo_redemptions_once_key")
  @@map("promo_redemptions")
}

model PromoAttempt {
  id        String   @id @default(uuid(7)) @db.Uuid
  ipHash    String   @map("ip_hash") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ipHash, createdAt])
  @@map("promo_attempts")
}

/// A per-deal price book version for one market (T-177a, ADR 0061): frozen at publish. Reached only through pactlab_billing functions.
model PriceBookVersion {
  id               String    @id @default(uuid(7)) @db.Uuid
  currency         String    @db.Char(3)
  version          Int
  status           String    @default("DRAFT")
  effectiveFrom    DateTime? @map("effective_from") @db.Timestamptz(3)
  fixedFee         Decimal   @map("fixed_fee") @db.Decimal(21, 6)
  variableCap      Decimal   @map("variable_cap") @db.Decimal(21, 6)
  pilotFlat        Decimal   @map("pilot_flat") @db.Decimal(21, 6)
  rounding         Decimal   @db.Decimal(21, 6)
  baseDocuments    Int       @map("base_documents")
  baseAiBudget     Decimal   @map("base_ai_budget") @db.Decimal(21, 6)
  basedOnVersionId String?   @map("based_on_version_id") @db.Uuid
  suggestedFrom    Json?     @map("suggested_from")
  createdBy        String?   @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedBy      String?   @map("published_by") @db.Uuid
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(3)
  firstQuotedAt    DateTime? @map("first_quoted_at") @db.Timestamptz(3)

  basedOn PriceBookVersion?  @relation("PriceBookLineage", fields: [basedOnVersionId], references: [id], onDelete: Restrict, map: "price_book_versions_based_on_fkey")
  derived PriceBookVersion[] @relation("PriceBookLineage")
  bands   PriceBookBand[]
  quotes  PactQuote[]

  @@unique([currency, version], map: "price_book_versions_currency_version_key")
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "price_book_versions_history_idx")
  @@map("price_book_versions")
}

model PriceBookBand {
  versionId String   @map("version_id") @db.Uuid
  position  Int
  upTo      Decimal? @map("up_to") @db.Decimal(21, 6)
  bps       Decimal  @db.Decimal(5, 2)
  documents Int
  aiBudget  Decimal  @map("ai_budget") @db.Decimal(21, 6)

  version PriceBookVersion @relation(fields: [versionId], references: [id], onDelete: Cascade, map: "price_book_bands_version_fkey")

  @@id([versionId, position])
  @@map("price_book_bands")
}

/// A promo code that changes a pact's price (T-177a): one namespace with promo_codes.
model PricingPromo {
  id                 String    @id @default(uuid(7)) @db.Uuid
  code               String    @unique(map: "pricing_promos_code_key")
  description        String
  effect             String
  percent            Decimal?  @db.Decimal(5, 2)
  amount             Decimal?  @db.Decimal(21, 6)
  pilotFlat          Decimal?  @map("pilot_flat") @db.Decimal(21, 6)
  currency           String?   @db.Char(3)
  markets            String[]  @default([]) @db.Char(3)
  stackable          Boolean   @default(false)
  scope              String    @default("ANY")
  organizationIds    String[]  @default([]) @map("organization_ids") @db.Uuid
  validFrom          DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validUntil         DateTime? @map("valid_until") @db.Timestamptz(3)
  maxRedemptions     Int?      @map("max_redemptions")
  maxPerOrganization Int       @default(1) @map("max_per_organization")
  status             String    @default("ACTIVE")
  createdBy          String    @map("created_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  changes     PricingPromoChange[]
  quotes      PactQuote[]
  redemptions PricingPromoRedemption[]

  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "pricing_promos_history_idx")
  @@map("pricing_promos")
}

model PricingPromoChange {
  id          String   @id @default(uuid(7)) @db.Uuid
  promoId     String   @map("promo_id") @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  changedAt   DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)
  before      Json
  after       Json

  promo PricingPromo @relation(fields: [promoId], references: [id], onDelete: Restrict, map: "pricing_promo_changes_promo_fkey")

  @@index([promoId, changedAt], map: "pricing_promo_changes_promo_idx")
  @@map("pricing_promo_changes")
}

/// A stored pact quote (T-177a): its inputs, its book version and its lines, so it re-shows exactly.
model PactQuote {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  dealId          String?   @map("deal_id") @db.Uuid
  currency        String    @db.Char(3)
  bookVersionId   String    @map("book_version_id") @db.Uuid
  enterpriseValue Decimal?  @map("enterprise_value") @db.Decimal(21, 6)
  pilot           Boolean
  promoCode       String?   @map("promo_code")
  promoId         String?   @map("promo_id") @db.Uuid
  promoRefusal    String?   @map("promo_refusal")
  partnerCode     String?   @map("partner_code")
  resellerPercent Decimal?  @map("reseller_percent") @db.Decimal(5, 2)
  subtotal        Decimal   @db.Decimal(21, 6)
  total           Decimal   @db.Decimal(21, 6)
  applied         String
  includes        Json
  engineVersion   String    @map("engine_version")
  createdBy       String    @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  status          String    @default("OPEN")
  consumedAt      DateTime? @map("consumed_at") @db.Timestamptz(3)

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "pact_quotes_organization_fkey")
  bookVersion  PriceBookVersion        @relation(fields: [bookVersionId], references: [id], onDelete: Restrict, map: "pact_quotes_version_fkey")
  promo        PricingPromo?           @relation(fields: [promoId], references: [id], onDelete: Restrict, map: "pact_quotes_promo_fkey")
  lines        PactQuoteLine[]
  redemption   PricingPromoRedemption?

  @@index([organizationId, createdAt(sort: Desc)], map: "pact_quotes_organization_idx")
  @@map("pact_quotes")
}

model PactQuoteLine {
  quoteId  String   @map("quote_id") @db.Uuid
  position Int
  kind     String
  from     Decimal? @db.Decimal(21, 6)
  upTo     Decimal? @map("up_to") @db.Decimal(21, 6)
  bps      Decimal? @db.Decimal(5, 2)
  slice    Decimal? @db.Decimal(21, 6)
  percent  Decimal? @db.Decimal(5, 2)
  amount   Decimal  @db.Decimal(21, 6)
  applied  Boolean  @default(true)

  quote PactQuote @relation(fields: [quoteId], references: [id], onDelete: Restrict, map: "pact_quote_lines_quote_fkey")

  @@id([quoteId, position])
  @@map("pact_quote_lines")
}

/// A promo use, counted when its quote is bought (T-177a, Kumar's decision 6).
model PricingPromoRedemption {
  id             String    @id @default(uuid(7)) @db.Uuid
  promoId        String    @map("promo_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  quoteId        String    @unique(map: "pricing_promo_redemptions_quote_key") @map("quote_id") @db.Uuid
  dealId         String    @map("deal_id") @db.Uuid
  currency       String    @db.Char(3)
  amountForgone  Decimal   @map("amount_forgone") @db.Decimal(21, 6)
  redeemedAt     DateTime  @default(now()) @map("redeemed_at") @db.Timestamptz(3)
  voidedAt       DateTime? @map("voided_at") @db.Timestamptz(3)

  promo        PricingPromo @relation(fields: [promoId], references: [id], onDelete: Restrict, map: "pricing_promo_redemptions_promo_fkey")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "pricing_promo_redemptions_organization_fkey")
  quote        PactQuote    @relation(fields: [quoteId], references: [id], onDelete: Restrict, map: "pricing_promo_redemptions_quote_fkey")

  @@index([promoId, redeemedAt(sort: Desc), id(sort: Desc)], map: "pricing_promo_redemptions_promo_idx")
  @@map("pricing_promo_redemptions")
}

/// A report version (T-110): an immutable PDF snapshot, executive (whole organization) or one pact.
model ReportVersion {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  scope          String
  dealId         String?  @map("deal_id") @db.Uuid
  version        Int
  status         String   @default("GENERATING")
  generatedBy    String   @map("generated_by") @db.Uuid
  generatedAt    DateTime @default(now()) @map("generated_at") @db.Timestamptz(3)
  dataAsOf       DateTime @map("data_as_of") @db.Timestamptz(3)
  captured       Json     @default("{}")
  objectKey      String?  @map("object_key")
  sha256         String?  @db.Char(64)
  byteSize       Int?     @map("byte_size")
  /// Made by the pact's own side (set by the database on insert): only then does the rest of that side see it.
  ownSide        Boolean  @default(false) @map("own_side")
  /// Numbering series (set by the database): the own side shares one; anyone else numbers their own.
  series         String   @default("00000000-0000-0000-0000-000000000000") @db.Uuid

  @@index([organizationId, scope, dealId, version(sort: Desc)], map: "report_versions_history_idx")
  @@map("report_versions")
}

/// A demo organization lent out through magic links (T-113). Reached only through SECURITY DEFINER functions.
model DemoSlot {
  organizationId String    @id @map("organization_id") @db.Uuid
  slot           Int       @unique
  buyerUserId    String    @map("buyer_user_id") @db.Uuid
  sellerUserId   String    @map("seller_user_id") @db.Uuid
  /// AVAILABLE | SHARED | RESETTING
  status         String    @default("RESETTING")
  resetAt        DateTime? @map("reset_at") @db.Timestamptz(3)
  lastError      String?   @map("last_error")
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("demo_slots")
}

/// One loan of a demo slot: who it is for, until when, and its two links as keyed hashes (T-113).
model DemoShare {
  id               String    @id @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  sharedWith       String    @map("shared_with")
  createdBy        String?   @map("created_by") @db.Uuid
  startsAt         DateTime  @default(now()) @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime  @map("ends_at") @db.Timestamptz(3)
  endedAt          DateTime? @map("ended_at") @db.Timestamptz(3)
  endedBy          String?   @map("ended_by") @db.Uuid
  buyerTokenHash   String    @unique @map("buyer_token_hash") @db.Char(64)
  sellerTokenHash  String    @unique @map("seller_token_hash") @db.Char(64)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(3)
  /// The links sealed with the API's key, so an operator can open them again; null for older shares.
  buyerLinkSealed  String?   @map("buyer_link_sealed")
  sellerLinkSealed String?   @map("seller_link_sealed")

  @@map("demo_shares")
}

/// An IC pack put to the committee (T-118): the report version it was, who submitted it, when.
model IcSubmission {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  dealId          String   @map("deal_id") @db.Uuid
  reportVersionId String   @unique @map("report_version_id") @db.Uuid
  submittedBy     String   @map("submitted_by") @db.Uuid
  submittedAt     DateTime @default(now()) @map("submitted_at") @db.Timestamptz(3)

  @@index([organizationId, dealId, submittedAt(sort: Desc)], map: "ic_submissions_deal_idx")
  @@map("ic_submissions")
}

/// The committee's one decision on a submission (T-118): APPROVE | APPROVE_WITH_CONDITIONS | DECLINE.
model IcDecision {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  submissionId   String   @unique @map("submission_id") @db.Uuid
  decision       String
  note           String
  decidedBy      String   @map("decided_by") @db.Uuid
  decidedAt      DateTime @default(now()) @map("decided_at") @db.Timestamptz(3)

  @@map("ic_decisions")
}

/// A condition on an approval (T-118): OPEN → ADDRESSED (deal team) → CLEARED (IC, when the organization asks for it).
model IcCondition {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  dealId         String    @map("deal_id") @db.Uuid
  decisionId     String    @map("decision_id") @db.Uuid
  ordinal        Int
  text           String
  status         String    @default("OPEN")
  addressedBy    String?   @map("addressed_by") @db.Uuid
  addressedAt    DateTime? @map("addressed_at") @db.Timestamptz(3)
  addressedNote  String?   @map("addressed_note")
  clearedBy      String?   @map("cleared_by") @db.Uuid
  clearedAt      DateTime? @map("cleared_at") @db.Timestamptz(3)

  @@unique([decisionId, ordinal], map: "ic_conditions_ordinal_key")
  @@map("ic_conditions")
}

/// A letter of intent (T-119): generated from an agreed terms version; DRAFT stays with the pact's own side.
model LoiVersion {
  id                String    @id @default(uuid(7)) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  dealId            String    @map("deal_id") @db.Uuid
  batchId           String    @map("batch_id") @db.Uuid
  version           Int
  /// DRAFT | SENT | COUNTERSIGNED | DECLINED | EXPIRED
  status            String    @default("DRAFT")
  fields            Json
  snapshot          Json?
  /// IN_APP | ESIGN
  method            String?
  objectKey         String?   @map("object_key")
  sha256            String?   @db.Char(64)
  createdBy         String    @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  sentBy            String?   @map("sent_by") @db.Uuid
  sentAt            DateTime? @map("sent_at") @db.Timestamptz(3)
  respondBy         DateTime? @map("respond_by") @db.Timestamptz(3)
  countersignedAt   DateTime? @map("countersigned_at") @db.Timestamptz(3)
  declinedAt        DateTime? @map("declined_at") @db.Timestamptz(3)
  declinedBy        String?   @map("declined_by") @db.Uuid
  exclusivityEndsAt DateTime? @map("exclusivity_ends_at") @db.Timestamptz(3)

  signoffs LoiSignoff[]

  @@unique([dealId, version], map: "loi_versions_version_key")
  @@map("loi_versions")
}

/// A side's signature on a letter of intent (T-119), in the app or by e-signature. Insert-only.
model LoiSignoff {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  loiId          String   @map("loi_id") @db.Uuid
  /// BUYER | SELLER
  side           String
  userId         String   @map("user_id") @db.Uuid
  method         String
  envelopeId     String?  @map("envelope_id") @db.Uuid
  signedAt       DateTime @default(now()) @map("signed_at") @db.Timestamptz(3)

  loi LoiVersion @relation(fields: [loiId], references: [id], onDelete: Restrict, map: "loi_signoffs_loi_fkey")

  @@unique([loiId, side], map: "loi_signoffs_side_key")
  @@map("loi_signoffs")
}

/// An organization's brand kit (T-123): logo, colors and font for the app, its documents and emails.
model OrganizationBrandKit {
  organizationId  String    @id @map("organization_id") @db.Uuid
  /// DEFAULT | EXTRACTED | EDITED — an edit is never overwritten by extraction.
  source          String    @default("DEFAULT")
  logoObjectKey   String?   @map("logo_object_key")
  logoContentType String?   @map("logo_content_type")
  logoWidth       Int?      @map("logo_width")
  logoHeight      Int?      @map("logo_height")
  /// Drawn for a dark background (an all-white SVG): shown on a dark chip.
  logoLight       Boolean   @default(false) @map("logo_light")
  primaryColor    String?   @map("primary_color")
  accentColor     String?   @map("accent_color")
  font            String    @default("MANROPE")
  /// The latest extraction, waiting for an admin to apply it.
  draft           Json?
  extraction      Json?
  extractedAt     DateTime? @map("extracted_at") @db.Timestamptz(3)
  updatedBy       String?   @map("updated_by") @db.Uuid
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("organization_brand_kits")
}

/// Which feature cards a person has dismissed and read (T-155): per user, by card version.
/// The cards live in code (the API's registry); a new version comes back on its own.
model UserFeatureCard {
  userId           String   @map("user_id") @db.Uuid
  cardId           String   @map("card_id")
  dismissedVersion Int      @default(0) @map("dismissed_version")
  readVersion      Int      @default(0) @map("read_version")
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@id([userId, cardId])
  @@map("user_feature_cards")
}

/// A buyer's financing plan on a pact (T-117, ADR 0033): the own side of a buyer-led pact (no bid),
/// or one bidder on a seller-led one. Buyer-attested; the seller sees structure, status and coverage.
model FinancingPlan {
  id                   String    @id @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  dealId               String    @map("deal_id") @db.Uuid
  bidId                String?   @map("bid_id") @db.Uuid
  commitmentExpectedBy DateTime? @map("commitment_expected_by") @db.Date
  /// Buyer-only.
  buyerNote            String    @default("") @map("buyer_note")
  createdBy            String    @map("created_by") @db.Uuid
  updatedBy            String    @map("updated_by") @db.Uuid
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  tranches  FinancingTranche[]
  escrow    FinancingEscrow?
  documents FinancingDocument[]

  @@unique([organizationId, dealId, id], map: "financing_plans_org_deal_id_key")
  @@map("financing_plans")
}

model FinancingTranche {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  planId         String   @map("plan_id") @db.Uuid
  ordinal        Int
  /// CASH | SBA_7A | CONVENTIONAL_DEBT | SELLER_NOTE | ROLLOVER_EQUITY | OTHER
  kind           String
  amount         Decimal  @db.Decimal(20, 2)
  currency       String   @db.Char(3)
  /// NOT_STARTED | EXPLORING | PRE_QUALIFIED | APPLICATION_SUBMITTED | COMMITMENT_ISSUED | CLEARED_TO_CLOSE
  status         String   @default("NOT_STARTED")
  label          String   @default("")
  /// Buyer-only (e.g. the lender's name).
  buyerNote      String   @default("") @map("buyer_note")
  updatedBy      String   @map("updated_by") @db.Uuid
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  plan      FinancingPlan       @relation(fields: [organizationId, dealId, planId], references: [organizationId, dealId, id], onDelete: Cascade, map: "financing_tranches_plan_fkey")
  documents FinancingDocument[]

  @@unique([planId, ordinal], map: "financing_tranches_ordinal_key")
  @@map("financing_tranches")
}

/// Earnest money in escrow with a third party (T-117); recorded by the buyer, confirmed by the seller.
model FinancingEscrow {
  planId            String    @id @map("plan_id") @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  dealId            String    @map("deal_id") @db.Uuid
  amount            Decimal   @db.Decimal(20, 2)
  currency          String    @db.Char(3)
  /// TITLE_COMPANY | ATTORNEY | BROKER | OTHER
  holderKind        String    @map("holder_kind")
  holderName        String    @map("holder_name")
  depositDueOn      DateTime? @map("deposit_due_on") @db.Date
  hardOn            DateTime? @map("hard_on") @db.Date
  refundConditions  String    @default("") @map("refund_conditions")
  /// NOT_COMMITTED | COMMITTED | DEPOSITED | APPLIED_AT_CLOSE | RELEASED_TO_SELLER | REFUNDED_TO_BUYER
  status            String    @default("COMMITTED")
  depositedOn       DateTime? @map("deposited_on") @db.Date
  depositReference  String?   @map("deposit_reference")
  proofDocumentId   String?   @map("proof_document_id") @db.Uuid
  depositRecordedBy String?   @map("deposit_recorded_by") @db.Uuid
  depositRecordedAt DateTime? @map("deposit_recorded_at") @db.Timestamptz(3)
  confirmedBy       String?   @map("confirmed_by") @db.Uuid
  confirmedAt       DateTime? @map("confirmed_at") @db.Timestamptz(3)
  disputedAt        DateTime? @map("disputed_at") @db.Timestamptz(3)
  disputeNote       String?   @map("dispute_note")
  dispositionBy     String?   @map("disposition_by") @db.Uuid
  dispositionAt     DateTime? @map("disposition_at") @db.Timestamptz(3)
  updatedBy         String    @map("updated_by") @db.Uuid
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  plan  FinancingPlan      @relation(fields: [organizationId, dealId, planId], references: [organizationId, dealId, id], onDelete: Cascade, map: "financing_escrows_plan_fkey")
  proof FinancingDocument? @relation("EscrowProof", fields: [proofDocumentId], references: [id], onDelete: SetNull, map: "financing_escrows_proof_fkey")

  @@unique([organizationId, dealId, planId], map: "financing_escrows_org_deal_plan_key")
  @@map("financing_escrows")
}

/// A financing document (T-117): buyer-only until shared, one by one, revocable.
model FinancingDocument {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  dealId         String    @map("deal_id") @db.Uuid
  planId         String    @map("plan_id") @db.Uuid
  trancheId      String?   @map("tranche_id") @db.Uuid
  /// PROOF_OF_FUNDS | PRE_QUALIFICATION | COMMITMENT_LETTER | SBA_PRE_QUALIFICATION | ESCROW_RECEIPT | BUYER_FINANCIALS | OTHER
  purpose        String
  fileName       String    @map("file_name")
  contentType    String    @map("content_type")
  byteSize       Int       @map("byte_size")
  sha256         String    @db.Char(64)
  objectKey      String    @map("object_key")
  uploadedBy     String    @map("uploaded_by") @db.Uuid
  uploadedAt     DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  sharedAt       DateTime? @map("shared_at") @db.Timestamptz(3)
  sharedBy       String?   @map("shared_by") @db.Uuid

  plan        FinancingPlan     @relation(fields: [organizationId, dealId, planId], references: [organizationId, dealId, id], onDelete: Cascade, map: "financing_documents_plan_fkey")
  tranche     FinancingTranche? @relation(fields: [trancheId], references: [id], onDelete: SetNull, map: "financing_documents_tranche_fkey")
  escrowProof FinancingEscrow[] @relation("EscrowProof")

  @@index([planId, uploadedAt], map: "financing_documents_plan_idx")
  @@map("financing_documents")
}

/// One SES delivery event for one recipient (T-109): the address only as a keyed hash and its domain.
model EmailEvent {
  id              String   @id @db.Uuid
  /// BOUNCE | COMPLAINT | DELIVERY | REJECT | RENDERING_FAILURE
  eventType       String   @map("event_type")
  recipientHash   String   @map("recipient_hash") @db.Char(64)
  recipientDomain String   @map("recipient_domain")
  sesMessageId    String   @map("ses_message_id")
  snsMessageId    String   @map("sns_message_id")
  bounceType      String?  @map("bounce_type")
  bounceSubtype   String?  @map("bounce_subtype")
  diagnostic      String?
  occurredAt      DateTime @map("occurred_at") @db.Timestamptz(3)
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@unique([snsMessageId, recipientHash], map: "email_events_once_idx")
  @@index([receivedAt], map: "email_events_received_idx")
  @@map("email_events")
}

/// The in-app do-not-send list (T-109): a hard bounce or a complaint, by keyed hash of the address.
model EmailSuppression {
  recipientHash String   @id @map("recipient_hash") @db.Char(64)
  /// HARD_BOUNCE | COMPLAINT
  reason        String
  firstAt       DateTime @default(now()) @map("first_at") @db.Timestamptz(3)
  lastAt        DateTime @default(now()) @map("last_at") @db.Timestamptz(3)
  events        Int      @default(1)

  @@map("email_suppressions")
}

/// Which demo build a demo organization was made from (T-124); the sweep rebuilds stale ones.
model DemoBuild {
  organizationId String   @id @map("organization_id") @db.Uuid
  version        String
  builtAt        DateTime @default(now()) @map("built_at") @db.Timestamptz(3)

  @@map("demo_builds")
}

/// AWS spend as Cost Explorer reports it (payer account): per period, environment tag and AWS product. Operator-only.
model HostingCostLine {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// MONTHLY | DAILY
  granularity String
  periodStart DateTime @map("period_start") @db.Date
  environment String
  service     String
  amount      Decimal  @db.Decimal(18, 6)
  currency    String   @db.Char(3)
  estimated   Boolean  @default(false)
  fetchedAt   DateTime @default(now()) @map("fetched_at") @db.Timestamptz(3)

  @@unique([granularity, periodStart, environment, service], map: "hosting_cost_lines_key")
  @@map("hosting_cost_lines")
}

/// Each refresh from Cost Explorer (error class only). Operator-only.
model HostingCostSync {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  requestedBy String?  @map("requested_by") @db.Uuid
  startedAt   DateTime @default(now()) @map("started_at") @db.Timestamptz(3)
  /// SUCCEEDED | FAILED
  status      String
  lines       Int      @default(0)
  errorClass  String?  @map("error_class")

  @@index([startedAt], map: "hosting_cost_syncs_started_idx")
  @@map("hosting_cost_syncs")
}

/// Unit prices an operator enters from AWS's price pages, each from a date. Operator-only.
model CostRate {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// BEDROCK_INPUT_PER_MTOK | BEDROCK_OUTPUT_PER_MTOK | S3_STORAGE_GB_MONTH
  kind          String
  key           String
  unitPrice     Decimal  @map("unit_price") @db.Decimal(18, 8)
  currency      String   @default("USD") @db.Char(3)
  effectiveFrom DateTime @map("effective_from") @db.Date
  sourceNote    String   @default("") @map("source_note")
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([kind, key, effectiveFrom], map: "cost_rates_key")
  @@map("cost_rates")
}

/// AI models managed in the admin console (T-131): only EVALUATED models serve.
model AiModel {
  id              String    @id @default(uuid(7)) @db.Uuid
  provider        String
  providerModelId String    @map("provider_model_id")
  label           String
  status          String    @default("ADDED")
  evaluation      Json?
  evaluatingSince DateTime? @map("evaluating_since") @db.Timestamptz(3)
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  platformRoutes     AiPlatformRoute[]
  organizationModels OrganizationAiModel[]
  organizationRoutes OrganizationAiRoute[]

  @@unique([provider, providerModelId], map: "ai_models_provider_model_key")
  @@map("ai_models")
}

/// The platform default model per alias (fast, balanced, deep_review).
model AiPlatformRoute {
  alias             String   @id
  modelId           String   @map("model_id") @db.Uuid
  updatedBy         String?  @map("updated_by") @db.Uuid
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  /// Set by the deployment (adoption or sync), so a deploy's configured model may switch it; false once an operator sets it.
  followsDeployment Boolean  @default(false) @map("follows_deployment")

  model AiModel @relation(fields: [modelId], references: [id], onDelete: Restrict, map: "ai_platform_routes_model_fkey")

  @@map("ai_platform_routes")
}

/// An organization's allow-list of models (empty: the platform defaults).
model OrganizationAiModel {
  organizationId String   @map("organization_id") @db.Uuid
  modelId        String   @map("model_id") @db.Uuid
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "organization_ai_models_org_fkey")
  model        AiModel      @relation(fields: [modelId], references: [id], onDelete: Restrict, map: "organization_ai_models_model_fkey")

  @@id([organizationId, modelId])
  @@map("organization_ai_models")
}

/// An organization's own model per alias.
model OrganizationAiRoute {
  organizationId String   @map("organization_id") @db.Uuid
  alias          String
  modelId        String   @map("model_id") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "organization_ai_routes_org_fkey")
  model        AiModel      @relation(fields: [modelId], references: [id], onDelete: Restrict, map: "organization_ai_routes_model_fkey")

  @@id([organizationId, alias])
  @@map("organization_ai_routes")
}

/// Data terms of an AI provider outside AWS (T-131, ADR 0034): its models serve only when both are true.
model AiProviderTerms {
  provider      String   @id
  dpaInPlace    Boolean  @map("dpa_in_place")
  zeroRetention Boolean  @map("zero_retention")
  region        String?
  notes         String?
  recordedBy    String?  @map("recorded_by") @db.Uuid
  recordedAt    DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)

  @@map("ai_provider_terms")
}

/// Whether live can reach a public data source it depends on (T-137 follow-up), as last checked. Platform-level.
model ExternalSourceStatus {
  source       String    @id
  status       String?
  checkedAt    DateTime? @map("checked_at") @db.Timestamptz(6)
  claimedAt    DateTime? @map("claimed_at") @db.Timestamptz(6)
  lastOkAt     DateTime? @map("last_ok_at") @db.Timestamptz(6)
  failingSince DateTime? @map("failing_since") @db.Timestamptz(6)
  detail       String?

  @@map("external_source_status")
}

/// Multifamily syndication (T-106): the offering a sponsor raises equity on — the purchase, the
/// debt, the raise and the downside, base and upside paths the waterfall is recomputed on.
/// The sponsor's own side (RLS).
model SyndicationOffering {
  id                    String   @id @db.Uuid
  organizationId        String   @map("organization_id") @db.Uuid
  dealId                String   @map("deal_id") @db.Uuid
  currency              String   @db.Char(3)
  purchasePrice         Decimal  @map("purchase_price") @db.Decimal(24, 4)
  loanAmount            Decimal  @map("loan_amount") @db.Decimal(24, 4)
  /// Percent (6.5 = 6.5%), interest-only.
  interestRatePct       Decimal  @map("interest_rate_pct") @db.Decimal(9, 4)
  equityRaise           Decimal  @map("equity_raise") @db.Decimal(24, 4)
  holdYears             Int      @map("hold_years")
  sellingCostsPct       Decimal  @map("selling_costs_pct") @db.Decimal(9, 4)
  /// Year-1 NOI; null reads the T-12 NOI from the imported operating statement.
  noiYear1              Decimal? @map("noi_year1") @db.Decimal(24, 4)
  downsideNoiGrowthPct  Decimal  @map("downside_noi_growth_pct") @db.Decimal(9, 4)
  baseNoiGrowthPct      Decimal  @map("base_noi_growth_pct") @db.Decimal(9, 4)
  upsideNoiGrowthPct    Decimal  @map("upside_noi_growth_pct") @db.Decimal(9, 4)
  downsideExitCapPct    Decimal  @map("downside_exit_cap_pct") @db.Decimal(9, 4)
  baseExitCapPct        Decimal  @map("base_exit_cap_pct") @db.Decimal(9, 4)
  upsideExitCapPct      Decimal  @map("upside_exit_cap_pct") @db.Decimal(9, 4)
  /// RULE_506B | RULE_506C
  exemption             String
  version               Int      @default(1)
  updatedBy             String   @map("updated_by") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@unique([organizationId, dealId])
  @@map("syndication_offerings")
}

/// Multifamily syndication (T-106): one fee, distribution term or claim read from the PPM, the
/// operating agreement or the investor deck, with its exact quote and page. AI proposes; the
/// sponsor confirms, edits or rejects; only CONFIRMED items feed the waterfall and the checks.
model SyndicationOfferingItem {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  dealId         String    @map("deal_id") @db.Uuid
  documentId     String    @map("document_id") @db.Uuid
  /// PPM | OPERATING_AGREEMENT | DECK
  source         String
  /// OFFERING_ITEM_KINDS (@pactlab/domain)
  kind           String
  /// The fee's name (OTHER_FEE) or the prior deal (TRACK_RECORD).
  label          String?
  /// Percent as a number (8 = 8%), a multiple, or a promote tier's sponsor share.
  value          Decimal?  @db.Decimal(18, 6)
  /// Promote tiers: the investors' IRR hurdle in percent; null on the last tier.
  hurdle         Decimal?  @db.Decimal(18, 6)
  /// { documentId, pageNumber, quote, quoteHash, charStart, charEnd }
  citation       Json
  /// PROPOSED | CONFIRMED | REJECTED
  status         String    @default("PROPOSED")
  /// AI | PERSON
  origin         String
  aiRunId        String?   @map("ai_run_id") @db.Uuid
  decisionNote   String?   @map("decision_note")
  decidedBy      String?   @map("decided_by") @db.Uuid
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz(3)
  version        Int       @default(1)
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@unique([organizationId, dealId, id])
  @@index([organizationId, dealId, status, createdAt], map: "syndication_offering_items_org_deal_idx")
  @@map("syndication_offering_items")
}

/// Music rights (T-140): one register entry read from a royalty statement, split sheet, publishing
/// agreement, Copyright Office record or lien search, with its exact quote and page. AI proposes; a
/// person confirms (optionally correcting) or rejects; only CONFIRMED entries feed the catalog
/// math and checks. The buyer's own side (RLS).
model MusicRegisterItem {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  dealId         String    @map("deal_id") @db.Uuid
  documentId     String    @map("document_id") @db.Uuid
  /// MUSIC_ITEM_KINDS (@pactlab/domain)
  kind           String
  /// The work id or title as the document writes it; null for catalog-wide entries.
  workRef        String?   @map("work_ref")
  /// A writer reference (SPLIT), a grant type (GRANT), an income source (INCOME), a secured party (ENCUMBRANCE).
  detail         String?
  /// A share in percent (SPLIT) or an amount in the deal's base currency.
  value          Decimal?  @db.Decimal(24, 6)
  /// Executed on (GRANT) or the statement period end (INCOME).
  date           DateTime? @db.Date
  /// { documentId, pageNumber, quote, quoteHash, charStart, charEnd }
  citation       Json
  /// PROPOSED | CONFIRMED | REJECTED
  status         String    @default("PROPOSED")
  /// AI | PERSON
  origin         String
  aiRunId        String?   @map("ai_run_id") @db.Uuid
  decisionNote   String?   @map("decision_note")
  decidedBy      String?   @map("decided_by") @db.Uuid
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz(3)
  version        Int       @default(1)
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@unique([organizationId, dealId, id])
  @@index([organizationId, dealId, status, createdAt], map: "music_register_items_org_deal_idx")
  @@map("music_register_items")
}

/// Energy generation & rights (T-142): one entry read from a third-party reserve report or an
/// environmental report or permit — reserves by category, their discounted value, the decline the
/// report assumes, or a liability estimate — with its exact quote and page. AI proposes; a person
/// confirms (optionally correcting) or rejects; only CONFIRMED entries feed the models and checks.
/// The buyer's own side (RLS).
model EnergyRegisterItem {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  dealId         String    @map("deal_id") @db.Uuid
  documentId     String    @map("document_id") @db.Uuid
  /// ENERGY_ITEM_KINDS (@pactlab/domain)
  kind           String
  /// The plant or interest id or name as the document writes it; null for portfolio-wide entries.
  assetRef       String?   @map("asset_ref")
  /// A reserve category (RESERVES, RESERVE_VALUE) or an obligation (LIABILITY_ESTIMATE); null for a decline.
  detail         String?
  /// A volume in MBOE, an amount in the deal's base currency, or a percentage.
  value          Decimal   @db.Decimal(24, 6)
  /// { documentId, pageNumber, quote, quoteHash, charStart, charEnd }
  citation       Json
  /// PROPOSED | CONFIRMED | REJECTED
  status         String    @default("PROPOSED")
  /// AI | PERSON
  origin         String
  aiRunId        String?   @map("ai_run_id") @db.Uuid
  decisionNote   String?   @map("decision_note")
  decidedBy      String?   @map("decided_by") @db.Uuid
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz(3)
  version        Int       @default(1)
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@unique([organizationId, dealId, id])
  @@index([organizationId, dealId, status, createdAt], map: "energy_register_items_org_deal_idx")
  @@map("energy_register_items")
}

/// A startup equity SPV's vehicle (T-141, ADR 0044): its name and the organizer's stated exit paths. Own side only.
model SpvVehicle {
  organizationId   String   @map("organization_id") @db.Uuid
  dealId           String   @map("deal_id") @db.Uuid
  vehicleName      String   @map("vehicle_name")
  /// Exit equity value ÷ the round's post-money, as the organizer states it; null until stated.
  downsideMultiple Decimal? @map("downside_multiple") @db.Decimal(10, 4)
  baseMultiple     Decimal? @map("base_multiple") @db.Decimal(10, 4)
  upsideMultiple   Decimal? @map("upside_multiple") @db.Decimal(10, 4)
  updatedBy        String   @map("updated_by") @db.Uuid
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@id([organizationId, dealId])
  @@map("spv_vehicles")
}

/// An investor's seat in a pooled vehicle (T-141): commitment and tracked accreditation (Pactlab verifies nothing).
model PactInvestor {
  id                     String    @id @db.Uuid
  organizationId         String    @map("organization_id") @db.Uuid
  dealId                 String    @map("deal_id") @db.Uuid
  /// The investor's name as the organizer records it (a firm or a person); never sent to a model.
  label                  String
  /// Pseudonymous reference (e.g. INV-03) the checks and side letters use.
  reference              String
  commitment             Decimal?  @db.Decimal(24, 4)
  currency               String    @db.Char(3)
  /// ACTIVE | WITHDRAWN
  status                 String    @default("ACTIVE")
  /// ACCREDITATION_STATUSES (@pactlab/domain)
  accreditationStatus    String    @default("NOT_STARTED") @map("accreditation_status")
  accreditationProvider  String?   @map("accreditation_provider")
  accreditationUrl       String?   @map("accreditation_url")
  accreditationEvidence  String?   @map("accreditation_evidence")
  accreditationUpdatedAt DateTime? @map("accreditation_updated_at") @db.Timestamptz(3)
  accreditationUpdatedBy String?   @map("accreditation_updated_by") @db.Uuid
  createdBy              String    @map("created_by") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([organizationId, dealId, id], map: "pact_investors_org_deal_id_key")
  @@unique([organizationId, dealId, reference], map: "pact_investors_reference_key")
  @@index([organizationId, dealId, createdAt, id], map: "pact_investors_org_deal_created_idx")
  @@map("pact_investors")
}

/// A published, frozen investor view (T-141): allow-listed sections only (a CHECK), never changed once written.
model InvestorViewVersion {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  version        Int
  /// { meta, claims, capTable, economics, scenarios } — INVESTOR_VIEW_SECTIONS (@pactlab/domain)
  content        Json
  contentSha256  String   @map("content_sha256") @db.Char(64)
  publishedBy    String   @map("published_by") @db.Uuid
  publishedAt    DateTime @default(now()) @map("published_at") @db.Timestamptz(3)

  @@unique([organizationId, dealId, version], map: "investor_view_versions_deal_version_key")
  @@map("investor_view_versions")
}

/// One meaningful change on a pact (T-145, ADR 0046), recorded through `app_notify` in the change's
/// own transaction; deduplicated by a stable key. Readable only through a notification of one's own.
model NotificationEvent {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  type           String
  urgency        String
  dedupeKey      String   @map("dedupe_key")
  /// The exact place in the pact the item links to, e.g. /deals/<id>/terms.
  linkPath       String   @map("link_path")
  /// SHARED | BUYER_ONLY
  visibility     String
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  notifications Notification[]

  @@unique([organizationId, dealId, dedupeKey], map: "notification_events_dedupe_key")
  @@map("notification_events")
}

/// One person's item for one event: the in-app inbox row and its email state.
model Notification {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  dealId         String    @map("deal_id") @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  urgency        String
  visibility     String
  readAt         DateTime? @map("read_at") @db.Timestamptz(3)
  /// PENDING | SENDING | SENT | IN_APP_ONLY | SUPPRESSED | NO_ADDRESS | FAILED
  emailStatus    String    @default("PENDING") @map("email_status")
  deliveryId     String?   @map("delivery_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  event    NotificationEvent     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  delivery NotificationDelivery? @relation(fields: [deliveryId], references: [id], onDelete: Restrict)

  @@unique([eventId, userId], map: "notifications_event_user_key")
  @@index([userId, organizationId, createdAt(sort: Desc), id(sort: Desc)], map: "notifications_inbox_idx")
  @@index([deliveryId], map: "notifications_delivery_idx")
  @@map("notifications")
}

/// The send record: one email (immediate or digest) to one person, and its outcome. No bodies.
model NotificationDelivery {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// IMMEDIATE | DIGEST
  kind       String
  /// CLAIMED | SENT | SUPPRESSED | FAILED
  status     String    @default("CLAIMED")
  items      Int
  errorClass String?   @map("error_class")
  claimedAt  DateTime  @default(now()) @map("claimed_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)

  notifications Notification[]

  @@index([userId, kind, claimedAt], map: "notification_deliveries_user_kind_idx")
  @@map("notification_deliveries")
}

/// A person's notification settings (deal null), or their override on one pact.
model NotificationPreference {
  id                 String   @id @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  organizationId     String?  @map("organization_id") @db.Uuid
  dealId             String?  @map("deal_id") @db.Uuid
  actNow             String?  @map("act_now")
  fyi                String?
  digest             String?
  timeZone           String?  @map("time_zone")
  quietStart         Int?     @map("quiet_start") @db.SmallInt
  quietEnd           Int?     @map("quiet_end") @db.SmallInt
  actNowThroughQuiet Boolean? @map("act_now_through_quiet")
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("notification_preferences")
}

/// T-179 (ADR 0060): a Deal Critical version. Org standards have no deal; pact criticals belong to one pact
/// (pact-only, or an override of an org standard named by overridesKey). Append-only; the latest version counts,
/// and only a CONFIRMED version evaluates. Buyer-confidential (RLS).
model DealCritical {
  id               String   @id @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  dealId           String?  @map("deal_id") @db.Uuid
  criticalKey      String   @map("critical_key") @db.Uuid
  version          Int
  /// ORG | PACT
  scope            String
  /// ORG only: the company type the standard applies to; null = all types.
  companyType      String?  @map("company_type")
  /// PACT only: the org standard this version overrides for the pact.
  overridesKey     String?  @map("overrides_key") @db.Uuid
  /// The organization's own words.
  words            String?
  metric           String?
  /// AT_LEAST | AT_MOST
  comparator       String?
  /// In the metric's unit (6% is 0.06).
  threshold        Decimal? @db.Decimal(24, 6)
  lookbackYears    Int?     @map("lookback_years")
  evenBand         Decimal? @map("even_band") @db.Decimal(24, 6)
  /// PROPOSED | CONFIRMED | DISABLED | RETIRED
  state            String
  /// AI | PERSON: who wrote the structured form.
  structureSource  String?  @map("structure_source")
  /// Why this version exists; required on an override.
  reason           String?
  /// An org standard promoted from a pact critical: the pact critical's key.
  promotedFromKey  String?  @map("promoted_from_key") @db.Uuid
  createdBy        String   @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([organizationId, criticalKey, version], map: "deal_criticals_key_version_key")
  @@index([organizationId, scope, dealId, createdAt], map: "deal_criticals_org_scope_idx")
  @@map("deal_criticals")
}

/// T-179: one critical's rating in one evaluation run, with its receipts and the version it ran under.
model CriticalEvaluation {
  id              String   @id @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  dealId          String   @map("deal_id") @db.Uuid
  runId           String   @map("run_id") @db.Uuid
  criticalKey     String   @map("critical_key") @db.Uuid
  criticalVersion Int      @map("critical_version")
  /// ORG | PACT: an org standard (possibly overridden) or a pact-only critical.
  origin          String
  overrideKey     String?  @map("override_key") @db.Uuid
  overrideVersion Int?     @map("override_version")
  /// The critical as it was rated: words, structure and what it overrode.
  snapshot        Json
  /// GOOD | EVEN | BAD | NO_EVIDENCE
  rating          String
  /// The figures used, by period, with their recomputation or cited pages.
  receipts        Json
  rationale       String
  /// NO_EVIDENCE only: what document would settle it.
  missing         String?
  policyBreach    Boolean  @default(false) @map("policy_breach")
  findingId       String?  @map("finding_id") @db.Uuid
  /// The pact's evidence when rated; a different mark now means the rating is stale.
  evidenceMark    String   @map("evidence_mark")
  engineVersion   String   @map("engine_version")
  evaluatedBy     String   @map("evaluated_by") @db.Uuid
  evaluatedAt     DateTime @default(now()) @map("evaluated_at") @db.Timestamptz(3)

  @@unique([organizationId, dealId, runId, criticalKey], map: "critical_evaluations_run_critical_key")
  @@index([organizationId, dealId, evaluatedAt], map: "critical_evaluations_deal_idx")
  @@map("critical_evaluations")
}

/// T-188 (ADR 0062): a multifamily pact's property profile. The public record's proposed fields (third-party
/// reference data with per-field provenance), the values a person accepted, and photo references (never bytes).
/// One per pact; buyer-confidential (RLS).
model DealPropertyProfile {
  id               String    @id @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  dealId           String    @map("deal_id") @db.Uuid
  address          String
  /// EMPTY | PROPOSED | ACCEPTED
  status           String    @default("EMPTY")
  /// [{ key, label, value, status, provenance }]
  proposed         Json      @default("[]")
  recordSource     String?   @map("record_source")
  recordVersion    String?   @map("record_version")
  recordFetchedAt  DateTime? @map("record_fetched_at") @db.Timestamptz(3)
  /// { key: { value, status, edited, provenance } }
  accepted         Json      @default("{}")
  acceptedBy       String?   @map("accepted_by") @db.Uuid
  acceptedAt       DateTime? @map("accepted_at") @db.Timestamptz(3)
  /// [{ ref, kind, source, capturedOn, attribution, attributionUri, alt }]: references only, never image bytes.
  photos           Json      @default("[]")
  photosSource     String?   @map("photos_source")
  photosPlaceName  String?   @map("photos_place_name")
  photosFetchedAt  DateTime? @map("photos_fetched_at") @db.Timestamptz(3)
  version          Int       @default(1)
  updatedBy        String    @map("updated_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@unique([organizationId, dealId], map: "deal_property_profiles_org_deal_key")
  @@map("deal_property_profiles")
}

/// T-178b (ADR 0059): a prep invite from a pact's own side to a Pactlab Rinse preparer. The token is
/// stored only as its SHA-256; 14 days, single use.
model RinsePrepInvite {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  dealId         String    @map("deal_id") @db.Uuid
  email          String
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(3)
  acceptedBy     String?   @map("accepted_by") @db.Uuid
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedBy      String?   @map("revoked_by") @db.Uuid

  @@index([organizationId, dealId, createdAt])
  @@map("rinse_prep_invites")
}

/// T-178b: a preparer bound to one pact by an accepted invite. No membership, no read access: the right
/// to have a rinsed set accepted for the pact, and AI rinse jobs counted against it.
model RinsePreparerBinding {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  dealId         String    @map("deal_id") @db.Uuid
  inviteId       String    @unique @map("invite_id") @db.Uuid
  preparerUserId String    @map("preparer_user_id") @db.Uuid
  boundAt        DateTime  @default(now()) @map("bound_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedBy      String?   @map("revoked_by") @db.Uuid

  @@index([organizationId, dealId])
  @@index([preparerUserId])
  @@map("rinse_preparer_bindings")
}

/// T-178b: a preparer sign-up from an invite, until its emailed code verifies. Reached only through
/// SECURITY DEFINER functions owned by pactlab_auth.
model RinsePreparerChallenge {
  id          String    @id @db.Uuid
  email       String
  displayName String    @map("display_name")
  inviteId    String    @map("invite_id") @db.Uuid
  codeHash    String    @map("code_hash") @db.Char(64)
  ipHash      String    @map("ip_hash") @db.Char(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts    Int       @default(0)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(3)

  @@index([email, createdAt])
  @@index([ipHash, createdAt])
  @@map("rinse_preparer_challenges")
}

/// T-180: the verified address Pactlab writes to, one per person. Personal data: never logged or sent
/// to a model. Read by the person only (RLS); written through SECURITY DEFINER functions (pactlab_auth).
model UserContactEmail {
  userId     String   @id @map("user_id") @db.Uuid
  email      String
  /// AUTH0_CLAIM (the identity provider's verified email) or CODE (confirmed with a one-time code).
  source     String
  verifiedAt DateTime @map("verified_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("user_contact_emails")
}

/// T-180: one-time codes (email, WhatsApp) and Telegram link tokens, stored only as hashes.
/// Reached only through SECURITY DEFINER functions owned by pactlab_auth.
model ContactVerification {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  kind           String
  target         String?
  secretHash     String    @map("secret_hash") @db.Char(64)
  consentText    String?   @map("consent_text")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts       Int       @default(0)
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(3)

  @@index([userId, kind, createdAt], map: "contact_verifications_user_kind_idx")
  @@index([secretHash], map: "contact_verifications_secret_idx")
  @@map("contact_verifications")
}

/// T-180: a verified Telegram chat or WhatsApp number. A row exists only once verified; RLS by user
/// and organization; an admin sees it masked through `app_contact_admin_list`, which audits the read.
model UserContactChannel {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// TELEGRAM, WHATSAPP, SLACK or TEAMS (T-181).
  kind           String
  /// The Telegram chat id, the WhatsApp number in E.164, `<team>:<member>` (Slack) or `<tenant>:<object id>` (Teams).
  handle         String
  verifiedAt     DateTime  @map("verified_at") @db.Timestamptz(3)
  consentText    String?   @map("consent_text")
  consentedAt    DateTime? @map("consented_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// USER, BLOCKED (Telegram), STOP (/stop, WhatsApp STOP, Slack or Teams disconnect), REPLACED or UNINSTALLED.
  revokedReason  String?   @map("revoked_reason")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// T-181: the Slack or Teams install a link belongs to; ending the install ends the link.
  installId      String?   @map("install_id") @db.Uuid

  @@index([organizationId, userId], map: "user_contact_channels_org_idx")
  @@index([installId], map: "user_contact_channels_install_idx")
  @@map("user_contact_channels")
}

/// T-180: each message sent on a channel, claimed before it is sent (at most once per notification).
model ContactChannelDelivery {
  id             String    @id @db.Uuid
  channelId      String    @map("channel_id") @db.Uuid
  notificationId String?   @map("notification_id") @db.Uuid
  /// NOTIFICATION or TEST.
  purpose        String
  /// CLAIMED, SENT or FAILED.
  outcome        String    @default("CLAIMED")
  errorClass     String?   @map("error_class")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(3)

  @@index([channelId, createdAt], map: "contact_channel_deliveries_channel_idx")
  @@map("contact_channel_deliveries")
}

/// T-146: a person's alert channel choices. Every channel is on unless listed here.
model NotificationChannelPreference {
  userId      String   @id @map("user_id") @db.Uuid
  /// WEB_PUSH, TELEGRAM, SLACK, TEAMS, WHATSAPP or LINE.
  channelsOff String[] @default([]) @map("channels_off")
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("notification_channel_preferences")
}

/// T-146: one browser on one device, subscribed with the Push API (VAPID). The endpoint and keys are
/// personal data: the runtime role cannot read them; the dispatcher reads them through a function.
model PushSubscription {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  endpoint       String
  p256dh         String
  auth           String
  deviceLabel    String    @map("device_label")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSentAt     DateTime? @map("last_sent_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// USER, EXPIRED (the push service said 404 or 410) or REPLACED.
  revokedReason  String?   @map("revoked_reason")

  @@index([userId, organizationId], map: "push_subscriptions_user_idx")
  @@map("push_subscriptions")
}

/// T-146: one alert to one person about one pact, delivered once on each channel they chose. The daily
/// cap and the 15-minute fold count these.
model ChannelAlert {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)

  @@index([userId, createdAt], map: "channel_alerts_user_idx")
  @@map("channel_alerts")
}

/// T-146: what became of each "act now" item on the channels: ALERTED, CAPPED or SKIPPED.
model ChannelAlertItem {
  notificationId String   @id @map("notification_id") @db.Uuid
  alertId        String?  @map("alert_id") @db.Uuid
  outcome        String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([alertId], map: "channel_alert_items_alert_idx")
  @@map("channel_alert_items")
}

/// T-146: each web push sent, claimed before it is sent (at most once per alert and device).
model PushDelivery {
  id             String    @id @db.Uuid
  subscriptionId String    @map("subscription_id") @db.Uuid
  alertId        String?   @map("alert_id") @db.Uuid
  /// ALERT or TEST.
  purpose        String
  /// CLAIMED, SENT, FAILED or EXPIRED.
  outcome        String    @default("CLAIMED")
  errorClass     String?   @map("error_class")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(3)

  @@index([subscriptionId, createdAt], map: "push_deliveries_subscription_idx")
  @@map("push_deliveries")
}

/// T-181: Pactlab installed in an organization's Slack workspace or Microsoft Teams tenant, once, by an
/// admin. The workspace or tenant id and the bot token's reference are credential data: reached only
/// through SECURITY DEFINER functions owned by pactlab_auth; the runtime role reads nothing here.
model ChatInstall {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  /// SLACK or TEAMS.
  provider       String
  externalTenant String    @map("external_tenant")
  /// Slack: the bot token's secretref. Teams: none.
  credentialRef  String?   @map("credential_ref")
  installedBy    String    @map("installed_by") @db.Uuid
  installedAt    DateTime  @default(now()) @map("installed_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// ADMIN, UNINSTALLED, TOKENS_REVOKED or REPLACED.
  revokedReason  String?   @map("revoked_reason")

  @@map("chat_installs")
}

/// T-181: where a person's personal chat with the Teams bot lives, captured from the verified install
/// activity; matched to a Pactlab person only by a keyed hash of their email. pactlab_auth only.
model TeamsConversationRef {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id")
  aadObjectId    String    @map("aad_object_id")
  emailHash      String?   @map("email_hash") @db.Char(64)
  serviceUrl     String    @map("service_url")
  conversationId String    @map("conversation_id")
  capturedAt     DateTime  @default(now()) @map("captured_at") @db.Timestamptz(3)
  removedAt      DateTime? @map("removed_at") @db.Timestamptz(3)

  @@unique([tenantId, aadObjectId], map: "teams_conversation_refs_member")
  @@index([tenantId, emailHash], map: "teams_conversation_refs_email_idx")
  @@map("teams_conversation_refs")
}
