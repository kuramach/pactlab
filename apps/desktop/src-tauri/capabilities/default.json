{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The Rinse window: core features, update checks, prep-invite deep links, starting the engine sidecar (nothing else may be spawned), the folder and file pickers, and opening a drive's sign-in page in the seller's browser (https only).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "updater:default",
    "deep-link:default",
    "dialog:allow-open",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/rinse-engine",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill",
    {
      "identifier": "shell:allow-open",
      "allow": [
        {
          "url": "https://**"
        }
      ]
    }
  ]
}
