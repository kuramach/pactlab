// Pactlab system of record. Every deal-scoped row carries organization_id and
// deal_id; composite foreign keys make cross-tenant references impossible.
// Row-level security policies live in the SQL migrations (see migrations/).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  PUBLIC_ACQUIRER
  PRIVATE_ACQUIRER
  TAKE_PRIVATE

  @@map("transaction_type")
}

enum PartyRole {
  BUYER
  SELLER

  @@map("party_role")
}

enum CompanyOwnership {
  PUBLIC
  PRIVATE

  @@map("company_ownership")
}

enum CompanyType {
  SOFTWARE_SAAS
  FINTECH
  HEALTHCARE
  TELECOM_MEDIA
  PROFESSIONAL_SERVICES
  PHARMA_BIOTECH
  ECOMMERCE_DTC
  OTHER

  @@map("company_type")
}

enum ImportTarget {
  BILLING_INVOICE_LINE

  @@map("import_target")
}

enum SourceUploadStatus {
  UPLOADED
  IMPORTED
  REJECTED
  PURGED

  @@map("source_upload_status")
}

enum OrganizationAuthMethod {
  AUTH0
  EMAIL_CODE

  @@map("organization_auth_method")
}

enum OrganizationStatus {
  ACTIVE
  PENDING_APPROVAL
  SUSPENDED

  @@map("organization_status")
}

enum OrganizationOrigin {
  OPERATOR
  SIGNUP

  @@map("organization_origin")
}

enum OrganizationRole {
  ORG_OWNER
  ORG_ADMIN
  MEMBER

  @@map("organization_role")
}

enum DealRole {
  DEAL_LEAD
  ANALYST
  REVIEWER
  ADVISER
  TARGET_CONTRIBUTOR
  VIEWER

  @@map("deal_role")
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED

  @@map("membership_status")
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTERED

  @@map("job_status")
}

enum ConnectionMode {
  FIXTURE
  LIVE

  @@map("connection_mode")
}

enum ConnectionStatus {
  ACTIVE
  DISABLED

  @@map("connection_status")
}

enum SyncRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED

  @@map("sync_run_status")
}

enum EvidenceVisibility {
  BUYER_ONLY
  SHARED

  @@map("evidence_visibility")
}

enum FindingDomain {
  ARCHITECTURE
  MAINTAINABILITY
  SECURITY
  OSS_LICENSE
  TEST_QUALITY
  OPERATIONS
  CODE_PROVENANCE
  KEY_PERSON

  @@map("finding_domain")
}

enum FindingSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("finding_severity")
}

enum FindingConfidence {
  LOW
  MEDIUM
  HIGH

  @@map("finding_confidence")
}

enum FindingStatus {
  DRAFT
  IN_REVIEW
  ACCEPTED
  REJECTED

  @@map("finding_status")
}

enum FindingOrigin {
  SCANNER
  HEURISTIC
  AI
  HUMAN

  @@map("finding_origin")
}

enum ReviewDecision {
  SUBMITTED
  SUPPORT_REQUESTED
  ACCEPTED
  REJECTED

  @@map("review_decision")
}

enum PricedRiskType {
  PRICE_REDUCTION
  ESCROW
  INDEMNITY
  REMEDIATION_COST

  @@map("priced_risk_type")
}

enum ScenarioStatus {
  DRAFT
  SUBMITTED
  APPROVED

  @@map("scenario_status")
}

enum SubmissionDecisionKind {
  APPROVED
  REJECTED

  @@map("submission_decision")
}

enum DataClassification {
  PUBLIC
  BUSINESS
  FINANCIAL
  HR
  COMPENSATION
  PERFORMANCE
  NAMED_CONTRIBUTION

  @@map("data_classification")
}

enum RetentionClass {
  DEAL_TERM
  SHORT_90D
  LEGAL_HOLD

  @@map("retention_class")
}

enum DocumentStatus {
  AVAILABLE
  PURGED

  @@map("document_status")
}

enum AiRunStatus {
  SUCCEEDED
  SCHEMA_INVALID
  PROVIDER_ERROR

  @@map("ai_run_status")
}

enum DocumentFindingStatus {
  DRAFT
  ACCEPTED
  REJECTED

  @@map("document_finding_status")
}

enum DocumentFindingKind {
  PARTY
  DATE
  CLAUSE

  @@map("document_finding_kind")
}

enum DocumentReviewDecision {
  ACCEPT
  REJECT

  @@map("document_review_decision")
}

enum EvidenceEdgeType {
  SUPERSEDES
  DERIVED_FROM

  @@map("evidence_edge_type")
}

model Organization {
  id                  String                 @id @default(uuid(7)) @db.Uuid
  name                String
  slug                String                 @unique
  /// External identity-provider organization reference (Auth0 `org_id` claim).
  /// Set exactly when the organization signs in through Auth0 (CHECK in migration).
  auth0OrganizationId String?                @unique @map("auth0_organization_id")
  /// How members sign in. Tokens from the other method never reach this organization.
  authMethod          OrganizationAuthMethod @default(AUTH0) @map("auth_method")
  /// Only ACTIVE organizations can be entered; sign-ups start PENDING_APPROVAL.
  status              OrganizationStatus     @default(ACTIVE)
  /// The organization asked for company SSO (Auth0) at sign-up; set up by an operator.
  ssoRequested        Boolean                @default(false) @map("sso_requested")
  createdVia          OrganizationOrigin     @default(OPERATOR) @map("created_via")
  region              String                 @default("us-east-1")
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships             OrganizationMembership[]
  deals                   Deal[]
  dealMemberships         DealMembership[]
  auditEvents             AuditEvent[]
  outboxEvents            OutboxEvent[]
  jobRuns                 JobRun[]
  storedFiles             StoredFile[]
  connections             Connection[]
  syncRuns                SyncRun[]
  evidenceItems           EvidenceItem[]
  evidenceEdges           EvidenceEdge[]
  citations               Citation[]
  findings                Finding[]
  findingLinks            FindingEvidenceLink[]
  findingReviews          FindingReview[]
  valuationScenarios      ValuationScenario[]
  valuationAssumptionSets ValuationAssumptionSet[]
  valuationRuns           ValuationRun[]
  valuationSubmissions    ValuationSubmission[]
  valuationDecisions      ValuationSubmissionDecision[]
  documents               Document[]
  documentPages           DocumentPage[]
  aiRuns                  AiRun[]
  documentFindings        DocumentFinding[]
  documentFindingReviews  DocumentFindingReview[]
  authSessions            AuthSession[]
  dealParties             DealParty[]
  sourceUploads           SourceUpload[]

  @@map("organizations")
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  /// Verified `sub` claim: Auth0 subject, or `pactlab|<user id>` for email-code sign-in.
  auth0Subject String   @unique @map("auth0_subject")
  /// Lowercased sign-in address for email-code organizations; never sent to models.
  email        String?  @unique
  displayName  String   @map("display_name")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organizationMemberships OrganizationMembership[]
  dealMemberships         DealMembership[]
  loginChallenges         LoginChallenge[]
  authSessions            AuthSession[]

  @@map("users")
}

model OrganizationMembership {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

model Deal {
  id              String          @id @default(uuid(7)) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  name            String
  targetName      String          @map("target_name")
  transactionType TransactionType @map("transaction_type")
  stage           String          @default("SCREENING")
  status          String          @default("ACTIVE")
  baseCurrency    String          @default("USD") @map("base_currency") @db.Char(3)
  createdBy       String          @map("created_by") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization            Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships             DealMembership[]
  jobRuns                 JobRun[]
  storedFiles             StoredFile[]
  auditEvents             AuditEvent[]
  outboxEvents            OutboxEvent[]
  connections             Connection[]
  syncRuns                SyncRun[]
  evidenceItems           EvidenceItem[]
  evidenceEdges           EvidenceEdge[]
  citations               Citation[]
  findings                Finding[]
  findingLinks            FindingEvidenceLink[]
  findingReviews          FindingReview[]
  valuationScenarios      ValuationScenario[]
  valuationAssumptionSets ValuationAssumptionSet[]
  valuationRuns           ValuationRun[]
  valuationSubmissions    ValuationSubmission[]
  valuationDecisions      ValuationSubmissionDecision[]
  documents               Document[]
  documentPages           DocumentPage[]
  aiRuns                  AiRun[]
  documentFindings        DocumentFinding[]
  documentFindingReviews  DocumentFindingReview[]
  parties                 DealParty[]
  sourceUploads           SourceUpload[]

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@map("deals")
}

/// The buying and selling entities of a Pact. One row per role per deal;
/// the deal's transaction type was derived from their ownership at creation.
model DealParty {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  dealId         String           @map("deal_id") @db.Uuid
  role           PartyRole
  name           String
  ownership      CompanyOwnership
  ticker         String?
  exchange       String?
  website        String?
  companyType    CompanyType?     @map("company_type")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, dealId, role])
  @@map("deal_parties")
}

model DealMembership {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  dealId         String           @map("deal_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           DealRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, dealId, userId])
  @@index([userId])
  @@map("deal_memberships")
}

/// Append-only, hash-chained audit trail. UPDATE and DELETE are revoked.
model AuditEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String?  @map("deal_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  targetType     String   @map("target_type")
  targetId       String?  @map("target_id")
  outcome        String
  requestId      String?  @map("request_id")
  ipAddress      String?  @map("ip_address")
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  /// Chain fields are assigned by the audit_events_chain trigger; client values are overwritten.
  chainSeq       BigInt   @default(0) @map("chain_seq")
  prevHash       String?  @map("prev_hash")
  hash           String   @default("")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal?        @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, occurredAt])
  @@index([organizationId, dealId, occurredAt])
  @@map("audit_events")
}

/// Transactional outbox: domain events written in the same transaction as the change.
model OutboxEvent {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  dealId         String?   @map("deal_id") @db.Uuid
  aggregateType  String    @map("aggregate_type")
  aggregateId    String    @map("aggregate_id")
  eventType      String    @map("event_type")
  payload        Json
  idempotencyKey String    @map("idempotency_key")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal?        @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

/// Durable record of async jobs; uniqueness on idempotency key makes replays safe.
model JobRun {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  dealId         String    @map("deal_id") @db.Uuid
  type           String
  schemaVersion  Int       @map("schema_version")
  idempotencyKey String    @map("idempotency_key")
  status         JobStatus @default(QUEUED)
  attempt        Int       @default(0)
  requestedBy    String    @map("requested_by") @db.Uuid
  correlationId  String    @map("correlation_id")
  errorClass     String?   @map("error_class")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, dealId, idempotencyKey])
  @@map("job_runs")
}

/// Metadata for tenant-scoped objects. Bytes live in the object store under
/// `<organization_id>/<deal_id>/...`; a check constraint enforces the prefix.
model StoredFile {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  objectKey      String   @map("object_key")
  fileName       String   @map("file_name")
  contentType    String   @map("content_type")
  sizeBytes      BigInt   @map("size_bytes")
  sha256         String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)

  @@unique([objectKey])
  @@map("stored_files")
}

/// A source connected to a deal. Mode is persisted and every change audited;
/// downstream logic never branches on it. Secrets live in the managed store —
/// only a revocable reference is kept here.
model Connection {
  id                 String             @id @default(uuid(7)) @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  dealId             String             @map("deal_id") @db.Uuid
  provider           String
  displayName        String             @map("display_name")
  mode               ConnectionMode
  credentialRef      String?            @map("credential_ref")
  /// Provider-specific, non-secret settings (e.g. which datasets to read).
  config             Json
  status             ConnectionStatus   @default(ACTIVE)
  /// Default visibility of evidence this connection produces.
  evidenceVisibility EvidenceVisibility @default(BUYER_ONLY) @map("evidence_visibility")
  createdBy          String             @map("created_by") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal          Deal           @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  syncRuns      SyncRun[]
  evidenceItems EvidenceItem[]
  sourceUploads SourceUpload[]

  @@unique([organizationId, dealId, id])
  @@index([organizationId, dealId, createdAt])
  @@map("connections")
}

/// One idempotent pull from a connection. Replaying the same idempotency key
/// returns the existing run; re-pulling unchanged records creates nothing.
model SyncRun {
  id               String        @id @default(uuid(7)) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  dealId           String        @map("deal_id") @db.Uuid
  connectionId     String        @map("connection_id") @db.Uuid
  connectorVersion String        @map("connector_version")
  idempotencyKey   String        @map("idempotency_key")
  status           SyncRunStatus @default(QUEUED)
  cursor           String?
  recordsSeen      Int           @default(0) @map("records_seen")
  recordsCreated   Int           @default(0) @map("records_created")
  recordsUnchanged Int           @default(0) @map("records_unchanged")
  issuesCount      Int           @default(0) @map("issues_count")
  errorClass       String?       @map("error_class")
  requestedBy      String        @map("requested_by") @db.Uuid
  correlationId    String        @map("correlation_id")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt        DateTime?     @map("started_at") @db.Timestamptz(3)
  completedAt      DateTime?     @map("completed_at") @db.Timestamptz(3)

  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal               Deal           @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  connection         Connection     @relation(fields: [organizationId, dealId, connectionId], references: [organizationId, dealId, id], onDelete: Restrict)
  firstEvidenceItems EvidenceItem[] @relation("FirstSyncRun")
  lastEvidenceItems  EvidenceItem[] @relation("LastSyncRun")

  @@unique([organizationId, dealId, id])
  @@unique([organizationId, dealId, idempotencyKey])
  @@index([organizationId, dealId, connectionId, createdAt])
  @@map("sync_runs")
}

/// Normalized evidence. Immutable except for last-seen and sharing columns;
/// changed source content creates a new item linked by a SUPERSEDES edge.
model EvidenceItem {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  dealId         String             @map("deal_id") @db.Uuid
  connectionId   String             @map("connection_id") @db.Uuid
  firstSyncRunId String             @map("first_sync_run_id") @db.Uuid
  lastSyncRunId  String             @map("last_sync_run_id") @db.Uuid
  evidenceType   String             @map("evidence_type")
  sourceSystem   String             @map("source_system")
  sourceRecordId String             @map("source_record_id")
  observedAt     DateTime?          @map("observed_at") @db.Timestamptz(3)
  canonical      Json
  /// sha256 of the canonical JSON.
  contentHash    String             @map("content_hash") @db.Char(64)
  sensitivity    String             @default("STANDARD")
  visibility     EvidenceVisibility @default(BUYER_ONLY)
  sharedBy       String?            @map("shared_by") @db.Uuid
  sharedAt       DateTime?          @map("shared_at") @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal                  @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  connection   Connection            @relation(fields: [organizationId, dealId, connectionId], references: [organizationId, dealId, id], onDelete: Restrict)
  firstSyncRun SyncRun               @relation("FirstSyncRun", fields: [organizationId, dealId, firstSyncRunId], references: [organizationId, dealId, id], onDelete: Restrict)
  lastSyncRun  SyncRun               @relation("LastSyncRun", fields: [organizationId, dealId, lastSyncRunId], references: [organizationId, dealId, id], onDelete: Restrict)
  citations    Citation[]
  edgesFrom    EvidenceEdge[]        @relation("EdgeFrom")
  edgesTo      EvidenceEdge[]        @relation("EdgeTo")
  findingLinks FindingEvidenceLink[]

  @@unique([organizationId, dealId, id])
  @@unique([organizationId, dealId, connectionId, sourceRecordId, contentHash])
  @@index([organizationId, dealId, evidenceType])
  @@index([organizationId, dealId, connectionId, sourceRecordId])
  @@map("evidence_items")
}

/// Relational lineage between evidence items; traversed with recursive CTEs.
model EvidenceEdge {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  dealId         String           @map("deal_id") @db.Uuid
  fromEvidenceId String           @map("from_evidence_id") @db.Uuid
  toEvidenceId   String           @map("to_evidence_id") @db.Uuid
  edgeType       EvidenceEdgeType @map("edge_type")
  reason         String
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  from         EvidenceItem @relation("EdgeFrom", fields: [organizationId, dealId, fromEvidenceId], references: [organizationId, dealId, id], onDelete: Restrict)
  to           EvidenceItem @relation("EdgeTo", fields: [organizationId, dealId, toEvidenceId], references: [organizationId, dealId, id], onDelete: Restrict)

  @@unique([organizationId, dealId, fromEvidenceId, toEvidenceId, edgeType])
  @@index([organizationId, dealId, toEvidenceId])
  @@map("evidence_edges")
}

/// Exact pointer into a source (CSV row today; document pages arrive later)
/// plus the hash of the quoted source text, verified at display time.
model Citation {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  evidenceItemId String   @map("evidence_item_id") @db.Uuid
  locator        Json
  quoteHash      String   @map("quote_hash") @db.Char(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  evidenceItem EvidenceItem @relation(fields: [organizationId, dealId, evidenceItemId], references: [organizationId, dealId, id], onDelete: Restrict)

  @@unique([organizationId, dealId, evidenceItemId, quoteHash])
  @@map("citations")
}

/// Buyer-side finding. Status changes only through human reviews; every
/// change bumps `version` (optimistic concurrency). Priced-risk amounts are
/// numeric with explicit currency, all-or-none (CHECK in the migration).
model Finding {
  id                 String            @id @default(uuid(7)) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  dealId             String            @map("deal_id") @db.Uuid
  domain             FindingDomain
  title              String
  description        String
  severity           FindingSeverity
  confidence         FindingConfidence
  status             FindingStatus     @default(DRAFT)
  origin             FindingOrigin
  /// Stable signal identity; replaying a scan yields the same fingerprint.
  fingerprint        String
  pricedRiskType     PricedRiskType?   @map("priced_risk_type")
  pricedRiskCurrency String?           @map("priced_risk_currency") @db.Char(3)
  pricedRiskLow      Decimal?          @map("priced_risk_low") @db.Decimal(19, 4)
  pricedRiskHigh     Decimal?          @map("priced_risk_high") @db.Decimal(19, 4)
  pricedRiskBasis    String?           @map("priced_risk_basis")
  /// The FindingActor that drafted it (HUMAN, AI or SYSTEM).
  createdBy          Json              @map("created_by")
  /// Finding version whose evidence link set is current.
  evidenceVersion    Int               @map("evidence_version")
  version            Int
  createdAt          DateTime          @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @map("updated_at") @db.Timestamptz(3)

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal          Deal                  @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  evidenceLinks FindingEvidenceLink[]
  reviews       FindingReview[]

  @@unique([organizationId, dealId, id])
  @@unique([organizationId, dealId, fingerprint])
  @@index([organizationId, dealId, status, domain])
  @@map("findings")
}

/// Insert-only provenance: evidence item, exact commit and versioned tool.
/// An edit appends a new set stamped with the finding version; earlier sets
/// remain as history.
model FindingEvidenceLink {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  findingId      String   @map("finding_id") @db.Uuid
  findingVersion Int      @map("finding_version")
  ordinal        Int
  evidenceItemId String   @map("evidence_item_id") @db.Uuid
  commitSha      String   @map("commit_sha")
  toolName       String   @map("tool_name")
  toolVersion    String   @map("tool_version")
  rulesetVersion String?  @map("ruleset_version")
  /// Repository-relative path; never file contents.
  path           String?
  lineStart      Int?     @map("line_start")
  lineEnd        Int?     @map("line_end")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  finding      Finding      @relation(fields: [organizationId, dealId, findingId], references: [organizationId, dealId, id], onDelete: Restrict)
  evidenceItem EvidenceItem @relation(fields: [organizationId, dealId, evidenceItemId], references: [organizationId, dealId, id], onDelete: Restrict)

  @@unique([organizationId, dealId, findingId, findingVersion, ordinal])
  @@index([organizationId, dealId, evidenceItemId])
  @@map("finding_evidence_links")
}

/// Append-only human decision on a finding.
model FindingReview {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  dealId         String         @map("deal_id") @db.Uuid
  findingId      String         @map("finding_id") @db.Uuid
  decision       ReviewDecision
  fromStatus     FindingStatus  @map("from_status")
  toStatus       FindingStatus  @map("to_status")
  reviewerUserId String         @map("reviewer_user_id") @db.Uuid
  reviewerRole   DealRole       @map("reviewer_role")
  rationale      String
  decidedAt      DateTime       @map("decided_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  finding      Finding      @relation(fields: [organizationId, dealId, findingId], references: [organizationId, dealId, id], onDelete: Restrict)

  @@index([organizationId, dealId, findingId, decidedAt])
  @@map("finding_reviews")
}

/// Valuation scenario. DRAFT is editable; submission freezes the latest run.
/// Every change bumps `version` (optimistic concurrency).
model ValuationScenario {
  id                String          @id @default(uuid(7)) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  dealId            String          @map("deal_id") @db.Uuid
  name              String
  currency          String          @db.Char(3)
  transactionType   TransactionType @map("transaction_type")
  status            ScenarioStatus  @default(DRAFT)
  assumptionVersion Int             @map("assumption_version")
  createdBy         String          @map("created_by") @db.Uuid
  createdAt         DateTime        @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @map("updated_at") @db.Timestamptz(3)
  version           Int

  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal           Deal                     @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  assumptionSets ValuationAssumptionSet[]
  runs           ValuationRun[]
  submissions    ValuationSubmission[]

  @@unique([organizationId, dealId, id])
  @@index([organizationId, dealId, createdAt])
  @@map("valuation_scenarios")
}

/// Insert-only, versioned assumption set. Values are decimal strings in JSON.
model ValuationAssumptionSet {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  scenarioId     String   @map("scenario_id") @db.Uuid
  version        Int
  values         Json
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal              @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  scenario     ValuationScenario @relation(fields: [organizationId, dealId, scenarioId], references: [organizationId, dealId, id], onDelete: Restrict)

  @@unique([organizationId, dealId, scenarioId, version])
  @@map("valuation_assumption_sets")
}

/// Insert-only engine run: the full resolved inputs and the result produced.
model ValuationRun {
  id                String   @id @default(uuid(7)) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  dealId            String   @map("deal_id") @db.Uuid
  scenarioId        String   @map("scenario_id") @db.Uuid
  assumptionVersion Int      @map("assumption_version")
  inputs            Json
  result            Json
  ranBy             String   @map("ran_by") @db.Uuid
  ranAt             DateTime @map("ran_at") @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal                  @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  scenario     ValuationScenario     @relation(fields: [organizationId, dealId, scenarioId], references: [organizationId, dealId, id], onDelete: Restrict)
  submissions  ValuationSubmission[]

  @@unique([organizationId, dealId, id])
  @@index([organizationId, dealId, scenarioId, ranAt])
  @@map("valuation_runs")
}

/// Frozen submission. `canonical` is stored and served byte-for-byte; a
/// CHECK ties it to its SHA-256 digest.
model ValuationSubmission {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  scenarioId     String   @map("scenario_id") @db.Uuid
  runId          String   @map("run_id") @db.Uuid
  canonical      String
  digest         String   @db.Char(64)
  submittedBy    String   @map("submitted_by") @db.Uuid
  submittedAt    DateTime @map("submitted_at") @db.Timestamptz(3)

  organization Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal                          @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  scenario     ValuationScenario             @relation(fields: [organizationId, dealId, scenarioId], references: [organizationId, dealId, id], onDelete: Restrict)
  run          ValuationRun                  @relation(fields: [organizationId, dealId, runId], references: [organizationId, dealId, id], onDelete: Restrict)
  decisions    ValuationSubmissionDecision[]

  @@unique([organizationId, dealId, id])
  @@index([organizationId, dealId, scenarioId, submittedAt])
  @@map("valuation_submissions")
}

/// Append-only human decision on a submission.
model ValuationSubmissionDecision {
  id             String                 @id @default(uuid(7)) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  dealId         String                 @map("deal_id") @db.Uuid
  submissionId   String                 @map("submission_id") @db.Uuid
  decision       SubmissionDecisionKind
  rationale      String
  decidedBy      String                 @map("decided_by") @db.Uuid
  decidedRole    DealRole               @map("decided_role")
  decidedAt      DateTime               @map("decided_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal                @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  submission   ValuationSubmission @relation(fields: [organizationId, dealId, submissionId], references: [organizationId, dealId, id], onDelete: Restrict)

  @@index([organizationId, dealId, submissionId, decidedAt])
  @@map("valuation_submission_decisions")
}

/// Uploaded document metadata. Bytes live in the object store under the
/// tenant/deal prefix (CHECK in the migration). Target uploads are SHARED.
model Document {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  dealId         String             @map("deal_id") @db.Uuid
  fileName       String             @map("file_name")
  contentType    String             @map("content_type")
  sizeBytes      Int                @map("size_bytes")
  sha256         String             @db.Char(64)
  objectKey      String             @map("object_key")
  pageCount      Int                @map("page_count")
  dataClass      DataClassification @map("data_class")
  /// Per-document AI exclusion; always true for prohibited data classes.
  aiExcluded     Boolean            @map("ai_excluded")
  retentionClass RetentionClass     @map("retention_class")
  retainUntil    DateTime?          @map("retain_until") @db.Timestamptz(3)
  visibility     EvidenceVisibility
  malwareScanner String             @map("malware_scanner")
  status         DocumentStatus     @default(AVAILABLE)
  uploadedBy     String             @map("uploaded_by") @db.Uuid
  createdAt      DateTime           @map("created_at") @db.Timestamptz(3)
  purgedAt       DateTime?          @map("purged_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal              @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  pages        DocumentPage[]
  findings     DocumentFinding[]

  @@unique([organizationId, dealId, id])
  @@unique([objectKey])
  @@index([organizationId, dealId, sha256])
  @@map("documents")
}

/// Extracted page. The page id is the citation source id; purge nulls the
/// text but keeps number and checksum for provenance.
model DocumentPage {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  dealId         String  @map("deal_id") @db.Uuid
  documentId     String  @map("document_id") @db.Uuid
  pageNumber     Int     @map("page_number")
  text           String?
  checksum       String  @db.Char(64)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  document     Document     @relation(fields: [organizationId, dealId, documentId], references: [organizationId, dealId, id], onDelete: Restrict)

  @@unique([organizationId, dealId, documentId, pageNumber])
  @@map("document_pages")
}

/// Insert-only record of one model invocation: hashes and counts only, never
/// prompt or document content.
model AiRun {
  id               String      @id @default(uuid(7)) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  dealId           String      @map("deal_id") @db.Uuid
  taskType         String      @map("task_type")
  promptId         String      @map("prompt_id")
  promptVersion    String      @map("prompt_version")
  promptHash       String      @map("prompt_hash")
  modelAlias       String      @map("model_alias")
  resolvedModelId  String      @map("resolved_model_id")
  inputHashes      String[]    @map("input_hashes")
  outputHash       String?     @map("output_hash")
  status           AiRunStatus
  repairAttempted  Boolean     @map("repair_attempted")
  injectionSignals Int         @map("injection_signals")
  inputTokens      Int         @map("input_tokens")
  outputTokens     Int         @map("output_tokens")
  latencyMs        Int         @map("latency_ms")
  createdAt        DateTime    @map("created_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal              @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  findings     DocumentFinding[]

  @@unique([organizationId, dealId, id])
  @@index([organizationId, dealId, createdAt])
  @@map("ai_runs")
}

/// AI-drafted document finding. Exact citations are stored with it; only a
/// named human moves it out of DRAFT.
model DocumentFinding {
  id                  String                @id @default(uuid(7)) @db.Uuid
  organizationId      String                @map("organization_id") @db.Uuid
  dealId              String                @map("deal_id") @db.Uuid
  documentId          String                @map("document_id") @db.Uuid
  aiRunId             String                @map("ai_run_id") @db.Uuid
  origin              String
  kind                DocumentFindingKind
  subtype             String
  domain              String
  title               String
  summary             String
  severity            FindingSeverity
  status              DocumentFindingStatus @default(DRAFT)
  fingerprint         String
  /// ResolvedCitation[]: page, offsets, quote and quote hash.
  citations           Json
  promptId            String                @map("prompt_id")
  promptVersion       String                @map("prompt_version")
  promptHash          String                @map("prompt_hash")
  resolvedModelId     String                @map("resolved_model_id")
  createdBy           String                @map("created_by") @db.Uuid
  reviewerUserId      String?               @map("reviewer_user_id") @db.Uuid
  reviewerDisplayName String?               @map("reviewer_display_name")
  decidedAt           DateTime?             @map("decided_at") @db.Timestamptz(3)
  version             Int
  createdAt           DateTime              @map("created_at") @db.Timestamptz(3)

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal                    @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  document     Document                @relation(fields: [organizationId, dealId, documentId], references: [organizationId, dealId, id], onDelete: Restrict)
  aiRun        AiRun                   @relation(fields: [organizationId, dealId, aiRunId], references: [organizationId, dealId, id], onDelete: Restrict)
  reviews      DocumentFindingReview[]

  @@unique([organizationId, dealId, id])
  @@unique([organizationId, dealId, documentId, fingerprint])
  @@index([organizationId, dealId, status])
  @@map("document_findings")
}

/// Append-only named human decision on a document finding.
model DocumentFindingReview {
  id                  String                 @id @default(uuid(7)) @db.Uuid
  organizationId      String                 @map("organization_id") @db.Uuid
  dealId              String                 @map("deal_id") @db.Uuid
  findingId           String                 @map("finding_id") @db.Uuid
  decision            DocumentReviewDecision
  reviewerUserId      String                 @map("reviewer_user_id") @db.Uuid
  reviewerDisplayName String                 @map("reviewer_display_name")
  rationale           String
  decidedAt           DateTime               @map("decided_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal            @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  finding      DocumentFinding @relation(fields: [organizationId, dealId, findingId], references: [organizationId, dealId, id], onDelete: Restrict)

  @@index([organizationId, dealId, findingId, decidedAt])
  @@map("document_finding_reviews")
}

/// Pre-authentication state for email-code sign-in. Reached only through
/// SECURITY DEFINER functions; the runtime role has no table privileges.
/// Holds an HMAC of the code, never the code.
model LoginChallenge {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  codeHash   String    @map("code_hash") @db.Char(64)
  ipHash     String    @map("ip_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([ipHash, createdAt])
  @@map("login_challenges")
}

/// Server-side record of an email-code session. Every Pactlab-issued token
/// names its session, so revocation takes effect on the next request.
model AuthSession {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// Null until the user picks one of several email-code organizations.
  organizationId String?   @map("organization_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("auth_sessions")
}

/// Pending self-serve sign-up: details plus an HMAC of the emailed code.
/// Reached only through SECURITY DEFINER functions; the runtime role has no
/// table privileges. The organization is created only when the code verifies.
model SignupChallenge {
  id               String    @id @default(uuid(7)) @db.Uuid
  email            String
  displayName      String    @map("display_name")
  organizationName String    @map("organization_name")
  ssoRequested     Boolean   @map("sso_requested")
  codeHash         String    @map("code_hash") @db.Char(64)
  ipHash           String    @map("ip_hash") @db.Char(64)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts         Int       @default(0)
  consumedAt       DateTime? @map("consumed_at") @db.Timestamptz(3)
  /// Set when the code verified and the organization was created.
  organizationId   String?   @map("organization_id") @db.Uuid

  @@index([email, createdAt])
  @@index([ipHash, createdAt])
  @@map("signup_challenges")
}

/// An uploaded billing export and how its columns map to the Pactlab
/// standard invoice line. Imports run through the idempotent sync engine on
/// a `billing_upload` connection; the mapping is kept for lineage.
model SourceUpload {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  dealId         String             @map("deal_id") @db.Uuid
  connectionId   String?            @map("connection_id") @db.Uuid
  target         ImportTarget
  system         String
  fileName       String             @map("file_name")
  sha256         String             @db.Char(64)
  sizeBytes      Int                @map("size_bytes")
  rowCount       Int                @map("row_count")
  header         Json
  mapping        Json?
  mappingVersion String?            @map("mapping_version")
  objectKey      String?            @map("object_key")
  status         SourceUploadStatus @default(UPLOADED)
  syncRunId      String?            @map("sync_run_id") @db.Uuid
  visibility     EvidenceVisibility
  uploadedBy     String             @map("uploaded_by") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  importedAt     DateTime?          @map("imported_at") @db.Timestamptz(3)
  purgedAt       DateTime?          @map("purged_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  connection   Connection?  @relation(fields: [organizationId, dealId, connectionId], references: [organizationId, dealId, id], onDelete: Restrict)

  @@unique([organizationId, dealId, id])
  @@index([organizationId, dealId, createdAt])
  @@map("source_uploads")
}
