# Copy to .env (git-ignored). Variable NAMES and explanations only — never commit values.
# Local services: `pnpm local:up` starts PostgreSQL and Redis (see infra/local/).

# --- APP_* : environment and public origins ---
# One of: local, test, dev, qa, stage, production. Production fails closed on missing config.
APP_ENV=
# Origin of the web app, allowed by API CORS (e.g. the local Next.js dev server URL).
APP_WEB_ORIGIN=
# Log level: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=

# --- DATABASE_* : PostgreSQL ---
# Runtime login role (API, worker). Must be a member of `pactlab_app`, NOT a superuser, NOT BYPASSRLS.
DATABASE_URL=
# Schema-owner role used only by migrations and `pnpm seed`. Never given to runtime containers.
DATABASE_MIGRATION_URL=

# --- REDIS_* : BullMQ ---
# Redis connection URL for job queues (redis:// or rediss://).
REDIS_URL=

# --- AUTH0_* : identity ---
# Auth0 tenant domain (no scheme); tokens are verified against its JWKS.
AUTH0_DOMAIN=
# API audience identifier configured in Auth0.
AUTH0_AUDIENCE=
# Web sign-in (server-only): Auth0 Regular Web Application client ID.
AUTH0_CLIENT_ID=
# Web sign-in (server-only): Auth0 Regular Web Application client secret.
AUTH0_CLIENT_SECRET=
# Web sign-in (server-only): session-cookie encryption key, 32 bytes hex (`openssl rand -hex 32`).
AUTH0_SECRET=
# Web sign-in: public base URL of the web app; Auth0 callback/logout URLs derive from it.
APP_BASE_URL=

# --- Documents ---
# Local only (APP_ENV=local): directory for uploaded document originals, e.g. a
# git-ignored path. Unset, or any other APP_ENV, makes uploads fail closed.
DOCUMENT_STORE_DIR=

# --- API / worker tuning ---
# Port the API listens on.
API_PORT=
# Concurrent jobs per worker process.
WORKER_CONCURRENCY=

# --- Web (public, exposed to the browser — never secrets) ---
# Environment label for the non-production banner.
NEXT_PUBLIC_APP_ENV=
# Public origin of the API.
NEXT_PUBLIC_API_ORIGIN=

# --- AWS_* / AI ---
# AI runs through AWS Bedrock (see infra/cdk); no Anthropic key on deployed paths. Wired in T-006.
AWS_REGION=
