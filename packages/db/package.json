{
  "name": "@pactlab/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts",
    "./seed": "./src/seed/synthetic.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:diff": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script",
    "seed": "tsx --env-file-if-exists=../../.env src/seed/cli.ts",
    "test:fixtures": "vitest run --config vitest.fixtures.config.ts"
  },
  "dependencies": {
    "@pactlab/connectors": "workspace:*",
    "@pactlab/domain": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@pactlab/config": "workspace:*",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "10.12.0",
    "pglite-prisma-adapter": "0.7.2",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
