{
  "name": "@pactlab/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test --grep-invert '@slow|@quarantine'",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test:e2e:full": "playwright test --grep-invert @quarantine",
    "test:e2e:quarantine": "playwright test --grep @quarantine --pass-with-no-tests",
    "quarantine:check": "tsx support/check-quarantine.ts",
    "flaky:history": "tsx support/flaky-history.ts",
    "test:e2e:burn-in": "playwright test --repeat-each 20 --retries 0"
  },
  "devDependencies": {
    "@pactlab/config": "workspace:*",
    "@pactlab/connectors": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "10.12.0",
    "fflate": "0.8.2",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
