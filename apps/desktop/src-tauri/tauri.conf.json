{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pactlab Rinse",
  "version": "0.1.0",
  "identifier": "ai.pactlab.rinse",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pactlab Rinse",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' https://app.pactlab.ai"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis",
      "msi",
      "appimage",
      "deb"
    ],
    "category": "Business",
    "shortDescription": "Rinse your deal documents clean before they go in the room.",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/rinse-engine"
    ],
    "resources": {
      "resources/rinse-engine.cjs": "rinse-engine.cjs",
      "vendor/": "vendor/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "SET-AT-RELEASE: the minisign public key of the Rinse update signing key; CI passes it with --config (docs/runbooks/rinse.md)",
      "endpoints": [
        "https://pactlab.ai/rinse/releases/{{target}}/{{arch}}/{{current_version}}"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "pactlab-rinse"
        ]
      }
    }
  }
}
