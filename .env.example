# Copy to .env (git-ignored). Variable NAMES and explanations only — never commit values.
# Local services: `pnpm local:up` starts PostgreSQL and Redis (see infra/local/).

# --- APP_* : environment and public origins ---
# One of: local, test, dev, qa, stage, production. Production fails closed on missing config.
APP_ENV=
# Origin of the web app, allowed by API CORS (e.g. the local Next.js dev server URL).
APP_WEB_ORIGIN=
# Log level: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=

# --- DATABASE_* : PostgreSQL ---
# Runtime login role (API, worker). Must be a member of `pactlab_app`, NOT a superuser, NOT BYPASSRLS.
DATABASE_URL=
# Schema-owner role used only by migrations and `pnpm seed`. Never given to runtime containers.
DATABASE_MIGRATION_URL=

# --- REDIS_* : BullMQ ---
# Redis connection URL for job queues (redis:// or rediss://).
REDIS_URL=

# --- AUTH0_* : identity ---
# Auth0 tenant domain (no scheme); tokens are verified against its JWKS.
AUTH0_DOMAIN=
# API audience identifier configured in Auth0.
AUTH0_AUDIENCE=
# Web sign-in (server-only): Auth0 Regular Web Application client ID.
AUTH0_CLIENT_ID=
# Web sign-in (server-only): Auth0 Regular Web Application client secret.
AUTH0_CLIENT_SECRET=
# Web sign-in (server-only): session-cookie encryption key, 32 bytes hex (`openssl rand -hex 32`).
AUTH0_SECRET=
# Web sign-in: public base URL of the web app; Auth0 callback/logout URLs derive from it.
APP_BASE_URL=

# --- Email-code sign-in (organizations that do not use Auth0) ---
# API secret that signs email-code session tokens and keys code hashes; at least
# 32 characters (`openssl rand -hex 32`). Rotating it signs everyone out.
AUTH_TOKEN_SECRET=
# Local only (APP_ENV=local): directory where sign-in emails are written as
# files instead of sent, e.g. a git-ignored path. Elsewhere no email is sent yet.
LOCAL_MAIL_DIR=

# --- Self-serve sign-up ---
# "true" (default): new organizations wait for `pnpm org:approve <slug>`. "false": active at once.
SIGNUP_REQUIRES_APPROVAL=
# Address told about each new sign-up (with the approve command). Unset: use `pnpm org:pending`.
OPERATOR_EMAIL=

# --- Documents ---
# Local only (APP_ENV=local): directory for uploaded document originals, e.g. a
# git-ignored path. Unset, or any other APP_ENV, makes uploads fail closed.
DOCUMENT_STORE_DIR=

# --- Provider credentials ---
# Local only: encrypted store for sellers' provider tokens. Set both or neither.
# Directory (git-ignored path, e.g. .data/secrets) and a 32-byte key, base64
# (generate with: openssl rand -base64 32). Unset: live connections that need
# a stored token fail closed.
LOCAL_SECRETS_DIR=
LOCAL_SECRETS_KEY=
# Pactlab's read-only GitHub App (docs/runbooks/github-app.md). Set all three or none.
# Numeric App ID, the slug from https://github.com/apps/<slug>, and the path to
# the private key converted to PKCS#8 PEM. Never commit the key.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=

# --- API / worker tuning ---
# Port the API listens on.
API_PORT=
# Concurrent jobs per worker process.
WORKER_CONCURRENCY=

# --- Web (public, exposed to the browser — never secrets) ---
# Environment label for the non-production banner.
NEXT_PUBLIC_APP_ENV=
# Public origin of the API.
NEXT_PUBLIC_API_ORIGIN=

# Allow synthetic GitHub/Jira test connections (true/false). Unset: on for local, test, dev and qa.
ALLOW_FIXTURE_CONNECTIONS=

# Self-hosted Jira servers this deployment may reach, comma-separated host names
# (e.g. issues.apache.org). Atlassian Cloud sites are always allowed; any other
# Jira host is refused unless the operator lists it here. Never set from user input.
JIRA_SELF_HOSTED_HOSTS=

# Published macro forecasts for Foresight: imf (IMF DataMapper, public, no key; the default) or fixture (invented series, offline).
MACRO_FORECAST_SOURCE=

# --- AWS_* / AI ---
# Document AI provider: none (AI off, the default) or bedrock (Claude on Amazon Bedrock).
AI_PROVIDER=
# Bedrock Region, e.g. us-east-1. Required when AI_PROVIDER=bedrock.
AWS_REGION=
# AWS SSO profile the SDK uses (run `aws sso login --profile <name>` first). Never long-lived keys.
AWS_PROFILE=
# Optional per-alias model or inference-profile overrides; defaults are the us. geo profiles
# for Claude Sonnet 5.5 (balanced), Opus 5.5 (deep_review) and Haiku 5.5 (fast).
BEDROCK_MODEL_BALANCED=
BEDROCK_MODEL_DEEP_REVIEW=
BEDROCK_MODEL_FAST=

# --- Marketing site (apps/site; public, baked in at build time) ---
# App origin for the "Sign in" link (the site links to <origin>/login). Unset: no sign-in link.
NEXT_PUBLIC_APP_URL=
# Address for "Request a pilot" (mailto). Unset: no pilot button is shown.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- E2E_* : browser tests (apps/e2e, `pnpm test:e2e`) ---
# They run on their own `pactlab_e2e` database and ports; defaults match infra/local.
# Owner (migration) connection; only the host, port and credentials are used.
# E2E_DATABASE_MIGRATION_URL=
# Runtime (pactlab_api) connection; only the host, port and credentials are used.
# E2E_DATABASE_URL=
# E2E_REDIS_URL=
# Ports for the e2e API and web servers (default 4400 and 3400).
# E2E_API_PORT=
# E2E_WEB_PORT=
