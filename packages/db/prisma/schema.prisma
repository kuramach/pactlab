// Pactlab system of record. Every deal-scoped row carries organization_id and
// deal_id; composite foreign keys make cross-tenant references impossible.
// Row-level security policies live in the SQL migrations (see migrations/).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  PUBLIC_ACQUIRER
  PRIVATE_ACQUIRER
  TAKE_PRIVATE

  @@map("transaction_type")
}

enum PartyRole {
  BUYER
  SELLER

  @@map("party_role")
}

enum CompanyOwnership {
  PUBLIC
  PRIVATE

  @@map("company_ownership")
}

enum CompanyType {
  SOFTWARE_SAAS
  FINTECH
  HEALTHCARE
  TELECOM_MEDIA
  PROFESSIONAL_SERVICES
  PHARMA_BIOTECH
  ECOMMERCE_DTC
  MULTIFAMILY
  COMMERCIAL_PROPERTY
  HOTELS
  SMALL_CLINICS
  HOSPITALS
  OTHER

  @@map("company_type")
}

enum ComparableKind {
  PRECEDENT_TRANSACTION
  PUBLIC_PEER
  OWN_DEAL

  @@map("comparable_kind")
}

enum ComparableOrigin {
  OWN_DEAL
  ENTERED
  PROVIDER
  SYNTHETIC

  @@map("comparable_origin")
}

enum ComparableStatus {
  ACTIVE
  RETIRED

  @@map("comparable_status")
}

enum ArrBasis {
  ARR
  REVENUE

  @@map("arr_basis")
}

enum AnchorStatus {
  ACTIVE
  REMOVED

  @@map("anchor_status")
}

enum BalanceSheetKind {
  CASH
  DEBT
  DEBT_LIKE

  @@map("balance_sheet_kind")
}

enum BalanceSheetItemStatus {
  ACTIVE
  WITHDRAWN

  @@map("balance_sheet_item_status")
}

enum ContributorStatus {
  CURRENT
  DEPARTED
  UNKNOWN

  @@map("contributor_status")
}

enum MultipleVerdict {
  IN_RANGE
  HIGH
  LOW

  @@map("multiple_verdict")
}

enum ImportTarget {
  BILLING_INVOICE_LINE
  FINTECH_LOAN_TAPE
  FINTECH_AML_ALERT
  MULTIFAMILY_RENT_ROLL
  MULTIFAMILY_T12
  MULTIFAMILY_DELINQUENCY
  MULTIFAMILY_INSPECTION

  @@map("import_target")
}

enum SourceUploadStatus {
  UPLOADED
  IMPORTED
  REJECTED
  PURGED

  @@map("source_upload_status")
}

enum AskingBasis {
  ENTERPRISE_VALUE
  EQUITY_VALUE

  @@map("asking_basis")
}

enum AskingSource {
  TEASER
  MANAGEMENT
  LETTER_OF_INTENT
  BANKER
  OTHER

  @@map("asking_source")
}

enum OrganizationAuthMethod {
  AUTH0
  EMAIL_CODE

  @@map("organization_auth_method")
}

enum OrganizationStatus {
  ACTIVE
  PENDING_APPROVAL
  SUSPENDED

  @@map("organization_status")
}

enum OrganizationOrigin {
  OPERATOR
  SIGNUP

  @@map("organization_origin")
}

enum OrganizationRole {
  ORG_OWNER
  ORG_ADMIN
  MEMBER

  @@map("organization_role")
}

enum DealRole {
  DEAL_LEAD
  ANALYST
  REVIEWER
  ADVISER
  TARGET_CONTRIBUTOR
  VIEWER

  @@map("deal_role")
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED

  @@map("membership_status")
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTERED

  @@map("job_status")
}

enum ConnectionMode {
  FIXTURE
  LIVE

  @@map("connection_mode")
}

enum ConnectionStatus {
  ACTIVE
  DISABLED

  @@map("connection_status")
}

enum SyncRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED

  @@map("sync_run_status")
}

enum EvidenceVisibility {
  BUYER_ONLY
  SHARED

  @@map("evidence_visibility")
}

enum FindingDomain {
  ARCHITECTURE
  MAINTAINABILITY
  SECURITY
  OSS_LICENSE
  TEST_QUALITY
  OPERATIONS
  CODE_PROVENANCE
  KEY_PERSON
  FINANCIAL
  COMMERCIAL
  OPERATIONAL
  REGULATORY
  LEGAL
  PROPERTY
  PEOPLE

  @@map("finding_domain")
}

enum FindingSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("finding_severity")
}

enum FindingConfidence {
  LOW
  MEDIUM
  HIGH

  @@map("finding_confidence")
}

enum FindingStatus {
  DRAFT
  IN_REVIEW
  ACCEPTED
  REJECTED

  @@map("finding_status")
}

enum FindingOrigin {
  SCANNER
  HEURISTIC
  AI
  HUMAN

  @@map("finding_origin")
}

enum ReviewDecision {
  SUBMITTED
  SUPPORT_REQUESTED
  ACCEPTED
  REJECTED

  @@map("review_decision")
}

enum PricedRiskType {
  PRICE_REDUCTION
  ESCROW
  INDEMNITY
  REMEDIATION_COST

  @@map("priced_risk_type")
}

enum ScenarioStatus {
  DRAFT
  SUBMITTED
  APPROVED

  @@map("scenario_status")
}

enum SubmissionDecisionKind {
  APPROVED
  REJECTED

  @@map("submission_decision")
}

enum DataClassification {
  PUBLIC
  BUSINESS
  FINANCIAL
  HR
  COMPENSATION
  PERFORMANCE
  NAMED_CONTRIBUTION

  @@map("data_classification")
}

enum RetentionClass {
  DEAL_TERM
  SHORT_90D
  LEGAL_HOLD

  @@map("retention_class")
}

enum DocumentStatus {
  AVAILABLE
  PURGED

  @@map("document_status")
}

enum AiRunStatus {
  SUCCEEDED
  SCHEMA_INVALID
  PROVIDER_ERROR

  @@map("ai_run_status")
}

enum DocumentFindingStatus {
  DRAFT
  ACCEPTED
  REJECTED

  @@map("document_finding_status")
}

enum DocumentFindingKind {
  PARTY
  DATE
  CLAUSE

  @@map("document_finding_kind")
}

enum DocumentReviewDecision {
  ACCEPT
  REJECT

  @@map("document_review_decision")
}

enum EvidenceEdgeType {
  SUPERSEDES
  DERIVED_FROM

  @@map("evidence_edge_type")
}

model Organization {
  id                  String                 @id @default(uuid(7)) @db.Uuid
  name                String
  slug                String                 @unique
  /// External identity-provider organization reference (Auth0 `org_id` claim).
  /// Set exactly when the organization signs in through Auth0 (CHECK in migration).
  auth0OrganizationId String?                @unique @map("auth0_organization_id")
  /// How members sign in. Tokens from the other method never reach this organization.
  authMethod          OrganizationAuthMethod @default(AUTH0) @map("auth_method")
  /// Only ACTIVE organizations can be entered; sign-ups start PENDING_APPROVAL.
  status              OrganizationStatus     @default(ACTIVE)
  /// The organization asked for company SSO (Auth0) at sign-up; set up by an operator.
  ssoRequested        Boolean                @default(false) @map("sso_requested")
  createdVia          OrganizationOrigin     @default(OPERATOR) @map("created_via")
  region              String                 @default("us-east-1")
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships             OrganizationMembership[]
  deals                   Deal[]
  dealMemberships         DealMembership[]
  auditEvents             AuditEvent[]
  outboxEvents            OutboxEvent[]
  jobRuns                 JobRun[]
  storedFiles             StoredFile[]
  connections             Connection[]
  syncRuns                SyncRun[]
  evidenceItems           EvidenceItem[]
  evidenceEdges           EvidenceEdge[]
  citations               Citation[]
  findings                Finding[]
  findingLinks            FindingEvidenceLink[]
  findingReviews          FindingReview[]
  valuationScenarios      ValuationScenario[]
  valuationAssumptionSets ValuationAssumptionSet[]
  valuationRuns           ValuationRun[]
  valuationSubmissions    ValuationSubmission[]
  valuationDecisions      ValuationSubmissionDecision[]
  documents               Document[]
  documentPages           DocumentPage[]
  aiRuns                  AiRun[]
  documentFindings        DocumentFinding[]
  documentFindingReviews  DocumentFindingReview[]
  authSessions            AuthSession[]
  dealParties             DealParty[]
  sourceUploads           SourceUpload[]
  askingPrices            AskingPrice[]
  comparables             Comparable[]
  multipleJudgements      MultipleJudgement[]
  negotiationAnchors      NegotiationAnchor[]
  balanceSheetItems       BalanceSheetItem[]
  balanceSheetItemVersions BalanceSheetItemVersion[]
  contributorIdentities   ContributorIdentity[]
  peopleAccess            PeopleAccess[]

  @@map("organizations")
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  /// Verified `sub` claim: Auth0 subject, or `pactlab|<user id>` for email-code sign-in.
  auth0Subject String   @unique @map("auth0_subject")
  /// Lowercased sign-in address for email-code organizations; never sent to models.
  email        String?  @unique
  displayName  String   @map("display_name")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organizationMemberships OrganizationMembership[]
  dealMemberships         DealMembership[]
  loginChallenges         LoginChallenge[]
  authSessions            AuthSession[]

  @@map("users")
}

model OrganizationMembership {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

model Deal {
  id              String          @id @default(uuid(7)) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  name            String
  targetName      String          @map("target_name")
  transactionType TransactionType @map("transaction_type")
  stage           String          @default("SCREENING")
  status          String          @default("ACTIVE")
  baseCurrency    String          @default("USD") @map("base_currency") @db.Char(3)
  createdBy       String          @map("created_by") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization            Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships             DealMembership[]
  jobRuns                 JobRun[]
  storedFiles             StoredFile[]
  auditEvents             AuditEvent[]
  outboxEvents            OutboxEvent[]
  connections             Connection[]
  syncRuns                SyncRun[]
  evidenceItems           EvidenceItem[]
  evidenceEdges           EvidenceEdge[]
  citations               Citation[]
  findings                Finding[]
  findingLinks            FindingEvidenceLink[]
  findingReviews          FindingReview[]
  valuationScenarios      ValuationScenario[]
  valuationAssumptionSets ValuationAssumptionSet[]
  valuationRuns           ValuationRun[]
  valuationSubmissions    ValuationSubmission[]
  valuationDecisions      ValuationSubmissionDecision[]
  documents               Document[]
  documentPages           DocumentPage[]
  aiRuns                  AiRun[]
  documentFindings        DocumentFinding[]
  documentFindingReviews  DocumentFindingReview[]
  parties                 DealParty[]
  sourceUploads           SourceUpload[]
  askingPrices            AskingPrice[]
  ownDealComparables      Comparable[]
  multipleJudgements      MultipleJudgement[]
  negotiationAnchors      NegotiationAnchor[]
  balanceSheetItems       BalanceSheetItem[]
  balanceSheetItemVersions BalanceSheetItemVersion[]
  contributorIdentities   ContributorIdentity[]
  peopleAccess            PeopleAccess[]
  screeningReview         ScreeningReview?
  claims                  DealClaim[]
  postCloseItems          PostCloseItem[]

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@map("deals")
}

/// The buying and selling entities of a Pact. One row per role per deal;
/// the deal's transaction type was derived from their ownership at creation.
model DealParty {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  dealId         String           @map("deal_id") @db.Uuid
  role           PartyRole
  name           String
  ownership      CompanyOwnership
  ticker         String?
  exchange       String?
  website        String?
  companyType    CompanyType?     @map("company_type")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, dealId, role])
  @@map("deal_parties")
}

model DealMembership {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  dealId         String           @map("deal_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           DealRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, dealId, userId])
  @@index([userId])
  @@map("deal_memberships")
}

/// Append-only, hash-chained audit trail. UPDATE and DELETE are revoked.
model AuditEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String?  @map("deal_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  targetType     String   @map("target_type")
  targetId       String?  @map("target_id")
  outcome        String
  requestId      String?  @map("request_id")
  ipAddress      String?  @map("ip_address")
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  /// Chain fields are assigned by the audit_events_chain trigger; client values are overwritten.
  chainSeq       BigInt   @default(0) @map("chain_seq")
  prevHash       String?  @map("prev_hash")
  hash           String   @default("")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal?        @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, occurredAt])
  @@index([organizationId, dealId, occurredAt])
  @@map("audit_events")
}

/// Transactional outbox: domain events written in the same transaction as the change.
model OutboxEvent {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  dealId         String?   @map("deal_id") @db.Uuid
  aggregateType  String    @map("aggregate_type")
  aggregateId    String    @map("aggregate_id")
  eventType      String    @map("event_type")
  payload        Json
  idempotencyKey String    @map("idempotency_key")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal?        @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

/// Durable record of async jobs; uniqueness on idempotency key makes replays safe.
model JobRun {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  dealId         String    @map("deal_id") @db.Uuid
  type           String
  schemaVersion  Int       @map("schema_version")
  idempotencyKey String    @map("idempotency_key")
  status         JobStatus @default(QUEUED)
  attempt        Int       @default(0)
  requestedBy    String    @map("requested_by") @db.Uuid
  correlationId  String    @map("correlation_id")
  errorClass     String?   @map("error_class")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, dealId, idempotencyKey])
  @@map("job_runs")
}

/// Metadata for tenant-scoped objects. Bytes live in the object store under
/// `<organization_id>/<deal_id>/...`; a check constraint enforces the prefix.
model StoredFile {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  objectKey      String   @map("object_key")
  fileName       String   @map("file_name")
  contentType    String   @map("content_type")
  sizeBytes      BigInt   @map("size_bytes")
  sha256         String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)

  @@unique([objectKey])
  @@map("stored_files")
}

/// A source connected to a deal. Mode is persisted and every change audited;
/// downstream logic never branches on it. Secrets live in the managed store —
/// only a revocable reference is kept here.
model Connection {
  id                 String             @id @default(uuid(7)) @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  dealId             String             @map("deal_id") @db.Uuid
  provider           String
  displayName        String             @map("display_name")
  mode               ConnectionMode
  credentialRef      String?            @map("credential_ref")
  /// Provider-specific, non-secret settings (e.g. which datasets to read).
  config             Json
  status             ConnectionStatus   @default(ACTIVE)
  /// Default visibility of evidence this connection produces.
  evidenceVisibility EvidenceVisibility @default(BUYER_ONLY) @map("evidence_visibility")
  createdBy          String             @map("created_by") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal          Deal           @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  syncRuns      SyncRun[]
  evidenceItems EvidenceItem[]
  sourceUploads SourceUpload[]

  @@unique([organizationId, dealId, id])
  @@index([organizationId, dealId, createdAt])
  @@map("connections")
}

/// One idempotent pull from a connection. Replaying the same idempotency key
/// returns the existing run; re-pulling unchanged records creates nothing.
model SyncRun {
  id               String        @id @default(uuid(7)) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  dealId           String        @map("deal_id") @db.Uuid
  connectionId     String        @map("connection_id") @db.Uuid
  connectorVersion String        @map("connector_version")
  idempotencyKey   String        @map("idempotency_key")
  status           SyncRunStatus @default(QUEUED)
  cursor           String?
  recordsSeen      Int           @default(0) @map("records_seen")
  recordsCreated   Int           @default(0) @map("records_created")
  recordsUnchanged Int           @default(0) @map("records_unchanged")
  issuesCount      Int           @default(0) @map("issues_count")
  errorClass       String?       @map("error_class")
  requestedBy      String        @map("requested_by") @db.Uuid
  correlationId    String        @map("correlation_id")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt        DateTime?     @map("started_at") @db.Timestamptz(3)
  completedAt      DateTime?     @map("completed_at") @db.Timestamptz(3)

  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal               Deal           @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  connection         Connection     @relation(fields: [organizationId, dealId, connectionId], references: [organizationId, dealId, id], onDelete: Restrict)
  firstEvidenceItems EvidenceItem[] @relation("FirstSyncRun")
  lastEvidenceItems  EvidenceItem[] @relation("LastSyncRun")

  @@unique([organizationId, dealId, id])
  @@unique([organizationId, dealId, idempotencyKey])
  @@index([organizationId, dealId, connectionId, createdAt])
  @@map("sync_runs")
}

/// Normalized evidence. Immutable except for last-seen and sharing columns;
/// changed source content creates a new item linked by a SUPERSEDES edge.
model EvidenceItem {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  dealId         String             @map("deal_id") @db.Uuid
  connectionId   String             @map("connection_id") @db.Uuid
  firstSyncRunId String             @map("first_sync_run_id") @db.Uuid
  lastSyncRunId  String             @map("last_sync_run_id") @db.Uuid
  evidenceType   String             @map("evidence_type")
  sourceSystem   String             @map("source_system")
  sourceRecordId String             @map("source_record_id")
  observedAt     DateTime?          @map("observed_at") @db.Timestamptz(3)
  canonical      Json
  /// sha256 of the canonical JSON.
  contentHash    String             @map("content_hash") @db.Char(64)
  sensitivity    String             @default("STANDARD")
  visibility     EvidenceVisibility @default(BUYER_ONLY)
  sharedBy       String?            @map("shared_by") @db.Uuid
  sharedAt       DateTime?          @map("shared_at") @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal                  @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  connection   Connection            @relation(fields: [organizationId, dealId, connectionId], references: [organizationId, dealId, id], onDelete: Restrict)
  firstSyncRun SyncRun               @relation("FirstSyncRun", fields: [organizationId, dealId, firstSyncRunId], references: [organizationId, dealId, id], onDelete: Restrict)
  lastSyncRun  SyncRun               @relation("LastSyncRun", fields: [organizationId, dealId, lastSyncRunId], references: [organizationId, dealId, id], onDelete: Restrict)
  citations    Citation[]
  edgesFrom    EvidenceEdge[]        @relation("EdgeFrom")
  edgesTo      EvidenceEdge[]        @relation("EdgeTo")
  findingLinks FindingEvidenceLink[]

  @@unique([organizationId, dealId, id])
  @@unique([organizationId, dealId, connectionId, sourceRecordId, contentHash])
  @@index([organizationId, dealId, evidenceType])
  @@index([organizationId, dealId, connectionId, sourceRecordId])
  @@map("evidence_items")
}

/// Relational lineage between evidence items; traversed with recursive CTEs.
model EvidenceEdge {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  dealId         String           @map("deal_id") @db.Uuid
  fromEvidenceId String           @map("from_evidence_id") @db.Uuid
  toEvidenceId   String           @map("to_evidence_id") @db.Uuid
  edgeType       EvidenceEdgeType @map("edge_type")
  reason         String
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  from         EvidenceItem @relation("EdgeFrom", fields: [organizationId, dealId, fromEvidenceId], references: [organizationId, dealId, id], onDelete: Restrict)
  to           EvidenceItem @relation("EdgeTo", fields: [organizationId, dealId, toEvidenceId], references: [organizationId, dealId, id], onDelete: Restrict)

  @@unique([organizationId, dealId, fromEvidenceId, toEvidenceId, edgeType])
  @@index([organizationId, dealId, toEvidenceId])
  @@map("evidence_edges")
}

/// Exact pointer into a source (CSV row today; document pages arrive later)
/// plus the hash of the quoted source text, verified at display time.
model Citation {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  evidenceItemId String   @map("evidence_item_id") @db.Uuid
  locator        Json
  quoteHash      String   @map("quote_hash") @db.Char(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  evidenceItem EvidenceItem @relation(fields: [organizationId, dealId, evidenceItemId], references: [organizationId, dealId, id], onDelete: Restrict)

  @@unique([organizationId, dealId, evidenceItemId, quoteHash])
  @@map("citations")
}

/// Buyer-side finding. Status changes only through human reviews; every
/// change bumps `version` (optimistic concurrency). Priced-risk amounts are
/// numeric with explicit currency, all-or-none (CHECK in the migration).
model Finding {
  id                 String            @id @default(uuid(7)) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  dealId             String            @map("deal_id") @db.Uuid
  domain             FindingDomain
  title              String
  description        String
  severity           FindingSeverity
  confidence         FindingConfidence
  status             FindingStatus     @default(DRAFT)
  origin             FindingOrigin
  /// Stable signal identity; replaying a scan yields the same fingerprint.
  fingerprint        String
  pricedRiskType     PricedRiskType?   @map("priced_risk_type")
  pricedRiskCurrency String?           @map("priced_risk_currency") @db.Char(3)
  pricedRiskLow      Decimal?          @map("priced_risk_low") @db.Decimal(19, 4)
  pricedRiskHigh     Decimal?          @map("priced_risk_high") @db.Decimal(19, 4)
  pricedRiskBasis    String?           @map("priced_risk_basis")
  /// Valuation direction: -1 drag, 0 neutral, 1 cushion; null until decided.
  direction          Int?              @db.SmallInt
  /// What a cushion confirms ("value confirmed, not price paid").
  valueDriver        String?           @map("value_driver")
  valueBasis         String?           @map("value_basis")
  valueLow           Decimal?          @map("value_low") @db.Decimal(19, 4)
  valueHigh          Decimal?          @map("value_high") @db.Decimal(19, 4)
  valueCurrency      String?           @map("value_currency") @db.Char(3)
  /// Why a finding is neutral, or why a reviewer changed its proposed direction.
  directionRationale String?           @map("direction_rationale")
  /// The FindingActor that drafted it (HUMAN, AI or SYSTEM).
  createdBy          Json              @map("created_by")
  /// Finding version whose evidence link set is current.
  evidenceVersion    Int               @map("evidence_version")
  version            Int
  createdAt          DateTime          @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @map("updated_at") @db.Timestamptz(3)

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal          Deal                  @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  evidenceLinks FindingEvidenceLink[]
  reviews       FindingReview[]

  @@unique([organizationId, dealId, id])
  @@unique([organizationId, dealId, fingerprint])
  @@index([organizationId, dealId, status, domain])
  @@map("findings")
}

/// Insert-only provenance: evidence item, exact commit and versioned tool.
/// An edit appends a new set stamped with the finding version; earlier sets
/// remain as history.
model FindingEvidenceLink {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  findingId      String   @map("finding_id") @db.Uuid
  findingVersion Int      @map("finding_version")
  ordinal        Int
  /// Null when the link cites a document page instead (`documentCitation`).
  evidenceItemId String?  @map("evidence_item_id") @db.Uuid
  /// ResolvedCitation of a document page quote: documentId, pageNumber, quote, quoteHash, charStart, charEnd.
  documentCitation Json? @map("document_citation")
  /// Null when the cited evidence is not code (pack evidence, ADR 0010).
  commitSha      String?  @map("commit_sha")
  toolName       String   @map("tool_name")
  toolVersion    String   @map("tool_version")
  rulesetVersion String?  @map("ruleset_version")
  /// Repository-relative path; never file contents.
  path           String?
  lineStart      Int?     @map("line_start")
  lineEnd        Int?     @map("line_end")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  finding      Finding      @relation(fields: [organizationId, dealId, findingId], references: [organizationId, dealId, id], onDelete: Restrict)
  evidenceItem EvidenceItem? @relation(fields: [organizationId, dealId, evidenceItemId], references: [organizationId, dealId, id], onDelete: Restrict)

  @@unique([organizationId, dealId, findingId, findingVersion, ordinal])
  @@index([organizationId, dealId, evidenceItemId])
  @@map("finding_evidence_links")
}

/// Append-only human decision on a finding.
model FindingReview {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  dealId         String         @map("deal_id") @db.Uuid
  findingId      String         @map("finding_id") @db.Uuid
  decision       ReviewDecision
  fromStatus     FindingStatus  @map("from_status")
  toStatus       FindingStatus  @map("to_status")
  reviewerUserId String         @map("reviewer_user_id") @db.Uuid
  reviewerRole   DealRole       @map("reviewer_role")
  rationale      String
  /// Direction decided on acceptance; null for other decisions.
  direction          Int?     @db.SmallInt
  directionRationale String?  @map("direction_rationale")
  decidedAt      DateTime       @map("decided_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  finding      Finding      @relation(fields: [organizationId, dealId, findingId], references: [organizationId, dealId, id], onDelete: Restrict)

  @@index([organizationId, dealId, findingId, decidedAt])
  @@map("finding_reviews")
}

/// Valuation scenario. DRAFT is editable; submission freezes the latest run.
/// Every change bumps `version` (optimistic concurrency).
model ValuationScenario {
  id                String          @id @default(uuid(7)) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  dealId            String          @map("deal_id") @db.Uuid
  name              String
  currency          String          @db.Char(3)
  transactionType   TransactionType @map("transaction_type")
  status            ScenarioStatus  @default(DRAFT)
  assumptionVersion Int             @map("assumption_version")
  createdBy         String          @map("created_by") @db.Uuid
  createdAt         DateTime        @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @map("updated_at") @db.Timestamptz(3)
  version           Int

  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal           Deal                     @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  assumptionSets ValuationAssumptionSet[]
  runs           ValuationRun[]
  submissions    ValuationSubmission[]

  @@unique([organizationId, dealId, id])
  @@index([organizationId, dealId, createdAt])
  @@map("valuation_scenarios")
}

/// Insert-only, versioned assumption set. Values are decimal strings in JSON.
model ValuationAssumptionSet {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  scenarioId     String   @map("scenario_id") @db.Uuid
  version        Int
  values         Json
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal              @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  scenario     ValuationScenario @relation(fields: [organizationId, dealId, scenarioId], references: [organizationId, dealId, id], onDelete: Restrict)

  @@unique([organizationId, dealId, scenarioId, version])
  @@map("valuation_assumption_sets")
}

/// Insert-only engine run: the full resolved inputs and the result produced.
model ValuationRun {
  id                String   @id @default(uuid(7)) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  dealId            String   @map("deal_id") @db.Uuid
  scenarioId        String   @map("scenario_id") @db.Uuid
  assumptionVersion Int      @map("assumption_version")
  inputs            Json
  result            Json
  ranBy             String   @map("ran_by") @db.Uuid
  ranAt             DateTime @map("ran_at") @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal                  @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  scenario     ValuationScenario     @relation(fields: [organizationId, dealId, scenarioId], references: [organizationId, dealId, id], onDelete: Restrict)
  submissions  ValuationSubmission[]

  @@unique([organizationId, dealId, id])
  @@index([organizationId, dealId, scenarioId, ranAt])
  @@map("valuation_runs")
}

/// Frozen submission. `canonical` is stored and served byte-for-byte; a
/// CHECK ties it to its SHA-256 digest.
model ValuationSubmission {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  scenarioId     String   @map("scenario_id") @db.Uuid
  runId          String   @map("run_id") @db.Uuid
  canonical      String
  digest         String   @db.Char(64)
  submittedBy    String   @map("submitted_by") @db.Uuid
  submittedAt    DateTime @map("submitted_at") @db.Timestamptz(3)

  organization Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal                          @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  scenario     ValuationScenario             @relation(fields: [organizationId, dealId, scenarioId], references: [organizationId, dealId, id], onDelete: Restrict)
  run          ValuationRun                  @relation(fields: [organizationId, dealId, runId], references: [organizationId, dealId, id], onDelete: Restrict)
  decisions    ValuationSubmissionDecision[]

  @@unique([organizationId, dealId, id])
  @@index([organizationId, dealId, scenarioId, submittedAt])
  @@map("valuation_submissions")
}

/// Append-only human decision on a submission.
model ValuationSubmissionDecision {
  id             String                 @id @default(uuid(7)) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  dealId         String                 @map("deal_id") @db.Uuid
  submissionId   String                 @map("submission_id") @db.Uuid
  decision       SubmissionDecisionKind
  rationale      String
  decidedBy      String                 @map("decided_by") @db.Uuid
  decidedRole    DealRole               @map("decided_role")
  decidedAt      DateTime               @map("decided_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal                @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  submission   ValuationSubmission @relation(fields: [organizationId, dealId, submissionId], references: [organizationId, dealId, id], onDelete: Restrict)

  @@index([organizationId, dealId, submissionId, decidedAt])
  @@map("valuation_submission_decisions")
}

/// Uploaded document metadata. Bytes live in the object store under the
/// tenant/deal prefix (CHECK in the migration). Target uploads are SHARED.
model Document {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  dealId         String             @map("deal_id") @db.Uuid
  fileName       String             @map("file_name")
  contentType    String             @map("content_type")
  sizeBytes      Int                @map("size_bytes")
  sha256         String             @db.Char(64)
  objectKey      String             @map("object_key")
  pageCount      Int                @map("page_count")
  dataClass      DataClassification @map("data_class")
  /// Per-document AI exclusion; always true for prohibited data classes.
  aiExcluded     Boolean            @map("ai_excluded")
  retentionClass RetentionClass     @map("retention_class")
  retainUntil    DateTime?          @map("retain_until") @db.Timestamptz(3)
  visibility     EvidenceVisibility
  malwareScanner String             @map("malware_scanner")
  status         DocumentStatus     @default(AVAILABLE)
  uploadedBy     String             @map("uploaded_by") @db.Uuid
  createdAt      DateTime           @map("created_at") @db.Timestamptz(3)
  purgedAt       DateTime?          @map("purged_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal              @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  pages        DocumentPage[]
  findings     DocumentFinding[]

  @@unique([organizationId, dealId, id])
  @@unique([objectKey])
  @@index([organizationId, dealId, sha256])
  @@map("documents")
}

/// Extracted page. The page id is the citation source id; purge nulls the
/// text but keeps number and checksum for provenance.
model DocumentPage {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  dealId         String  @map("deal_id") @db.Uuid
  documentId     String  @map("document_id") @db.Uuid
  pageNumber     Int     @map("page_number")
  text           String?
  checksum       String  @db.Char(64)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  document     Document     @relation(fields: [organizationId, dealId, documentId], references: [organizationId, dealId, id], onDelete: Restrict)

  @@unique([organizationId, dealId, documentId, pageNumber])
  @@map("document_pages")
}

/// Insert-only record of one model invocation: hashes and counts only, never
/// prompt or document content.
model AiRun {
  id               String      @id @default(uuid(7)) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  dealId           String      @map("deal_id") @db.Uuid
  taskType         String      @map("task_type")
  promptId         String      @map("prompt_id")
  promptVersion    String      @map("prompt_version")
  promptHash       String      @map("prompt_hash")
  modelAlias       String      @map("model_alias")
  resolvedModelId  String      @map("resolved_model_id")
  inputHashes      String[]    @map("input_hashes")
  outputHash       String?     @map("output_hash")
  status           AiRunStatus
  repairAttempted  Boolean     @map("repair_attempted")
  injectionSignals Int         @map("injection_signals")
  inputTokens      Int         @map("input_tokens")
  outputTokens     Int         @map("output_tokens")
  latencyMs        Int         @map("latency_ms")
  createdAt        DateTime    @map("created_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal              @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  findings     DocumentFinding[]

  @@unique([organizationId, dealId, id])
  @@index([organizationId, dealId, createdAt])
  @@map("ai_runs")
}

/// AI-drafted document finding. Exact citations are stored with it; only a
/// named human moves it out of DRAFT.
model DocumentFinding {
  id                  String                @id @default(uuid(7)) @db.Uuid
  organizationId      String                @map("organization_id") @db.Uuid
  dealId              String                @map("deal_id") @db.Uuid
  documentId          String                @map("document_id") @db.Uuid
  aiRunId             String                @map("ai_run_id") @db.Uuid
  origin              String
  kind                DocumentFindingKind
  subtype             String
  domain              String
  title               String
  summary             String
  severity            FindingSeverity
  status              DocumentFindingStatus @default(DRAFT)
  fingerprint         String
  /// ResolvedCitation[]: page, offsets, quote and quote hash.
  citations           Json
  promptId            String                @map("prompt_id")
  promptVersion       String                @map("prompt_version")
  promptHash          String                @map("prompt_hash")
  resolvedModelId     String                @map("resolved_model_id")
  createdBy           String                @map("created_by") @db.Uuid
  reviewerUserId      String?               @map("reviewer_user_id") @db.Uuid
  reviewerDisplayName String?               @map("reviewer_display_name")
  decidedAt           DateTime?             @map("decided_at") @db.Timestamptz(3)
  version             Int
  createdAt           DateTime              @map("created_at") @db.Timestamptz(3)

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal                    @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  document     Document                @relation(fields: [organizationId, dealId, documentId], references: [organizationId, dealId, id], onDelete: Restrict)
  aiRun        AiRun                   @relation(fields: [organizationId, dealId, aiRunId], references: [organizationId, dealId, id], onDelete: Restrict)
  reviews      DocumentFindingReview[]

  @@unique([organizationId, dealId, id])
  @@unique([organizationId, dealId, documentId, fingerprint])
  @@index([organizationId, dealId, status])
  @@map("document_findings")
}

/// Append-only named human decision on a document finding.
model DocumentFindingReview {
  id                  String                 @id @default(uuid(7)) @db.Uuid
  organizationId      String                 @map("organization_id") @db.Uuid
  dealId              String                 @map("deal_id") @db.Uuid
  findingId           String                 @map("finding_id") @db.Uuid
  decision            DocumentReviewDecision
  reviewerUserId      String                 @map("reviewer_user_id") @db.Uuid
  reviewerDisplayName String                 @map("reviewer_display_name")
  rationale           String
  decidedAt           DateTime               @map("decided_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal            @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  finding      DocumentFinding @relation(fields: [organizationId, dealId, findingId], references: [organizationId, dealId, id], onDelete: Restrict)

  @@index([organizationId, dealId, findingId, decidedAt])
  @@map("document_finding_reviews")
}

/// Pre-authentication state for email-code sign-in. Reached only through
/// SECURITY DEFINER functions; the runtime role has no table privileges.
/// Holds an HMAC of the code, never the code.
model LoginChallenge {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  codeHash   String    @map("code_hash") @db.Char(64)
  ipHash     String    @map("ip_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([ipHash, createdAt])
  @@map("login_challenges")
}

/// Server-side record of an email-code session. Every Pactlab-issued token
/// names its session, so revocation takes effect on the next request.
model AuthSession {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// Null until the user picks one of several email-code organizations.
  organizationId String?   @map("organization_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("auth_sessions")
}

/// Pending self-serve sign-up: details plus an HMAC of the emailed code.
/// Reached only through SECURITY DEFINER functions; the runtime role has no
/// table privileges. The organization is created only when the code verifies.
model SignupChallenge {
  id               String    @id @default(uuid(7)) @db.Uuid
  email            String
  displayName      String    @map("display_name")
  organizationName String    @map("organization_name")
  ssoRequested     Boolean   @map("sso_requested")
  codeHash         String    @map("code_hash") @db.Char(64)
  ipHash           String    @map("ip_hash") @db.Char(64)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts         Int       @default(0)
  consumedAt       DateTime? @map("consumed_at") @db.Timestamptz(3)
  /// Set when the code verified and the organization was created.
  organizationId   String?   @map("organization_id") @db.Uuid

  @@index([email, createdAt])
  @@index([ipHash, createdAt])
  @@map("signup_challenges")
}

/// An uploaded billing export and how its columns map to the Pactlab
/// standard invoice line. Imports run through the idempotent sync engine on
/// a `billing_upload` connection; the mapping is kept for lineage.
model SourceUpload {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  dealId         String             @map("deal_id") @db.Uuid
  connectionId   String?            @map("connection_id") @db.Uuid
  target         ImportTarget
  system         String
  fileName       String             @map("file_name")
  sha256         String             @db.Char(64)
  sizeBytes      Int                @map("size_bytes")
  rowCount       Int                @map("row_count")
  header         Json
  /// CSV | TSV | XLSX: how the stored original is read (T-075).
  format         String             @default("CSV")
  /// Workbook sheet read, for XLSX uploads.
  sheet          String?
  mapping        Json?
  mappingVersion String?            @map("mapping_version")
  objectKey      String?            @map("object_key")
  status         SourceUploadStatus @default(UPLOADED)
  syncRunId      String?            @map("sync_run_id") @db.Uuid
  visibility     EvidenceVisibility
  uploadedBy     String             @map("uploaded_by") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  importedAt     DateTime?          @map("imported_at") @db.Timestamptz(3)
  purgedAt       DateTime?          @map("purged_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  connection   Connection?  @relation(fields: [organizationId, dealId, connectionId], references: [organizationId, dealId, id], onDelete: Restrict)

  @@unique([organizationId, dealId, id])
  @@index([organizationId, dealId, createdAt])
  @@map("source_uploads")
}

/// The seller's asking price for a deal. Append-only: a revision is a new
/// version and the highest version is current. Buyer-side only.
model AskingPrice {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  dealId         String       @map("deal_id") @db.Uuid
  version        Int
  amount         Decimal      @db.Decimal(24, 4)
  currency       String       @db.Char(3)
  basis          AskingBasis
  source         AskingSource
  quotedOn       DateTime?    @map("quoted_on") @db.Date
  earnOutAmount  Decimal?     @map("earn_out_amount") @db.Decimal(24, 4)
  note           String?
  recordedBy     String       @map("recorded_by") @db.Uuid
  recordedAt     DateTime     @default(now()) @map("recorded_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, dealId, version])
  @@map("asking_prices")
}

/// A comparable transaction or public peer: an EV ÷ ARR data point used to
/// give a valuation multiple context. Organization-wide and reusable across
/// deals. Every row says where it came from; entered rows cite a source.
/// Rows are never deleted or edited — they are retired.
model Comparable {
  id               String           @id @default(uuid(7)) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  kind             ComparableKind
  origin           ComparableOrigin
  name             String
  targetName       String           @map("target_name")
  acquirerName     String?          @map("acquirer_name")
  announcedOn      DateTime?        @map("announced_on") @db.Date
  companyType      CompanyType      @map("company_type")
  region           String?
  enterpriseValue  Decimal          @map("enterprise_value") @db.Decimal(24, 4)
  arr              Decimal          @db.Decimal(24, 4)
  /// Whether `arr` is annual recurring revenue or (as many announcements disclose) total revenue.
  arrBasis         ArrBasis         @default(ARR) @map("arr_basis")
  currency         String           @db.Char(3)
  arrGrowth        Decimal?         @map("arr_growth") @db.Decimal(9, 4)
  nrr              Decimal?         @db.Decimal(9, 4)
  grr              Decimal?         @db.Decimal(9, 4)
  sourceCitation   String?          @map("source_citation")
  sourceUrl        String?          @map("source_url")
  provider         String?
  providerVersion  String?          @map("provider_version")
  sourceDealId     String?          @map("source_deal_id") @db.Uuid
  status           ComparableStatus @default(ACTIVE)
  recordedBy       String           @map("recorded_by") @db.Uuid
  recordedAt       DateTime         @default(now()) @map("recorded_at") @db.Timestamptz(3)
  retiredBy        String?          @map("retired_by") @db.Uuid
  retiredAt        DateTime?        @map("retired_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sourceDeal   Deal?        @relation(fields: [organizationId, sourceDealId], references: [organizationId, id], onDelete: Restrict)
  anchors      NegotiationAnchor[]

  @@unique([organizationId, id])
  @@unique([organizationId, sourceDealId])
  @@index([organizationId, status, companyType])
  @@map("comparables")
}

/// The buy-side deal lead's judgement of the asking price against the
/// comparables: in range, high or low, with a rationale. Append-only; the
/// newest is current. Records the ask and comparable set it was made against.
model MultipleJudgement {
  id                   String          @id @default(uuid(7)) @db.Uuid
  organizationId       String          @map("organization_id") @db.Uuid
  dealId               String          @map("deal_id") @db.Uuid
  verdict              MultipleVerdict
  rationale            String
  askingVersion        Int?            @map("asking_version")
  askingMultiple       Decimal?        @map("asking_multiple") @db.Decimal(12, 2)
  benchmarkVersion     String          @map("benchmark_version")
  comparableSetHash    String          @map("comparable_set_hash")
  comparableCount      Int             @map("comparable_count")
  decidedBy            String          @map("decided_by") @db.Uuid
  decidedAt            DateTime        @default(now()) @map("decided_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, dealId, decidedAt])
  @@map("multiple_judgements")
}

/// A comparable the deal lead chose to cite against the seller's ask: the
/// target priced at that deal's multiple. Buyer side only; removed, never
/// deleted. The firm's own deals are confidential and never anchors.
model NegotiationAnchor {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  dealId         String       @map("deal_id") @db.Uuid
  comparableId   String       @map("comparable_id") @db.Uuid
  note           String?
  status         AnchorStatus @default(ACTIVE)
  addedBy        String       @map("added_by") @db.Uuid
  addedAt        DateTime     @default(now()) @map("added_at") @db.Timestamptz(3)
  removedBy      String?      @map("removed_by") @db.Uuid
  removedAt      DateTime?    @map("removed_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  comparable   Comparable   @relation(fields: [organizationId, comparableId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, dealId, status])
  @@map("negotiation_anchors")
}

/// A cash, debt or debt-like item for a deal, backed by an exact citation to
/// a document page. Scenarios link items; a revision bumps `version` (with a
/// row in the history) and makes linked results stale. Buyer side only.
model BalanceSheetItem {
  id             String                 @id @default(uuid(7)) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  dealId         String                 @map("deal_id") @db.Uuid
  kind           BalanceSheetKind
  category       String
  label          String
  amount         Decimal                @db.Decimal(24, 4)
  currency       String                 @db.Char(3)
  asOf           DateTime               @map("as_of") @db.Date
  /// ResolvedCitation: documentId, pageNumber, quote, quoteHash, charStart, charEnd.
  citation       Json
  note           String?
  /// Loan terms (DEBT items only; T-078). Rates are fractions: 0.075 = 7.5 %.
  interestRate   Decimal?               @map("interest_rate") @db.Decimal(9, 6)
  /// FIXED | FLOATING
  rateType       String?                @map("rate_type")
  rateReference  String?                @map("rate_reference")
  maturityDate   DateTime?              @map("maturity_date") @db.Date
  lender         String?
  /// AMORTIZING | BULLET | REVOLVING
  repayment      String?
  covenantNote   String?                @map("covenant_note")
  version        Int                    @default(1)
  status         BalanceSheetItemStatus @default(ACTIVE)
  createdBy      String                 @map("created_by") @db.Uuid
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedBy      String                 @map("updated_by") @db.Uuid
  updatedAt      DateTime               @default(now()) @map("updated_at") @db.Timestamptz(3)

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal                      @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  versions     BalanceSheetItemVersion[]

  @@unique([organizationId, dealId, id])
  @@index([organizationId, dealId, status])
  @@map("balance_sheet_items")
}

/// Every version of a balance-sheet item, with who changed it and why. Append-only.
model BalanceSheetItemVersion {
  id             String                 @id @default(uuid(7)) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  dealId         String                 @map("deal_id") @db.Uuid
  itemId         String                 @map("item_id") @db.Uuid
  version        Int
  kind           BalanceSheetKind
  category       String
  label          String
  amount         Decimal                @db.Decimal(24, 4)
  currency       String                 @db.Char(3)
  asOf           DateTime               @map("as_of") @db.Date
  citation       Json
  note           String?
  /// Loan terms (DEBT items only; T-078). Rates are fractions: 0.075 = 7.5 %.
  interestRate   Decimal?               @map("interest_rate") @db.Decimal(9, 6)
  /// FIXED | FLOATING
  rateType       String?                @map("rate_type")
  rateReference  String?                @map("rate_reference")
  maturityDate   DateTime?              @map("maturity_date") @db.Date
  lender         String?
  /// AMORTIZING | BULLET | REVOLVING
  repayment      String?
  covenantNote   String?                @map("covenant_note")
  status         BalanceSheetItemStatus
  reason         String
  changedBy      String                 @map("changed_by") @db.Uuid
  changedAt      DateTime               @default(now()) @map("changed_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal             @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  item         BalanceSheetItem @relation(fields: [organizationId, dealId, itemId], references: [organizationId, dealId, id], onDelete: Restrict)

  @@unique([organizationId, dealId, itemId, version])
  @@map("balance_sheet_item_versions")
}

/// The gated contributor directory: raw identities and names behind the
/// pseudonymous keys used in evidence. Written by the sync engine; read only
/// through the names gate (people_access), every read audited. Buyer side.
model ContributorIdentity {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  dealId         String            @map("deal_id") @db.Uuid
  contributorKey String            @map("contributor_key")
  system         String
  identity       String
  displayName    String?           @map("display_name")
  status         ContributorStatus @default(UNKNOWN)
  firstSeenAt    DateTime          @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt     DateTime          @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, dealId, system, identity])
  @@index([organizationId, dealId, contributorKey])
  @@map("contributor_identities")
}

/// Whether contributor names are shown on a deal, and why. Append-only; the
/// newest row decides. Only a deal lead records it.
model PeopleAccess {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  enabled        Boolean
  basis          String
  decidedBy      String   @map("decided_by") @db.Uuid
  decidedAt      DateTime @default(now()) @map("decided_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal         Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, dealId, decidedAt])
  @@map("people_access")
}

/// Pre-Diligence screening (T-071): one per deal, directional only — never
/// creates findings or touches valuation. Buyer side (RLS).
model ScreeningReview {
  id               String    @id @default(uuid(7)) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  dealId           String    @map("deal_id") @db.Uuid
  intakeNotes      String?   @map("intake_notes")
  headlineRevenue  Decimal?  @map("headline_revenue") @db.Decimal(24, 4)
  headlineCurrency String?   @map("headline_currency") @db.Char(3)
  valueLow         Decimal?  @map("value_low") @db.Decimal(24, 4)
  valueHigh        Decimal?  @map("value_high") @db.Decimal(24, 4)
  /// [{ id, text }]: red flags; GO turns each into a claim to verify.
  redFlags         Json      @default("[]") @map("red_flags")
  /// GO | NO_GO | NEEDS_MORE, once decided.
  verdict          String?
  rationale        String?
  gaps             String?
  decidedBy        String?   @map("decided_by") @db.Uuid
  decidedAt        DateTime? @map("decided_at") @db.Timestamptz(3)
  version          Int       @default(1)
  updatedBy        String    @map("updated_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  deal Deal @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict, map: "screening_reviews_deal_fkey")

  @@unique([organizationId, dealId])
  @@map("screening_reviews")
}

/// Said vs observed (T-071): a seller assertion and how evidence bears on it.
/// Links are ids of evidence items and findings — references, never copies.
model DealClaim {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  dealId          String   @map("deal_id") @db.Uuid
  statement       String
  source          String?
  /// SCREENING_RED_FLAG | MANUAL
  origin          String
  /// UNVERIFIED | VERIFIED | CONTRADICTED
  status          String   @default("UNVERIFIED")
  rationale       String?
  evidenceItemIds String[] @default([]) @map("evidence_item_ids") @db.Uuid
  findingIds      String[] @default([]) @map("finding_ids") @db.Uuid
  version         Int      @default(1)
  createdBy       String   @map("created_by") @db.Uuid
  updatedBy       String   @map("updated_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  deal Deal @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict, map: "deal_claims_deal_fkey")

  @@unique([organizationId, dealId, id])
  @@index([organizationId, dealId, createdAt])
  @@map("deal_claims")
}

/// Post-Close registers (T-071): assets to preserve, actions and watch items,
/// generated from diligence output when the deal closes. Idempotent by source.
model PostCloseItem {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  dealId         String    @map("deal_id") @db.Uuid
  /// ASSET | ACTION | WATCH
  kind           String
  /// FINDING
  sourceType     String    @map("source_type")
  sourceId       String    @map("source_id") @db.Uuid
  title          String
  action         String
  ownerUserId    String?   @map("owner_user_id") @db.Uuid
  dueDate        DateTime? @map("due_date") @db.Date
  /// MONTHLY | QUARTERLY | ANNUAL
  cadence        String?
  /// OPEN | DONE | LAPSED
  status         String    @default("OPEN")
  note           String?
  version        Int       @default(1)
  updatedBy      String    @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  deal Deal @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict, map: "post_close_items_deal_fkey")

  @@unique([organizationId, dealId, kind, sourceType, sourceId], map: "post_close_items_source_key")
  @@index([organizationId, dealId])
  @@map("post_close_items")
}
