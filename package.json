{
  "name": "pactlab",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@pactlab/web --filter=@pactlab/api --filter=@pactlab/worker",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:fixtures": "turbo run test:fixtures",
    "test:e2e": "pnpm --filter @pactlab/e2e test:e2e",
    "test:e2e:full": "pnpm --filter @pactlab/e2e test:e2e:full",
    "test:live": "pnpm --filter @pactlab/connectors test:live",
    "seed": "turbo run seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "local:up": "docker compose -f infra/local/docker-compose.yml up -d --wait",
    "local:down": "docker compose -f infra/local/docker-compose.yml down",
    "db:migrate": "pnpm --filter @pactlab/db migrate:deploy",
    "org:pending": "pnpm --silent --filter @pactlab/api ops:org pending",
    "org:approve": "pnpm --silent --filter @pactlab/api ops:org approve",
    "org:reject": "pnpm --silent --filter @pactlab/api ops:org reject",
    "ops:operator": "pnpm --silent --filter @pactlab/api ops:operator",
    "login:code": "pnpm --silent --filter @pactlab/api login:code",
    "ai:check": "pnpm --silent --filter @pactlab/api ai:check",
    "eval:live": "pnpm --silent --filter @pactlab/api eval:live",
    "kit:build": "pnpm --silent --filter @pactlab/api kit:build"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "6.0.3"
  }
}
