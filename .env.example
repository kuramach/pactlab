# Copy to .env (git-ignored). Variable NAMES and explanations only — never commit values.
# Local services: `pnpm local:up` starts PostgreSQL and Redis (see infra/local/).

# --- APP_* : environment and public origins ---
# One of: local, test, dev, qa, stage, production. Production fails closed on missing config.
APP_ENV=
# Origin of the web app, allowed by API CORS (e.g. the local Next.js dev server URL).
APP_WEB_ORIGIN=
# Where the API's /v1 is reachable from outside, for the MCP server. Leave empty: http://localhost:<API_PORT> locally, APP_WEB_ORIGIN when deployed.
API_PUBLIC_ORIGIN=
# Passkey sign-in: the host passkeys are bound to (e.g. app.pactlab.ai). Leave empty to use APP_WEB_ORIGIN's host.
WEBAUTHN_RP_ID=
# Log level: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=

# --- DATABASE_* : PostgreSQL ---
# Runtime login role (API, worker). Must be a member of `pactlab_app`, NOT a superuser, NOT BYPASSRLS.
DATABASE_URL=
# Schema-owner role used only by migrations and `pnpm seed`. Never given to runtime containers.
DATABASE_MIGRATION_URL=

# --- REDIS_* : BullMQ ---
# Redis connection URL for job queues (redis:// or rediss://).
REDIS_URL=

# --- AUTH0_* : identity ---
# Auth0 tenant domain (no scheme); tokens are verified against its JWKS.
AUTH0_DOMAIN=
# API audience identifier configured in Auth0.
AUTH0_AUDIENCE=
# Web sign-in (server-only): Auth0 Regular Web Application client ID.
AUTH0_CLIENT_ID=
# Web sign-in (server-only): Auth0 Regular Web Application client secret.
AUTH0_CLIENT_SECRET=
# Web sign-in (server-only): session-cookie encryption key, 32 bytes hex (`openssl rand -hex 32`).
AUTH0_SECRET=
# Web sign-in: public base URL of the web app; Auth0 callback/logout URLs derive from it.
APP_BASE_URL=

# --- Email-code sign-in (organizations that do not use Auth0) ---
# API secret that signs email-code session tokens and keys code hashes; at least
# 32 characters (`openssl rand -hex 32`). Rotating it signs everyone out.
AUTH_TOKEN_SECRET=
# Local only (APP_ENV=local): directory where sign-in emails are written as
# files instead of sent, e.g. a git-ignored path.
LOCAL_MAIL_DIR=
# Deployed environments (ADR 0019): `ses` sends through Amazon SES with the task
# role; EMAIL_FROM must be a verified SES identity, e.g. "Pactlab <no-reply@pactlab.ai>".
EMAIL_PROVIDER=
EMAIL_FROM=
# Deployed (T-109): the SES configuration set every send names, and the SNS topic its
# bounce/complaint/delivery events arrive on (POST /v1/email-events/sns). Both or neither.
EMAIL_CONFIGURATION_SET=
EMAIL_EVENTS_TOPIC_ARN=

# --- Self-serve sign-up ---
# "true" (default): new organizations wait for `pnpm org:approve <slug>`. "false": active at once.
SIGNUP_REQUIRES_APPROVAL=
# Address told about each new sign-up (with the approve command). Unset: use `pnpm org:pending`.
OPERATOR_EMAIL=

# --- Documents ---
# Local only (APP_ENV=local): directory for uploaded document originals, e.g. a
# git-ignored path.
DOCUMENT_STORE_DIR=
# Deployed environments (ADR 0019): `s3` keeps originals in the environment's
# evidence bucket, encrypted with its KMS key (task-role credentials). Without a
# store, uploads fail closed.
DOCUMENT_STORE=
DOCUMENT_BUCKET=
DOCUMENT_KMS_KEY_ID=
# `signature`: the built-in malware scanner, allowed in dev and qa only (local
# runs use it by default). Stage and production need a managed scanner.
MALWARE_SCANNER=

# --- Deployed tasks only: database credentials as separate secret fields ---
# Tasks build DATABASE_URL / DATABASE_MIGRATION_URL from these (TLS verified
# against the RDS bundle in the image). Leave unset locally; set the URLs instead.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_OWNER_USER=
DB_OWNER_PASSWORD=
# dev/qa seed only: plus-address the demo's email-code people on this real inbox
# (you+charlie-lead@domain), so they can sign in where email is really sent.
DEMO_INBOX=

# --- Provider credentials ---
# Local only: encrypted store for sellers' provider tokens. Set both or neither.
# Directory (git-ignored path, e.g. .data/secrets) and a 32-byte key, base64
# (generate with: openssl rand -base64 32). Unset: live connections that need
# a stored token fail closed.
LOCAL_SECRETS_DIR=
LOCAL_SECRETS_KEY=
# Pactlab's read-only GitHub App (docs/runbooks/github-app.md). Set all three or none.
# Numeric App ID, the slug from https://github.com/apps/<slug>, and the path to
# the private key converted to PKCS#8 PEM. Never commit the key.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=
# Pactlab's DocuSign app registration (docs/runbooks/docusign.md). Set all four or none.
# Customers connect their own DocuSign accounts; Pactlab never sends from one of its own.
# Integration key and secret from DocuSign Apps and Keys; the auth host is
# account-d.docusign.com (developer) or account.docusign.com (production); the Connect
# HMAC key verifies envelope events. Unset: e-signature uses the fixture outside production.
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_CLIENT_SECRET=
DOCUSIGN_AUTH_HOST=
DOCUSIGN_CONNECT_HMAC_KEY=
# E-signature (T-136, docs/runbooks/signing.md). Comma-separated adapters new envelopes may go out with, the first
# the default: fixture (test signing, never in production) and/or boldsign. Unset: fixture outside production, none in production.
SIGNING_PROVIDER=
# Pactlab's BoldSign API key (BoldSign -> Settings -> API Keys). Unset: BoldSign is off. The worker's polling sweep (T-144) reads it too.
BOLDSIGN_API_KEY=
# BoldSign's API origin for the account's region (https only). Unset: https://api.boldsign.com (US).
BOLDSIGN_API_BASE_URL=
# Signing secret of the BoldSign webhook registered for this deployment's public endpoint. Unset: polling carries status.
BOLDSIGN_WEBHOOK_SECRET=
# Until the production go, envelopes go only to these test recipients: addresses or @domains, comma-separated.
# Required whenever BoldSign is on and BOLDSIGN_PRODUCTION_SENDING is not true.
SIGNING_TEST_RECIPIENTS=
# true | false (default false): the production go, a separate decision: BoldSign may send to any counterparty.
BOLDSIGN_PRODUCTION_SENDING=
# Pactlab's OAuth clients for document sources (docs/runbooks/document-sources.md). Organizations sign in
# to their own Google Drive or OneDrive / SharePoint with them (read-only). Set each pair or neither;
# unset hides that provider's Connect button. Redirect URIs: <web origin>/settings/document-sources/<provider>/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Google's file picker for Google Drive sources (people choose files; Pactlab reads only those): a browser
# API key restricted to the Google Picker API and the web origin, and the Cloud project number. Set both or neither.
GOOGLE_PICKER_API_KEY=
GOOGLE_PROJECT_NUMBER=
# RentCast API key (https://www.rentcast.io/api) for US property facts on teaser pages and market rents for a rent roll
# (T-158, docs/runbooks/rentcast.md). Unset: the synthetic fixture outside production; both off in production.
RENTCAST_API_KEY=
# Billing (T-087): Stripe secret key (sk_test_... for test mode) and webhook signing secret (whsec_...). Leave empty to use the local fixture checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# on | off (default off): whether starting a pact needs a credit or subscription. Off until go-live.
BILLING_ENFORCEMENT=
# true | false (default false): Stripe Tax on Checkout; decided with a CPA.
STRIPE_AUTOMATIC_TAX=

# --- API / worker tuning ---
# Port the API listens on.
API_PORT=
# Concurrent jobs per worker process.
WORKER_CONCURRENCY=

# --- Web (public, exposed to the browser — never secrets) ---
# Environment label for the non-production banner.
NEXT_PUBLIC_APP_ENV=
# Public origin of the API.
NEXT_PUBLIC_API_ORIGIN=

# Allow synthetic GitHub/Jira test connections (true/false). Unset: on for local, test, dev and qa.
ALLOW_FIXTURE_CONNECTIONS=

# Self-hosted Jira servers this deployment may reach, comma-separated host names
# (e.g. issues.apache.org). Atlassian Cloud sites are always allowed; any other
# Jira host is refused unless the operator lists it here. Never set from user input.
JIRA_SELF_HOSTED_HOSTS=

# Offer unreleased packs when starting a pact (Software & SaaS and Multifamily are released). Default:
# on for local, test, dev and qa (preview); off for stage and production. Set true/false to override.
PACK_PREVIEW=
# Site builds for dev and qa: show every pack page (preview). Unset or false: released packs only.
NEXT_PUBLIC_PACK_PREVIEW=

# Published macro forecasts for Foresight: imf (IMF DataMapper, public, no key; the default) or fixture (invented series, offline).
MACRO_FORECAST_SOURCE=
# How often (hours, 1-48, default 6) the API checks it can reach the IMF data Foresight uses; results in
# Admin -> Health, and OPERATOR_EMAIL is emailed when it starts failing or recovers. Only with MACRO_FORECAST_SOURCE=imf.
SOURCE_CHECK_INTERVAL_HOURS=

# --- AWS_* / AI ---
# Document AI provider: none (AI off, the default) or bedrock (Claude on Amazon Bedrock).
AI_PROVIDER=
# Bedrock Region, e.g. us-east-2. Required when AI_PROVIDER=bedrock, DOCUMENT_STORE=s3 or EMAIL_PROVIDER=ses.
AWS_REGION=
# Local only: the AWS profile the SDK uses (sign in first). Deployed tasks use their task role. Never long-lived keys.
AWS_PROFILE=
# Optional per-alias model or inference-profile overrides; defaults are the us. geo profiles
# for Claude Sonnet 5.5 (balanced), Opus 5.5 (deep_review) and Haiku 5.5 (fast).
BEDROCK_MODEL_BALANCED=
BEDROCK_MODEL_DEEP_REVIEW=
BEDROCK_MODEL_FAST=
# Other clouds (T-131): API keys for OpenAI and Google models, used only once an operator records the
# provider's data terms in Admin → AI models and a model passes evaluation. Deployed, they come from Secrets Manager
# (scripts/ai-key.sh). Leave empty to keep the provider off.
# Claude through the direct Anthropic API (T-132). With AI_PROVIDER=anthropic it is the default lane (e.g. while Bedrock
# is unavailable); otherwise an extra lane. Optional model per alias: ANTHROPIC_MODEL_BALANCED, …_DEEP_REVIEW, …_FAST.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_BALANCED=
ANTHROPIC_MODEL_DEEP_REVIEW=
ANTHROPIC_MODEL_FAST=
# Best-of-breed routing (T-132): optional model per job type, provider:modelId (e.g. anthropic:claude-opus-5-5,
# openai:gpt-5.5). The admin console's routes come first; unset keeps the registry's default chain.
MODEL_JOB_DEEP_REVIEW=
MODEL_JOB_CONTRACT_SCRUB=
MODEL_JOB_EXTRACTION=
MODEL_JOB_CLASSIFICATION=
MODEL_JOB_DOCUMENT_QA=
MODEL_JOB_VISION=
# Per-pact AI spend in USD above which jobs take their economy lanes first. Unset: no ceiling.
AI_DEAL_COST_CEILING_USD=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Optional fallback Claude inference profile per alias, tried once when the primary is throttled
# or unavailable, and only for prompts whose evals passed on it. Claude models only.
BEDROCK_FALLBACK_BALANCED=
BEDROCK_FALLBACK_DEEP_REVIEW=
BEDROCK_FALLBACK_FAST=

# Hosting cost (admin console): the read-only Cost Explorer role in the payer account. Live only; unset elsewhere.
COST_EXPLORER_ROLE_ARN=

# --- Marketing site (apps/site; public, baked in at build time) ---
# App origin for the "Sign in" link (the site links to <origin>/login). Unset: no sign-in link.
NEXT_PUBLIC_APP_URL=
# Address for "Request a pilot" (mailto). Unset: no pilot button is shown.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- E2E_* : browser tests (apps/e2e, `pnpm test:e2e`) ---
# They run on their own `pactlab_e2e` database and ports; defaults match infra/local.
# Owner (migration) connection; only the host, port and credentials are used.
# E2E_DATABASE_MIGRATION_URL=
# Runtime (pactlab_api) connection; only the host, port and credentials are used.
# E2E_DATABASE_URL=
# E2E_REDIS_URL=
# Ports for the e2e API and web servers (default 4400 and 3400).
# E2E_API_PORT=
# E2E_WEB_PORT=
