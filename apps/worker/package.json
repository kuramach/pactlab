{
  "name": "@pactlab/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "tsx src/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@pactlab/config": "workspace:*",
    "@pactlab/contracts": "workspace:*",
    "@pactlab/db": "workspace:*",
    "@pactlab/domain": "workspace:*",
    "@pactlab/observability": "workspace:*",
    "bullmq": "6.3.11",
    "ioredis": "6.0.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "pg": "8.23.1",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
