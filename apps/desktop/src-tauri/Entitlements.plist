<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Pactlab Rinse under the hardened runtime (T-178e). Applied once the app is signed with a Developer ID;
  an unsigned build ignores them. The engine sidecar is Node, whose V8 needs JIT memory; the bundled
  LibreOffice and Tesseract load their own libraries, which are not signed by the same team.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
