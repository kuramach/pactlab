{
  "name": "@pactlab/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "tsx src/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "flow:local": "tsx --env-file-if-exists=../../.env src/local-flow.ts",
    "ops:org": "tsx --env-file-if-exists=../../.env src/ops/org-admin.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/demo-seed/cli.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@pactlab/ai": "workspace:*",
    "@pactlab/calculations": "workspace:*",
    "@pactlab/config": "workspace:*",
    "@pactlab/connectors": "workspace:*",
    "@pactlab/contracts": "workspace:*",
    "@pactlab/db": "workspace:*",
    "@pactlab/domain": "workspace:*",
    "@pactlab/observability": "workspace:*",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
